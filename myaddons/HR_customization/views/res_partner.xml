<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherited_hr" model="ir.ui.view">
        <field name="name">res.partner.form_inherited</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='company_type']" position="after">
                <field name="contact_type" widget="radio"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="information_fiscale" string="Coordonées fiscales">
                    <group name="misc" string="Misc" class="col-6">
                        <field name="vat" string='N.I.F' placeholder="e.g: 0016854585" readonly="parent_id"/>
                        <field name="nis" placeholder="e.g: 0 016 236 753"/>
                        <field name="ai"/>
                        <field name="company_registry" string='R.C'/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- Héritage de la vue de recherche des contacts -->
    <record id="view_partner_filter_inherit" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <!-- Ajouter un filtre pour le type de contact -->
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter name="contact_type" string="type de contact" context="{'group_by':'contact_type'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_inherit" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page name="information_fiscale" string="Coordonées fiscales">
                    <group name="misco" string="Misc">
                        <field name="vat" string='N.I.F' placeholder="e.g: 0016854585" readonly="parent_id"/>
                        <field name="nis" placeholder="e.g: 0 016 236 753"/>
                        <field name="ai"/>
                        <field name="company_registry" string='R.C'/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>