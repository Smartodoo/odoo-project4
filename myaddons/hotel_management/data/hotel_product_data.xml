<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégories d'articles de l'auberge (cahier des charges : stocks) -->
        <record id="product_category_hotel" model="product.category">
            <field name="name">Auberge</field>
        </record>
        <record id="product_category_hotel_services" model="product.category">
            <field name="name">Hébergement &amp; services</field>
            <field name="parent_id" ref="product_category_hotel"/>
        </record>
        <record id="product_category_hotel_cleaning" model="product.category">
            <field name="name">Produits d'entretien</field>
            <field name="parent_id" ref="product_category_hotel"/>
        </record>
        <record id="product_category_hotel_linen" model="product.category">
            <field name="name">Linge</field>
            <field name="parent_id" ref="product_category_hotel"/>
        </record>
        <record id="product_category_hotel_supplies" model="product.category">
            <field name="name">Fournitures</field>
            <field name="parent_id" ref="product_category_hotel"/>
        </record>
        <record id="product_category_hotel_consumables" model="product.category">
            <field name="name">Produits consommables</field>
            <field name="parent_id" ref="product_category_hotel"/>
        </record>

        <!-- Produit utilisé pour facturer l'hébergement. Ajoutez-lui la TVA /
             taxe de séjour applicable : elle sera reprise dans les factures. -->
        <record id="product_hotel_night" model="product.product">
            <field name="name">Nuitée</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_hotel_services"/>
            <field name="list_price">0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
        </record>

        <!-- Consommations / services proposés à la réception (exemples, prix modifiables) -->
        <record id="product_hotel_breakfast" model="product.product">
            <field name="name">Petit-déjeuner</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_hotel_services"/>
            <field name="list_price">300</field>
            <field name="hotel_service" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>
        <record id="product_hotel_meal" model="product.product">
            <field name="name">Repas</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_hotel_services"/>
            <field name="list_price">800</field>
            <field name="hotel_service" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>
        <record id="product_hotel_laundry" model="product.product">
            <field name="name">Blanchisserie</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_hotel_services"/>
            <field name="list_price">500</field>
            <field name="hotel_service" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>
        <record id="product_hotel_drink" model="product.product">
            <field name="name">Boisson</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product_category_hotel_consumables"/>
            <field name="list_price">100</field>
            <field name="hotel_service" eval="True"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>
    </data>

    <!-- Alertes quotidiennes : arrivées, départs, paiements en retard, stock minimum -->
    <record id="ir_cron_hotel_alerts" model="ir.cron">
        <field name="name">Auberge : alertes du jour</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_hotel_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
