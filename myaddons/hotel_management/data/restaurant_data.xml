<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégories -->
        <record id="rest_cat_starter" model="hotel.restaurant.category">
            <field name="name">Entrées</field>
            <field name="sequence">1</field>
        </record>
        <record id="rest_cat_main" model="hotel.restaurant.category">
            <field name="name">Plats</field>
            <field name="sequence">2</field>
        </record>
        <record id="rest_cat_dessert" model="hotel.restaurant.category">
            <field name="name">Desserts</field>
            <field name="sequence">3</field>
        </record>
        <record id="rest_cat_drink" model="hotel.restaurant.category">
            <field name="name">Boissons</field>
            <field name="sequence">4</field>
        </record>

        <!-- Articles -->
        <record id="rest_item_salad" model="hotel.restaurant.item">
            <field name="name">Salade composée</field>
            <field name="category_id" ref="rest_cat_starter"/>
            <field name="price">600</field>
        </record>
        <record id="rest_item_soup" model="hotel.restaurant.item">
            <field name="name">Soupe du jour</field>
            <field name="category_id" ref="rest_cat_starter"/>
            <field name="price">450</field>
        </record>
        <record id="rest_item_couscous" model="hotel.restaurant.item">
            <field name="name">Couscous royal</field>
            <field name="category_id" ref="rest_cat_main"/>
            <field name="price">1500</field>
        </record>
        <record id="rest_item_grill" model="hotel.restaurant.item">
            <field name="name">Grillades mixtes</field>
            <field name="category_id" ref="rest_cat_main"/>
            <field name="price">1800</field>
        </record>
        <record id="rest_item_fish" model="hotel.restaurant.item">
            <field name="name">Poisson grillé</field>
            <field name="category_id" ref="rest_cat_main"/>
            <field name="price">2000</field>
        </record>
        <record id="rest_item_cake" model="hotel.restaurant.item">
            <field name="name">Gâteau maison</field>
            <field name="category_id" ref="rest_cat_dessert"/>
            <field name="price">500</field>
        </record>
        <record id="rest_item_fruit" model="hotel.restaurant.item">
            <field name="name">Salade de fruits</field>
            <field name="category_id" ref="rest_cat_dessert"/>
            <field name="price">400</field>
        </record>
        <record id="rest_item_water" model="hotel.restaurant.item">
            <field name="name">Eau minérale</field>
            <field name="category_id" ref="rest_cat_drink"/>
            <field name="price">100</field>
        </record>
        <record id="rest_item_soda" model="hotel.restaurant.item">
            <field name="name">Soda</field>
            <field name="category_id" ref="rest_cat_drink"/>
            <field name="price">200</field>
        </record>
        <record id="rest_item_coffee" model="hotel.restaurant.item">
            <field name="name">Café / Thé</field>
            <field name="category_id" ref="rest_cat_drink"/>
            <field name="price">150</field>
        </record>
    </data>
</odoo>
