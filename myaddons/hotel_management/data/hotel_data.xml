<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Équipements / caractéristiques -->
        <record id="amenity_wifi" model="hotel.amenity">
            <field name="name">Wi-Fi</field>
            <field name="icon">fa-wifi</field>
            <field name="sequence">1</field>
        </record>
        <record id="amenity_ac" model="hotel.amenity">
            <field name="name">Climatisation</field>
            <field name="icon">fa-snowflake-o</field>
            <field name="sequence">2</field>
        </record>
        <record id="amenity_tv" model="hotel.amenity">
            <field name="name">Télévision</field>
            <field name="icon">fa-television</field>
            <field name="sequence">3</field>
        </record>
        <record id="amenity_minibar" model="hotel.amenity">
            <field name="name">Mini-bar</field>
            <field name="icon">fa-glass</field>
            <field name="sequence">4</field>
        </record>
        <record id="amenity_balcony" model="hotel.amenity">
            <field name="name">Balcon</field>
            <field name="icon">fa-building-o</field>
            <field name="sequence">5</field>
        </record>
        <record id="amenity_bathtub" model="hotel.amenity">
            <field name="name">Baignoire</field>
            <field name="icon">fa-bath</field>
            <field name="sequence">6</field>
        </record>
        <record id="amenity_safe" model="hotel.amenity">
            <field name="name">Coffre-fort</field>
            <field name="icon">fa-lock</field>
            <field name="sequence">7</field>
        </record>
        <record id="amenity_breakfast" model="hotel.amenity">
            <field name="name">Petit-déjeuner</field>
            <field name="icon">fa-coffee</field>
            <field name="sequence">8</field>
        </record>

        <!-- Types de chambres (auberge) -->
        <record id="room_type_single" model="hotel.room.type">
            <field name="name">Dortoir mixte</field>
            <field name="code">DORM-M</field>
            <field name="sequence">1</field>
            <field name="rental_mode">bed</field>
            <field name="list_price">2000</field>
            <field name="default_capacity">6</field>
            <field name="description">Dortoir mixte, location au lit.</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac')])]"/>
        </record>
        <record id="room_type_suite" model="hotel.room.type">
            <field name="name">Dortoir femmes</field>
            <field name="code">DORM-F</field>
            <field name="sequence">2</field>
            <field name="rental_mode">bed</field>
            <field name="list_price">2000</field>
            <field name="default_capacity">6</field>
            <field name="description">Dortoir réservé aux femmes, location au lit.</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac')])]"/>
        </record>
        <record id="room_type_double" model="hotel.room.type">
            <field name="name">Chambre privée</field>
            <field name="code">PRIV</field>
            <field name="sequence">3</field>
            <field name="rental_mode">room</field>
            <field name="list_price">6000</field>
            <field name="default_capacity">2</field>
            <field name="description">Chambre privée pour 1 à 2 personnes.</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv')])]"/>
        </record>
        <record id="room_type_family" model="hotel.room.type">
            <field name="name">Chambre familiale</field>
            <field name="code">FAM</field>
            <field name="sequence">4</field>
            <field name="rental_mode">both</field>
            <field name="list_price">10000</field>
            <field name="default_capacity">4</field>
            <field name="description">Chambre familiale, louable entière ou au lit.</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv'), ref('amenity_balcony')])]"/>
        </record>

        <!-- Chambres d'exemple -->
        <record id="room_101" model="hotel.room">
            <field name="name">101</field>
            <field name="room_type_id" ref="room_type_single"/>
            <field name="floor">1</field>
            <field name="capacity">6</field>
            <field name="price">2000</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv')])]"/>
        </record>
        <record id="room_102" model="hotel.room">
            <field name="name">102</field>
            <field name="room_type_id" ref="room_type_single"/>
            <field name="floor">1</field>
            <field name="capacity">6</field>
            <field name="price">2000</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv')])]"/>
        </record>
        <record id="room_103" model="hotel.room">
            <field name="name">103</field>
            <field name="room_type_id" ref="room_type_double"/>
            <field name="floor">1</field>
            <field name="capacity">2</field>
            <field name="price">6000</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv'), ref('amenity_minibar')])]"/>
        </record>
        <record id="room_201" model="hotel.room">
            <field name="name">201</field>
            <field name="room_type_id" ref="room_type_double"/>
            <field name="floor">2</field>
            <field name="capacity">2</field>
            <field name="price">6000</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv'), ref('amenity_minibar')])]"/>
        </record>
        <record id="room_202" model="hotel.room">
            <field name="name">202</field>
            <field name="room_type_id" ref="room_type_family"/>
            <field name="floor">2</field>
            <field name="capacity">4</field>
            <field name="price">10000</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv'), ref('amenity_balcony')])]"/>
        </record>
        <record id="room_301" model="hotel.room">
            <field name="name">301</field>
            <field name="room_type_id" ref="room_type_suite"/>
            <field name="floor">3</field>
            <field name="capacity">6</field>
            <field name="price">2000</field>
            <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_ac'), ref('amenity_tv'), ref('amenity_minibar'), ref('amenity_balcony'), ref('amenity_bathtub'), ref('amenity_safe')])]"/>
        </record>

        <!-- Exemple de tarif saisonnier (haute saison été) -->
        <record id="season_summer_2026" model="hotel.rate.season">
            <field name="name">Haute saison été 2026</field>
            <field name="date_start">2026-06-15</field>
            <field name="date_end">2026-09-15</field>
            <field name="room_type_id" ref="room_type_family"/>
            <field name="price">12000</field>
        </record>
    </data>
</odoo>
