<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="seq_hotel_reservation" model="ir.sequence">
        <field name="name">Réservation Hôtel</field>
        <field name="code">hotel.reservation</field>
        <field name="prefix">RES/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hotel_restaurant_order" model="ir.sequence">
        <field name="name">Commande Restaurant</field>
        <field name="code">hotel.restaurant.order</field>
        <field name="prefix">RESTO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hotel_housekeeping" model="ir.sequence">
        <field name="name">Tâche de ménage</field>
        <field name="code">hotel.housekeeping</field>
        <field name="prefix">MEN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
