<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hotel_management.ListPdfButtons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <button t-if="!this.editedRecord" type="button" class="btn btn-secondary o_hotel_list_pdf"
                    t-on-click="this.onPrintPdfClicked" data-tooltip="Imprimer en PDF">
                <i class="oi me-1" data-icon="print"/>Imprimer PDF
            </button>
        </xpath>
    </t>
</templates>
