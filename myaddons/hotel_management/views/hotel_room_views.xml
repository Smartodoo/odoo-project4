<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="housekeeping_status"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-danger="status == 'occupied'"
                       decoration-warning="status == 'maintenance'"/>
                <field name="current_guest_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_hotel_room_kanban">
                <field name="name"/>
                <field name="status"/>
                <field name="housekeeping_status"/>
                <field name="room_type_id"/>
                <field name="capacity"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="current_guest_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_hotel_room_card">
                            <div class="o_hotel_room_top">
                                <strong class="o_hotel_room_no">
                                    <i class="fa fa-bed me-1"/><field name="name"/>
                                </strong>
                                <span t-attf-class="badge o_hotel_room_badge_#{record.status.raw_value}">
                                    <field name="status"/>
                                </span>
                            </div>
                            <div class="text-muted">
                                <field name="room_type_id"/> · <field name="capacity"/> pers.
                            </div>
                            <div>
                                <field name="price" widget="monetary"/> / nuit
                            </div>
                            <div t-if="record.current_guest_id.raw_value" class="text-danger small">
                                <i class="fa fa-user me-1"/><field name="current_guest_id"/>
                            </div>
                            <div class="small">
                                <i class="fa fa-magic me-1"/><field name="housekeeping_status"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : 101"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="housekeeping_status" widget="badge"/>
                            <field name="maintenance" widget="boolean_toggle"/>
                            <field name="status" readonly="1"/>
                            <field name="current_guest_id" readonly="1"
                                   invisible="status != 'occupied'"/>
                        </group>
                    </group>
                    <group string="Équipements">
                        <field name="amenity_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <filter name="clean" string="Propres" domain="[('housekeeping_status', '=', 'clean')]"/>
                <filter name="dirty" string="À nettoyer" domain="[('housekeeping_status', '=', 'dirty')]"/>
                <filter name="maintenance" string="En maintenance" domain="[('maintenance', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'room_type_id'}"/>
                    <filter name="group_floor" string="Étage" context="{'group_by': 'floor'}"/>
                    <filter name="group_housekeeping" string="État ménage" context="{'group_by': 'housekeeping_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Chambres</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_hotel_room_search"/>
    </record>
</odoo>
