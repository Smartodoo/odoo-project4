<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="current_booking_type" string="Mode (résa en cours)" optional="show"/>
                <field name="bed_count" optional="hide"/>
                <field name="bed_availability" optional="show"/>
                <field name="current_rental_amount" widget="monetary" string="Montant (résa)" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'partial'"
                       decoration-info="status == 'reserved'"
                       decoration-danger="status == 'occupied'"
                       decoration-primary="status == 'cleaning'"
                       decoration-muted="status in ('maintenance', 'out_of_service')"/>
                <field name="current_guest_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_hotel_room_kanban" create="0">
                <field name="name"/>
                <field name="status"/>
                <field name="room_type_id"/>
                <field name="current_booking_type"/>
                <field name="capacity"/>
                <field name="current_rental_amount"/>
                <field name="currency_id"/>
                <field name="current_guest_ids"/>
                <field name="bed_count"/>
                <field name="beds_free_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_hotel_room_card o_hotel_room_card_#{record.status.raw_value}">
                            <div class="o_hotel_room_top">
                                <strong class="o_hotel_room_no">
                                    <i class="fa fa-key me-1" title="Chambre"/><field name="name"/>
                                </strong>
                                <span t-attf-class="badge rounded-pill o_hotel_room_badge_#{record.status.raw_value}">
                                    <field name="status"/>
                                </span>
                            </div>
                            <div class="text-muted small mb-1">
                                <field name="room_type_id"/> · <field name="capacity"/> pers.
                                <t t-if="record.current_booking_type.raw_value">
                                    · <field name="current_booking_type"/>
                                </t>
                            </div>
                            <field name="bed_map"/>
                            <div class="o_hotel_room_meta">
                                <span t-if="record.bed_count.raw_value" class="o_hotel_room_free">
                                    <b><t t-esc="record.beds_free_count.raw_value"/></b>
                                    / <t t-esc="record.bed_count.raw_value"/> lits libres
                                </span>
                                <span t-if="record.current_rental_amount.raw_value" class="o_hotel_room_price">
                                    <field name="current_rental_amount" widget="monetary"/>
                                    <small class="text-muted">/ nuit</small>
                                </span>
                            </div>
                            <div t-if="record.current_guest_ids.raw_value.length" class="small o_hotel_room_guest">
                                <i class="fa fa-user me-1" title="Client"/><field name="current_guest_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_in_service" type="object"
                            string="Remettre en service" class="btn-primary"
                            invisible="status != 'out_of_service'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,reserved,partial,occupied,cleaning,maintenance,out_of_service"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="reservation_count" widget="statinfo"
                                   string="Réservations"/>
                        </button>
                        <button name="action_view_housekeeping" type="object"
                                class="oe_stat_button" icon="fa-magic">
                            <field name="housekeeping_count" widget="statinfo"
                                   string="Ménage"/>
                        </button>
                        <button name="action_view_maintenance" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo"
                                   string="Travaux"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : 101"/></h1>
                    </div>
                    <field name="bed_availability" invisible="1"/>
                    <field name="current_guest_ids" invisible="1"/>
                    <field name="current_reservation_id" invisible="1"/>
                    <field name="bed_count" invisible="1"/>
                    <div class="o_hotel_occupation mb-3" invisible="not bed_count">
                        <div class="o_hotel_occupation_title">Occupation des lits aujourd'hui</div>
                        <field name="bed_map" nolabel="1"/>
                        <div class="o_hotel_bed_legend">
                            <span class="o_hotel_bed_chip o_hotel_bed_chip_free">Libre</span>
                            <span class="o_hotel_bed_chip o_hotel_bed_chip_reserved">Réservé</span>
                            <span class="o_hotel_bed_chip o_hotel_bed_chip_occupied">Occupé</span>
                        </div>
                    </div>
                    <div class="o_hotel_rental" name="rental">
                        <div class="o_hotel_rental_head">
                            <span class="o_hotel_rental_icon"><i class="fa fa-tags" title="Tarifs"/></span>
                            <div>
                                <div class="o_hotel_rental_title">Location &amp; tarifs</div>
                                <div class="o_hotel_rental_sub">
                                    Mode et montant de la réservation en cours (lecture seule).
                                    Le mode se choisit dans la réservation ; les tarifs de base
                                    se règlent dans Configuration &gt; Chambres.
                                </div>
                            </div>
                        </div>
                        <div class="o_hotel_rental_body">
                            <div class="o_hotel_rental_settings">
                                <div class="o_hotel_rental_label">Réservation en cours</div>
                                <field name="current_reservation_id" invisible="1"/>
                                <div invisible="not current_reservation_id">
                                    <field name="current_booking_type" readonly="1"/>
                                    <field name="current_rental_amount" widget="monetary" readonly="1"/>
                                </div>
                                <div class="text-muted" invisible="current_reservation_id">
                                    Aucune réservation en cours sur cette chambre.
                                </div>
                            </div>

                            <div class="o_hotel_rental_summary">
                                <div class="o_hotel_price_card o_hotel_price_card_room">
                                    <div class="o_hotel_price_card_label">
                                        <i class="fa fa-home me-1" title="Chambre"/>Chambre entière
                                    </div>
                                    <div class="o_hotel_price_card_value">
                                        <field name="whole_room_price" widget="monetary" readonly="1"/>
                                    </div>
                                    <div class="o_hotel_price_card_hint">par nuit</div>
                                </div>
                                <div class="o_hotel_price_card o_hotel_price_card_bed"
                                     invisible="not bed_count">
                                    <div class="o_hotel_price_card_label">
                                        <i class="fa fa-bed me-1" title="Lit"/>Au lit
                                    </div>
                                    <div class="o_hotel_price_card_value">
                                        <small>dès</small>
                                        <field name="bed_price_min" widget="monetary" readonly="1"/>
                                    </div>
                                    <div class="o_hotel_price_card_hint">par lit et par nuit</div>
                                </div>
                                <field name="bed_count" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="Lits" name="beds" invisible="1">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted">
                                    Lits : <field name="bed_summary" class="oe_inline"/>
                                </span>
                                <button name="action_manage_beds" type="object"
                                        string="Gérer les lits" icon="fa-bed"
                                        class="btn-secondary"
                                        groups="hotel_management.group_hotel_manager"/>
                            </div>
                            <div class="text-muted small mb-2">
                                L'état des lits (libre / réservé / occupé) suit les réservations
                                et les boutons Entrer / Sortir.
                            </div>
                            <field name="bed_ids" readonly="1">
                                <tree create="0" delete="0">
                                    <field name="name" string="Référence"/>
                                    <field name="price" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'free'"
                                           decoration-info="status == 'reserved'"
                                           decoration-danger="status == 'occupied'"
                                           decoration-muted="status in ('maintenance', 'out_of_service')"/>
                                    <field name="current_guest_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Équipements" name="amenities">
                            <field name="amenity_ids" widget="many2many_tags" readonly="1"
                                   placeholder="Ajouter des équipements (Wifi, Climatisation, TV…)"/>
                        </page>
                        <page string="Informations" name="informations">
                            <group>
                                <group>
                                    <field name="room_type_id" readonly="1"/>
                                    <field name="floor" readonly="1"/>
                                    <field name="capacity" readonly="1"/>
                                </group>
                                <group>
                                    <field name="room_price" widget="monetary" invisible="1"/>
                                    <field name="bed_price" widget="monetary" invisible="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" readonly="1"
                                   placeholder="Description de la chambre (affichée sur le site web)…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <filter name="mode_room" string="Chambres entières" domain="[('rental_mode', '=', 'room')]"/>
                <filter name="mode_bed" string="Dortoirs (au lit)" domain="[('rental_mode', '=', 'bed')]"/>
                <separator/>
                <filter name="clean" string="Propres" domain="[('housekeeping_status', '=', 'clean')]"/>
                <filter name="dirty" string="À nettoyer" domain="[('housekeeping_status', '=', 'dirty')]"/>
                <filter name="maintenance" string="En maintenance" domain="[('technical_state', '=', 'maintenance')]"/>
                <filter name="out_of_service" string="Hors service" domain="[('technical_state', '=', 'out_of_service')]"/>
                <separator/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'room_type_id'}"/>
                    <filter name="group_mode" string="Mode (défaut)" context="{'group_by': 'rental_mode'}"/>
                    <filter name="group_floor" string="Étage" context="{'group_by': 'floor'}"/>
                    <filter name="group_technical" string="État technique" context="{'group_by': 'technical_state'}"/>
                    <filter name="group_housekeeping" string="État ménage" context="{'group_by': 'housekeeping_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Menu du haut « Chambres » = tableau d'occupation (lecture + déclaration
         des lits, pas de création : celle-ci se fait dans Configuration). -->
    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Chambres</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_hotel_room_search"/>
    </record>

    <!-- ===== Configuration > Chambres : création des chambres et des lits ===== -->
    <record id="view_hotel_room_config_tree" model="ir.ui.view">
        <field name="name">hotel.room.config.tree</field>
        <field name="model">hotel.room</field>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <tree string="Chambres">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="rental_mode"/>
                <field name="bed_summary" string="Lits créés"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_room_config_form" model="ir.ui.view">
        <field name="name">hotel.room.config.form</field>
        <field name="model">hotel.room</field>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <form string="Chambre">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : 101"/></h1>
                    </div>
                    <notebook>
                        <page string="Lits" name="beds">
                            <field name="bed_ids" context="{'default_room_id': id}">
                                <tree editable="bottom">
                                    <field name="name" string="Référence"/>
                                    <field name="active" string="Actif"
                                           widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Équipements" name="amenities">
                            <field name="amenity_ids" widget="many2many_tags"
                                   placeholder="Ajouter des équipements (Wifi, Climatisation, TV…)"/>
                        </page>
                        <page string="Informations" name="informations">
                            <group>
                                <group>
                                    <field name="room_type_id"/>
                                    <field name="floor"/>
                                    <field name="capacity"/>
                                </group>
                                <group>
                                    <field name="room_price" widget="monetary"/>
                                    <field name="bed_price" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="Description de la chambre (affichée sur le site web)…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_hotel_room_config" model="ir.actions.act_window">
        <field name="name">Chambres</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hotel_room_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hotel_room_config_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hotel_room_config_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première chambre</p>
            <p>Indiquez le numéro, le type et la capacité, puis ajoutez les lits
               dans l'onglet « Lits ».</p>
        </field>
    </record>
</odoo>
