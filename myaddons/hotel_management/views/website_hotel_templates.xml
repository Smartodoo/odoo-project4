<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================= LISTE / RECHERCHE ================= -->
    <template id="rooms_page" name="Hôtel - Chambres">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <section class="o_hotel_hero">
                    <div class="container">
                        <h1>Réservez votre séjour</h1>
                        <p class="lead">Découvrez nos chambres et réservez en quelques clics.</p>
                        <form class="o_hotel_search" method="get" action="/hotel/rooms">
                            <div class="o_hotel_search_field">
                                <label>Arrivée</label>
                                <input type="date" name="checkin" t-att-value="checkin"
                                       t-att-min="today" required="required"/>
                            </div>
                            <div class="o_hotel_search_field">
                                <label>Départ</label>
                                <input type="date" name="checkout" t-att-value="checkout"
                                       t-att-min="today" required="required"/>
                            </div>
                            <div class="o_hotel_search_field">
                                <label>Personnes</label>
                                <input type="number" name="guests" min="1" t-att-value="guests"/>
                            </div>
                            <div class="o_hotel_search_field">
                                <label>Type de location</label>
                                <select name="booking_type" required="required">
                                    <option value="" disabled="disabled" t-att-selected="not booking_type">Choisir…</option>
                                    <option value="room" t-att-selected="booking_type == 'room'">Chambre entière</option>
                                    <option value="bed" t-att-selected="booking_type == 'bed'">Lit en dortoir</option>
                                </select>
                            </div>
                            <div class="o_hotel_search_field o_hotel_search_btn">
                                <button type="submit" class="btn btn-primary">
                                    <i class="oi me-1" data-icon="search"/>Rechercher
                                </button>
                            </div>
                        </form>
                    </div>
                </section>

                <div class="container my-4">
                    <!-- Choix bien visible : chambre entière ou lit en dortoir -->
                    <t t-set="type_qs" t-value="'checkin=%s&amp;checkout=%s&amp;guests=%s' % (checkin or '', checkout or '', guests)"/>
                    <div class="o_hotel_type_tabs nav nav-pills mb-3">
                        <a t-attf-href="/hotel/rooms?#{type_qs}&amp;booking_type=room"
                           t-attf-class="nav-link #{'active' if booking_type == 'room' else ''}">
                            <i class="oi me-1" data-icon="home"/>Chambre entière
                        </a>
                        <a t-attf-href="/hotel/rooms?#{type_qs}&amp;booking_type=bed"
                           t-attf-class="nav-link #{'active' if booking_type == 'bed' else ''}">
                            <i class="oi me-1" data-icon="bed"/>Lit en dortoir
                        </a>
                    </div>
                    <t t-if="error">
                        <div class="alert alert-warning" t-out="error"/>
                    </t>

                    <t t-if="dates_selected">
                        <h2 class="mb-3">Chambres disponibles
                            <small class="text-muted">du <t t-out="checkin"/> au <t t-out="checkout"/></small>
                        </h2>
                        <div t-if="available_rooms" class="alert alert-info o_hotel_partial_hint">
                            <t t-if="booking_type == 'bed'">
                                <i class="oi me-1" data-icon="bed"/>
                                Pour <t t-out="guests"/> voyageur(s) : d'abord les chambres partagées ayant juste
                                le nombre de lits libres qu'il vous faut, puis celles qui en ont davantage,
                                puis les chambres entièrement libres.
                            </t>
                            <t t-else="">
                                <i class="oi me-1" data-icon="home"/>
                                Pour <t t-out="guests"/> voyageur(s) : d'abord les chambres de votre taille,
                                puis les chambres plus grandes.
                            </t>
                        </div>
                        <t t-if="available_rooms">
                            <div class="row">
                                <t t-foreach="available_rooms" t-as="room">
                                    <t t-call="hotel_management.room_card"/>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-info">
                                Aucune chambre disponible pour ces dates. Essayez d'autres dates.
                            </div>
                        </t>

                        <!-- Seules les chambres libres sur toute la période sont
                             proposées : celles déjà réservées ne sont pas affichées. -->
                        <p t-if="occupied_rooms and available_rooms" class="text-muted small mt-2">
                            <i class="oi me-1" data-icon="info"/>
                            Seules les chambres libres sur toute la période sont affichées.
                        </p>
                    </t>
                    <t t-else="">
                        <h2 class="mb-3">Nos chambres</h2>
                        <div class="row">
                            <t t-foreach="rooms" t-as="room">
                                <t t-call="hotel_management.room_card"/>
                            </t>
                        </div>
                        <t t-if="not rooms">
                            <div class="alert alert-info">Aucune chambre publiée pour le moment.</div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ================= CARTE CHAMBRE (réutilisable) ================= -->
    <template id="room_card" name="Carte chambre">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="o_hotel_room_web_card">
                <a t-attf-href="/hotel/room/#{room.id}?checkin=#{checkin}&amp;checkout=#{checkout}&amp;guests=#{guests}&amp;booking_type=#{booking_type or ''}"
                   class="o_hotel_room_img">
                    <t t-if="room.image">
                        <img t-attf-src="/web/image/hotel.room/#{room.id}/image"
                             t-att-alt="room.name"/>
                    </t>
                    <t t-else="">
                        <div class="o_hotel_room_noimg"><i class="oi" data-icon="bed"/></div>
                    </t>
                </a>
                <div class="o_hotel_room_web_body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h4 class="mb-0">Chambre <t t-out="room.name"/></h4>
                        <span class="o_hotel_price">
                            <t t-if="room.rental_mode == 'bed'">
                                <small>dès</small>
                                <span t-field="room.bed_price_min"
                                      t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                <small>/ lit</small>
                            </t>
                            <t t-else="">
                                <span t-field="room.whole_room_price"
                                      t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                <small>/ nuit</small>
                            </t>
                        </span>
                    </div>
                    <div class="text-muted mb-2">
                        <t t-out="room.room_type_id.name"/> ·
                        <i class="oi oi-filled me-1" data-icon="person"/><t t-out="room.capacity"/> pers.
                        <t t-if="room.bed_count"> ·
                            <i class="oi me-1" data-icon="bed"/><t t-out="room.bed_count"/> lit(s)
                        </t>
                    </div>
                    <t t-set="offer" t-value="offers and offers.get(room.id)"/>
                    <div class="o_hotel_offer mb-2">
                        <t t-if="offer">
                            <span t-if="offer['whole'] and booking_type != 'bed'" class="o_hotel_offer_tag o_hotel_offer_ok">
                                <i class="oi me-1" data-icon="check"/>Chambre entière
                            </span>
                            <span t-if="booking_type == 'bed' and offer.get('free_count') == guests or booking_type == 'room' and offer['whole'] and room.capacity == guests"
                                  class="o_hotel_offer_tag o_hotel_offer_ok">
                                <i class="oi me-1" data-icon="verified"/>Idéal pour <t t-out="guests"/> voyageur(s)
                            </span>
                            <span t-if="offer.get('partial')" class="o_hotel_offer_tag o_hotel_offer_beds">
                                <i class="oi me-1" data-icon="group"/>Chambre partagée
                            </span>
                            <span t-if="offer['beds'] and booking_type != 'room'" class="o_hotel_offer_tag o_hotel_offer_beds">
                                <i class="oi me-1" data-icon="bed"/><t t-out="len(offer['beds'])"/> lit(s) libre(s)
                                dès <span t-out="offer['bed_price_min']"
                                          t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                            </span>
                            <span t-if="not offer['bookable']" class="o_hotel_offer_tag o_hotel_offer_full">
                                <i class="oi me-1" data-icon="close"/>Complet
                            </span>
                        </t>
                        <t t-else="">
                            <span t-if="room.rental_mode != 'bed'" class="o_hotel_offer_tag o_hotel_offer_ok">Chambre entière</span>
                            <span t-if="room.rental_mode != 'room' and room.bed_count" class="o_hotel_offer_tag o_hotel_offer_beds">
                                Au lit dès <span t-field="room.bed_price_min"
                                                 t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                            </span>
                        </t>
                    </div>
                    <div class="o_hotel_amenities mb-2">
                        <t t-foreach="room.amenity_ids" t-as="am">
                            <span class="o_hotel_amenity" t-att-title="am.name">
                                <i t-attf-class="oi #{am.icon or ''} me-1" t-attf-data-icon="#{am.icon or 'check'}"/><t t-out="am.name"/>
                            </span>
                        </t>
                    </div>
                    <a t-attf-href="/hotel/room/#{room.id}?checkin=#{checkin}&amp;checkout=#{checkout}&amp;guests=#{guests}&amp;booking_type=#{booking_type or ''}"
                       class="btn btn-primary btn-sm w-100">
                        Voir &amp; réserver
                    </a>
                </div>
            </div>
        </div>
    </template>

    <!-- ================= DÉTAIL + RÉSERVATION ================= -->
    <template id="room_detail_page" name="Hôtel - Détail chambre">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <div class="container my-4">
                    <a href="/hotel/rooms" class="btn btn-link px-0 mb-2">
                        <i class="oi me-1" data-icon="chevron_left"/>Retour aux chambres
                    </a>
                    <div class="row">
                        <div class="col-lg-7">
                            <div class="o_hotel_detail_img mb-3">
                                <t t-if="room.image">
                                    <img t-attf-src="/web/image/hotel.room/#{room.id}/image"
                                         t-att-alt="room.name" class="img-fluid rounded"/>
                                </t>
                                <t t-else="">
                                    <div class="o_hotel_room_noimg o_hotel_room_noimg_lg"><i class="oi" data-icon="bed"/></div>
                                </t>
                            </div>
                            <h1>Chambre <t t-out="room.name"/></h1>
                            <p class="text-muted">
                                <t t-out="room.room_type_id.name"/> ·
                                <i class="oi oi-filled me-1" data-icon="person"/><t t-out="room.capacity"/> personnes ·
                                Étage <t t-out="room.floor or '—'"/>
                            </p>
                            <p t-if="room.description" t-out="room.description"/>
                            <h4 class="mt-3">Équipements</h4>
                            <div class="o_hotel_amenities">
                                <t t-foreach="room.amenity_ids" t-as="am">
                                    <span class="o_hotel_amenity">
                                        <i t-attf-class="oi #{am.icon or ''} me-1" t-attf-data-icon="#{am.icon or 'check'}"/><t t-out="am.name"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="o_hotel_booking_box" id="o_hotel_booking">
                                <div class="o_hotel_booking_price mb-2">
                                    <t t-if="room.rental_mode == 'bed'">
                                        <small class="text-muted">dès</small>
                                        <span t-field="room.bed_price_min"
                                              t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                        <small class="text-muted">/ lit / nuit</small>
                                    </t>
                                    <t t-else="">
                                        <span t-out="whole_price"
                                              t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                        <small class="text-muted">/ nuit (chambre entière)</small>
                                    </t>
                                </div>
                                <!-- Réservable sur la période ? Sinon : pas de réservation
                                     possible ici, on renvoie vers les chambres libres. -->
                                <t t-set="book_blocked" t-value="available == False or (booking_type == 'room' and whole_available == False)"/>
                                <t t-if="book_blocked">
                                    <div class="alert alert-warning py-2">
                                        <i class="oi oi-filled me-1" data-icon="cancel"/>
                                        <t t-if="booking_type == 'room' and available">Cette chambre n'est pas libre en entier</t>
                                        <t t-else="">Cette chambre n'est pas libre</t>
                                        pour les dates sélectionnées.
                                        <a class="alert-link d-block mt-1"
                                           t-attf-href="/hotel/rooms?checkin=#{checkin}&amp;checkout=#{checkout}&amp;guests=#{guests}&amp;booking_type=#{booking_type or ('bed' if room.rental_mode == 'bed' else 'room')}">
                                            Voir les chambres libres sur ces dates
                                        </a>
                                    </div>
                                </t>
                                <t t-elif="available and whole_available == False and room.rental_mode == 'both'">
                                    <div class="alert alert-info py-2">
                                        <i class="oi oi-filled me-1" data-icon="info"/>
                                        Des lits sont déjà loués : la chambre entière n'est plus disponible,
                                        mais il reste <b><t t-out="free_bed_count"/> lit(s)</b> à réserver.
                                    </div>
                                </t>
                                <t t-if="errors">
                                    <div class="alert alert-danger">
                                        <ul class="mb-0">
                                            <li t-foreach="errors" t-as="err" t-out="err"/>
                                        </ul>
                                    </div>
                                </t>
                                <form method="post" action="/hotel/booking/submit" class="o_hotel_booking_form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="room_id" t-att-value="room.id"/>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label">Arrivée</label>
                                            <input type="date" class="form-control" name="checkin"
                                                   t-att-value="checkin" t-att-min="today" required="required"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Départ</label>
                                            <input type="date" class="form-control" name="checkout"
                                                   t-att-value="checkout" t-att-min="today" required="required"/>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Personnes</label>
                                        <input type="number" class="form-control" name="guests"
                                               min="1" t-att-max="room.capacity" t-att-value="guests"/>
                                    </div>
                                    <!-- Le type choisi dans la recherche (par chambre / par lit)
                                         limite le formulaire à cette seule option. -->
                                    <t t-set="show_room" t-value="room.rental_mode != 'bed' and booking_type != 'bed'"/>
                                    <t t-set="show_beds" t-value="room.rental_mode != 'room' and beds_info and booking_type != 'room'"/>
                                    <t t-set="room_ok" t-value="show_room and whole_available != False"/>
                                    <t t-if="show_room and show_beds">
                                        <hr/>
                                        <label class="form-label fw-bold">Que souhaitez-vous réserver ?</label>
                                        <div class="o_hotel_choice">
                                            <input class="btn-check" type="radio" name="booking_type"
                                                   value="room" id="bt_room"
                                                   t-att-checked="'checked' if room_ok else None"
                                                   t-att-disabled="None if room_ok else 'disabled'"/>
                                            <label class="o_hotel_choice_card" for="bt_room">
                                                <i class="oi" data-icon="home"/>
                                                <span class="o_hotel_choice_title">Toute la chambre</span>
                                                <span class="o_hotel_choice_price">
                                                    <span t-out="whole_price"
                                                          t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                                    / nuit
                                                </span>
                                                <small t-if="not room_ok" class="text-danger">Indisponible</small>
                                            </label>
                                            <input class="btn-check" type="radio" name="booking_type"
                                                   value="bed" id="bt_bed"
                                                   t-att-checked="None if room_ok else 'checked'"/>
                                            <label class="o_hotel_choice_card" for="bt_bed">
                                                <i class="oi" data-icon="bed"/>
                                                <span class="o_hotel_choice_title">Un ou plusieurs lits</span>
                                                <span class="o_hotel_choice_price">
                                                    dès <span t-field="room.bed_price_min"
                                                              t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                                    / lit
                                                </span>
                                            </label>
                                        </div>
                                    </t>
                                    <t t-elif="show_room">
                                        <input type="hidden" name="booking_type" value="room"/>
                                    </t>
                                    <t t-elif="show_beds">
                                        <input type="hidden" name="booking_type" value="bed"/>
                                        <hr/>
                                        <label class="form-label fw-bold">Choisissez vos lits</label>
                                    </t>
                                    <div t-if="beds_need_dates" class="alert alert-info py-2 mt-3 mb-0">
                                        <i class="oi oi-filled me-1" data-icon="info"/>
                                        Choisissez vos dates d'arrivée et de départ : les lits libres
                                        sur toute la période s'afficheront.
                                    </div>
                                    <div t-if="show_beds" class="small text-muted mt-2">
                                        Seuls les lits libres du <t t-out="period_start"/>
                                        au <t t-out="period_end"/> sont proposés.
                                    </div>
                                    <div t-if="show_beds" class="o_hotel_bed_pick mt-2">
                                        <t t-foreach="beds_info" t-as="bi">
                                            <input class="btn-check" type="checkbox" name="bed_ids"
                                                   t-att-value="bi['bed'].id"
                                                   t-att-id="'bed_%s' % bi['bed'].id"/>
                                            <label class="o_hotel_bed_option"
                                                   t-att-for="'bed_%s' % bi['bed'].id">
                                                <i class="oi" data-icon="bed"/>
                                                <span class="fw-bold" t-out="bi['bed'].name"/>
                                                <span t-field="bi['bed'].price"
                                                      t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                            </label>
                                        </t>
                                    </div>
                                    <hr/>
                                    <div class="row g-2 mt-0">
                                        <div class="col-6">
                                            <label class="form-label">Nom</label>
                                            <input type="text" class="form-control" name="last_name"
                                                   t-att-value="last_name" required="required"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Prénom</label>
                                            <input type="text" class="form-control" name="first_name"
                                                   t-att-value="first_name" required="required"/>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Date de naissance</label>
                                        <input type="date" class="form-control" name="birthdate"
                                               t-att-value="birthdate" t-att-max="birthdate_max"
                                               required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">E-mail</label>
                                        <input type="email" class="form-control" name="email"
                                               t-att-value="email" required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Téléphone</label>
                                        <input type="text" class="form-control" name="phone"
                                               t-att-value="phone" required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Adresse</label>
                                        <input type="text" class="form-control" name="street"
                                               t-att-value="street" required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Ville</label>
                                        <input type="text" class="form-control" name="city"
                                               t-att-value="city"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Demandes particulières</label>
                                        <textarea class="form-control" name="note" rows="2"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 mt-3"
                                            t-att-disabled="'disabled' if book_blocked else None">
                                        <i class="oi me-1" data-icon="check"/>Confirmer la réservation
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================= CONFIRMATION ================= -->
    <template id="booking_confirmation_page" name="Hôtel - Confirmation">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <div class="container my-5">
                    <div class="o_hotel_confirm text-center">
                        <div class="o_hotel_confirm_icon"><i class="oi oi-filled" data-icon="check_circle"/></div>
                        <h1>Demande de réservation enregistrée !</h1>
                        <p class="lead">
                            Merci <t t-out="reservation.partner_id.name"/>,
                            votre demande <strong t-out="reservation.name"/> a bien été prise en compte.
                            Elle est <strong>en attente de confirmation</strong> par notre équipe.
                        </p>
                        <div class="o_hotel_confirm_card mx-auto">
                            <table class="table mb-0">
                                <tr><th>Référence</th><td t-out="reservation.name"/></tr>
                                <tr><th>Chambre(s)</th>
                                    <td t-out="', '.join(reservation.line_ids.mapped('room_id.name')) or '—'"/></tr>
                                <tr t-if="reservation.line_ids.mapped('bed_ids')"><th>Lit(s)</th>
                                    <td t-out="', '.join(reservation.line_ids.mapped('bed_ids.name'))"/></tr>
                                <tr><th>Arrivée</th><td t-out="reservation.checkin"/></tr>
                                <tr><th>Départ</th><td t-out="reservation.checkout"/></tr>
                                <tr><th>Nuits</th><td t-out="reservation.nights"/></tr>
                                <tr><th>Total</th>
                                    <td><span t-field="reservation.amount_total"
                                        t-options='{"widget": "monetary", "display_currency": reservation.currency_id}'/></td></tr>
                            </table>
                        </div>
                        <div class="o_hotel_confirm_card mx-auto mt-3 text-start"
                             t-if="reservation.company_id.hotel_deposit_instructions and reservation.deposit_requested">
                            <h5>Acompte pour garantir votre réservation</h5>
                            <p class="mb-1">Montant demandé :
                                <strong t-field="reservation.deposit_requested"
                                        t-options='{"widget": "monetary", "display_currency": reservation.currency_id}'/></p>
                            <p class="mb-0" style="white-space: pre-line;" t-out="reservation.company_id.hotel_deposit_instructions"/>
                            <p class="text-muted small mb-0">Indiquez la référence <strong t-out="reservation.name"/> lors du virement.</p>
                        </div>
                        <p class="text-muted mt-3">
                            Notre équipe vous contactera pour finaliser votre séjour.
                        </p>
                        <a href="/hotel/rooms" class="btn btn-primary">Retour aux chambres</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
