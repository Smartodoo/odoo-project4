<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================= LISTE / RECHERCHE ================= -->
    <template id="rooms_page" name="Hôtel - Chambres">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <section class="o_hotel_hero">
                    <div class="container">
                        <h1>Réservez votre séjour</h1>
                        <p class="lead">Découvrez nos chambres et réservez en quelques clics.</p>
                        <form class="o_hotel_search" method="get" action="/hotel/rooms">
                            <div class="o_hotel_search_field">
                                <label>Arrivée</label>
                                <input type="date" name="checkin" t-att-value="checkin"
                                       t-att-min="today" required="required"/>
                            </div>
                            <div class="o_hotel_search_field">
                                <label>Départ</label>
                                <input type="date" name="checkout" t-att-value="checkout"
                                       t-att-min="today" required="required"/>
                            </div>
                            <div class="o_hotel_search_field">
                                <label>Personnes</label>
                                <input type="number" name="guests" min="1" t-att-value="guests"/>
                            </div>
                            <div class="o_hotel_search_field">
                                <label>Type de location</label>
                                <select name="booking_type" required="required">
                                    <option value="" disabled="disabled" t-att-selected="not booking_type">Choisir…</option>
                                    <option value="room" t-att-selected="booking_type == 'room'">Chambre entière</option>
                                    <option value="bed" t-att-selected="booking_type == 'bed'">Lit en dortoir</option>
                                </select>
                            </div>
                            <div t-if="booking_type == 'bed' and guests &gt; 1"
                                 class="o_hotel_search_field o_hotel_separate">
                                <label class="d-flex align-items-center gap-2 mb-0">
                                    <input type="checkbox" name="separate" value="1"
                                           t-att-checked="'checked' if separate else None"/>
                                    J'accepte d'être réparti dans des chambres différentes
                                </label>
                            </div>
                            <div class="o_hotel_search_field o_hotel_search_btn">
                                <button type="submit" class="btn btn-primary">
                                    <i class="oi me-1" data-icon="search"/>Rechercher
                                </button>
                            </div>
                        </form>
                    </div>
                </section>

                <div class="container my-4">
                    <!-- Choix bien visible : chambre entière ou lit en dortoir -->
                    <t t-set="type_qs" t-value="'checkin=%s&amp;checkout=%s&amp;guests=%s' % (checkin or '', checkout or '', guests)"/>
                    <div class="o_hotel_type_tabs nav nav-pills mb-3">
                        <a t-attf-href="/hotel/rooms?#{type_qs}&amp;booking_type=room"
                           t-attf-class="nav-link #{'active' if booking_type == 'room' else ''}">
                            <i class="oi me-1" data-icon="home"/>Chambre entière
                        </a>
                        <a t-attf-href="/hotel/rooms?#{type_qs}&amp;booking_type=bed"
                           t-attf-class="nav-link #{'active' if booking_type == 'bed' else ''}">
                            <i class="oi me-1" data-icon="bed"/>Lit en dortoir
                        </a>
                    </div>
                    <t t-if="error">
                        <div class="alert alert-warning" t-out="error"/>
                    </t>

                    <t t-if="dates_selected">
                        <h2 class="mb-3">Nos formules disponibles
                            <small class="text-muted">du <t t-out="checkin"/> au <t t-out="checkout"/>
                                · <t t-out="guests"/> pers. · <t t-out="nights"/> nuit(s)</small>
                        </h2>
                        <div t-if="booking_type == 'bed' and guests &gt; 1 and not separate"
                             class="alert alert-info py-2">
                            <i class="oi me-1" data-icon="group"/>
                            Vous serez logés ensemble dans une même chambre. Plus de choix ?
                            <a class="alert-link"
                               t-attf-href="/hotel/rooms?#{type_qs}&amp;booking_type=bed&amp;separate=1">
                                Acceptez d'être répartis dans des chambres différentes</a>.
                        </div>
                        <div class="row" t-if="cards">
                            <t t-foreach="cards" t-as="card">
                                <t t-set="rtype" t-value="card['type']"/>
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div t-attf-class="o_hotel_room_web_card #{'' if card['available'] else 'opacity-50'}">
                                        <div class="o_hotel_room_img">
                                            <t t-if="rtype.image">
                                                <img t-attf-src="/web/image/hotel.room.type/#{rtype.id}/image"
                                                     t-att-alt="rtype.name"/>
                                            </t>
                                            <t t-else="">
                                                <div class="o_hotel_room_noimg"><i class="oi" t-att-data-icon="'bed' if booking_type == 'bed' else 'home'"/></div>
                                            </t>
                                        </div>
                                        <div class="o_hotel_room_web_body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <h4 class="mb-0" t-out="rtype.name"/>
                                                <span class="o_hotel_price text-end">
                                                    <span t-out="card['total']"
                                                          t-options='{"widget": "monetary", "display_currency": currency}'/>
                                                    <small class="d-block">au total</small>
                                                </span>
                                            </div>
                                            <div class="text-muted mb-2">
                                                <span t-out="card['unit']"
                                                      t-options='{"widget": "monetary", "display_currency": currency}'/>
                                                / nuit<t t-if="booking_type == 'bed'"> (<t t-out="guests"/> lit(s))</t>
                                                <t t-if="rtype.capacity"> ·
                                                    <i class="oi oi-filled me-1" data-icon="person"/><t t-out="rtype.capacity"/> pers.
                                                </t>
                                            </div>
                                            <p t-if="rtype.description" class="small" t-out="rtype.description"/>
                                            <div class="o_hotel_amenities mb-2">
                                                <t t-foreach="rtype.amenity_ids" t-as="am">
                                                    <span class="o_hotel_amenity" t-att-title="am.name">
                                                        <i t-attf-class="oi #{am.icon or ''} me-1" t-attf-data-icon="#{am.icon or 'check'}"/><t t-out="am.name"/>
                                                    </span>
                                                </t>
                                            </div>
                                            <t t-if="card['available']">
                                                <a t-attf-href="/hotel/book?type_id=#{rtype.id}&amp;#{type_qs}&amp;booking_type=#{booking_type}#{'&amp;separate=1' if separate else ''}"
                                                   class="btn btn-primary btn-sm w-100">
                                                    Choisir
                                                </a>
                                            </t>
                                            <t t-else="">
                                                <span class="o_hotel_offer_tag o_hotel_offer_full">
                                                    <i class="oi me-1" data-icon="close"/>Complet pour ces dates
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div t-if="not any(c['available'] for c in cards)" class="alert alert-info">
                            Aucune disponibilité pour ces dates. Essayez d'autres dates
                            <t t-if="booking_type == 'bed' and guests &gt; 1 and not separate">
                                ou acceptez d'être répartis dans des chambres différentes</t>.
                        </div>
                    </t>
                    <t t-else="">
                        <h2 class="mb-3">Nos chambres</h2>
                        <div class="row">
                            <t t-foreach="rooms" t-as="room">
                                <t t-call="hotel_management.room_card"/>
                            </t>
                        </div>
                        <t t-if="not rooms">
                            <div class="alert alert-info">Aucune chambre publiée pour le moment.</div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ================= CARTE CHAMBRE (réutilisable) ================= -->
    <template id="room_card" name="Carte chambre">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="o_hotel_room_web_card">
                <a t-attf-href="/hotel/room/#{room.id}?checkin=#{checkin}&amp;checkout=#{checkout}&amp;guests=#{guests}&amp;booking_type=#{booking_type or ''}"
                   class="o_hotel_room_img">
                    <t t-if="room.image">
                        <img t-attf-src="/web/image/hotel.room/#{room.id}/image"
                             t-att-alt="room.name"/>
                    </t>
                    <t t-else="">
                        <div class="o_hotel_room_noimg"><i class="oi" data-icon="bed"/></div>
                    </t>
                </a>
                <div class="o_hotel_room_web_body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h4 class="mb-0">Chambre <t t-out="room.name"/></h4>
                        <span class="o_hotel_price">
                            <t t-if="booking_type == 'bed' or not room.whole_room_price">
                                <small>dès</small>
                                <span t-field="room.bed_price_min"
                                      t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                <small>/ lit</small>
                            </t>
                            <t t-else="">
                                <small>dès</small>
                                <span t-field="room.whole_room_price"
                                      t-options='{"widget": "monetary", "display_currency": room.currency_id}'/>
                                <small>/ nuit</small>
                            </t>
                        </span>
                    </div>
                    <div class="text-muted mb-2">
                        <i class="oi oi-filled me-1" data-icon="person"/><t t-out="room.capacity"/> pers.
                        <t t-if="room.bed_count"> ·
                            <i class="oi me-1" data-icon="bed"/><t t-out="room.bed_count"/> lit(s)
                        </t>
                    </div>
                    <div class="o_hotel_amenities mb-2">
                        <t t-foreach="room.amenity_ids" t-as="am">
                            <span class="o_hotel_amenity" t-att-title="am.name">
                                <i t-attf-class="oi #{am.icon or ''} me-1" t-attf-data-icon="#{am.icon or 'check'}"/><t t-out="am.name"/>
                            </span>
                        </t>
                    </div>
                    <a t-attf-href="/hotel/room/#{room.id}?checkin=#{checkin}&amp;checkout=#{checkout}&amp;guests=#{guests}&amp;booking_type=#{booking_type or ''}"
                       class="btn btn-primary btn-sm w-100">
                        Voir la chambre
                    </a>
                </div>
            </div>
        </div>
    </template>

    <!-- ================= DÉTAIL + RÉSERVATION ================= -->
    <template id="room_detail_page" name="Hôtel - Détail chambre">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <div class="container my-4">
                    <a href="/hotel/rooms" class="btn btn-link px-0 mb-2">
                        <i class="oi me-1" data-icon="chevron_left"/>Retour aux chambres
                    </a>
                    <div class="row">
                        <div class="col-lg-7">
                            <div class="o_hotel_detail_img mb-3">
                                <t t-if="room.image">
                                    <img t-attf-src="/web/image/hotel.room/#{room.id}/image"
                                         t-att-alt="room.name" class="img-fluid rounded"/>
                                </t>
                                <t t-else="">
                                    <div class="o_hotel_room_noimg o_hotel_room_noimg_lg"><i class="oi" data-icon="bed"/></div>
                                </t>
                            </div>
                            <h1>Chambre <t t-out="room.name"/></h1>
                            <p class="text-muted">
                                <i class="oi oi-filled me-1" data-icon="person"/><t t-out="room.capacity"/> personnes
                            </p>
                            <p t-if="room.description" t-out="room.description"/>
                            <h4 class="mt-3">Équipements</h4>
                            <div class="o_hotel_amenities">
                                <t t-foreach="room.amenity_ids" t-as="am">
                                    <span class="o_hotel_amenity">
                                        <i t-attf-class="oi #{am.icon or ''} me-1" t-attf-data-icon="#{am.icon or 'check'}"/><t t-out="am.name"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="o_hotel_booking_box" id="o_hotel_booking">
                                <h4>Réserver</h4>
                                <p class="text-muted small">
                                    Indiquez vos dates : nous vous proposons nos formules
                                    et les chambres disponibles.
                                </p>
                                <form method="get" action="/hotel/rooms" class="o_hotel_booking_form">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label">Arrivée</label>
                                            <input type="date" class="form-control" name="checkin"
                                                   t-att-value="checkin" t-att-min="today" required="required"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Départ</label>
                                            <input type="date" class="form-control" name="checkout"
                                                   t-att-value="checkout" t-att-min="today" required="required"/>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Personnes</label>
                                        <input type="number" class="form-control" name="guests"
                                               min="1" t-att-value="guests"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Type de location</label>
                                        <select name="booking_type" class="form-select" required="required">
                                            <option value="room" t-att-selected="booking_type != 'bed'">Chambre entière</option>
                                            <option value="bed" t-att-selected="booking_type == 'bed'">Lit en dortoir</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 mt-3">
                                        <i class="oi me-1" data-icon="search"/>Voir les disponibilités
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================= RÉSERVATION D'UNE FORMULE ================= -->
    <template id="book_page" name="Hôtel - Réservation">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <div class="container my-4">
                    <t t-set="type_qs" t-value="'checkin=%s&amp;checkout=%s&amp;guests=%s&amp;booking_type=%s' % (checkin or '', checkout or '', guests, booking_type or '')"/>
                    <a t-attf-href="/hotel/rooms?#{type_qs}#{'&amp;separate=1' if separate else ''}"
                       class="btn btn-link px-0 mb-2">
                        <i class="oi me-1" data-icon="chevron_left"/>Retour aux formules
                    </a>
                    <h1 t-out="room_type.name"/>
                    <p class="text-muted">
                        Du <t t-out="checkin"/> au <t t-out="checkout"/> · <t t-out="nights"/> nuit(s) ·
                        <t t-out="guests"/> personne(s) ·
                        <t t-if="booking_type == 'bed'">location au lit</t><t t-else="">chambre entière</t>
                    </p>
                    <div t-if="errors" class="alert alert-danger">
                        <ul class="mb-0">
                            <li t-foreach="errors" t-as="err" t-out="err"/>
                        </ul>
                    </div>
                    <form method="post" action="/hotel/booking/submit" class="o_hotel_booking_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="type_id" t-att-value="room_type.id"/>
                        <input type="hidden" name="checkin" t-att-value="checkin"/>
                        <input type="hidden" name="checkout" t-att-value="checkout"/>
                        <input type="hidden" name="guests" t-att-value="guests"/>
                        <input type="hidden" name="booking_type" t-att-value="booking_type"/>
                        <input t-if="separate" type="hidden" name="separate" value="1"/>
                        <div class="row">
                            <div class="col-lg-7">
                                <t t-if="not proposal['rooms']">
                                    <div class="alert alert-warning">
                                        Plus de disponibilité pour cette formule sur ces dates.
                                        <a class="alert-link" t-attf-href="/hotel/rooms?#{type_qs}">Voir les autres formules</a>
                                    </div>
                                </t>
                                <t t-elif="booking_type == 'bed'">
                                    <h4>Choisissez <t t-out="guests"/> lit(s)</h4>
                                    <p class="text-muted small">
                                        Lits proposés pour votre séjour<t t-if="separate">, éventuellement
                                        dans des chambres différentes</t><t t-else="">, dans une même chambre</t>.
                                    </p>
                                    <div t-if="booking_type == 'bed' and guests &gt; 1" class="mb-3">
                                        <a t-if="not separate" class="small"
                                           t-attf-href="/hotel/book?type_id=#{room_type.id}&amp;#{type_qs}&amp;separate=1">
                                            J'accepte d'être réparti dans des chambres différentes</a>
                                        <a t-else="" class="small"
                                           t-attf-href="/hotel/book?type_id=#{room_type.id}&amp;#{type_qs}">
                                            Je préfère être dans une même chambre</a>
                                    </div>
                                    <t t-foreach="beds_by_room" t-as="rb">
                                        <t t-set="room" t-value="rb[0]"/>
                                        <div class="border rounded mb-3 p-3">
                                            <div class="d-flex gap-3 align-items-center">
                                                <img t-if="room.image" t-attf-src="/web/image/hotel.room/#{room.id}/image?width=240"
                                                     t-att-alt="room.name" style="width: 96px; height: 64px; object-fit: cover; flex: none;" class="rounded"/>
                                                <div>
                                                    <strong>Chambre <t t-out="room.name"/></strong>
                                                    <div class="text-muted small"><t t-out="room.capacity"/> lits</div>
                                                </div>
                                            </div>
                                            <div class="o_hotel_bed_pick mt-2">
                                                <t t-foreach="rb[1]" t-as="bed">
                                                    <input class="btn-check" type="checkbox" name="bed_ids"
                                                           t-att-value="bed.id" t-att-id="'bed_%s' % bed.id"
                                                           t-att-checked="'checked' if bed.id in selected_bed_ids else None"/>
                                                    <label class="o_hotel_bed_option" t-att-for="'bed_%s' % bed.id">
                                                        <i class="oi" data-icon="bed"/>
                                                        <span class="fw-bold" t-out="bed.name"/>
                                                    </label>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <h4>Choisissez votre chambre</h4>
                                    <t t-foreach="proposal['rooms']" t-as="room">
                                        <input class="btn-check" type="radio" name="room_id"
                                               t-att-value="room.id" t-att-id="'room_%s' % room.id" required="required"
                                               t-att-checked="'checked' if room.id == selected_room_id or (len(proposal['rooms']) == 1) else None"/>
                                        <label class="btn btn-outline-secondary text-start mb-2 p-2 d-flex gap-3 align-items-center w-100"
                                               t-att-for="'room_%s' % room.id">
                                            <img t-if="room.image" t-attf-src="/web/image/hotel.room/#{room.id}/image?width=240"
                                                 t-att-alt="room.name" style="width: 120px; height: 80px; object-fit: cover; flex: none;" class="rounded"/>
                                            <div>
                                                <strong>Chambre <t t-out="room.name"/></strong>
                                                <div class="text-muted small">
                                                    <i class="oi oi-filled me-1" data-icon="person"/><t t-out="room.capacity"/> pers.
                                                </div>
                                                <div class="o_hotel_amenities">
                                                    <t t-foreach="room.amenity_ids" t-as="am">
                                                        <span class="o_hotel_amenity" t-att-title="am.name">
                                                            <i t-attf-class="oi #{am.icon or ''} me-1" t-attf-data-icon="#{am.icon or 'check'}"/><t t-out="am.name"/>
                                                        </span>
                                                    </t>
                                                </div>
                                            </div>
                                        </label>
                                    </t>
                                </t>
                            </div>
                            <div class="col-lg-5">
                                <div class="o_hotel_booking_box" id="o_hotel_booking">
                                    <div class="o_hotel_booking_price mb-2">
                                        <span t-out="total" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        <small class="text-muted">au total
                                            (<span t-out="unit" t-options='{"widget": "monetary", "display_currency": currency}'/> / nuit)</small>
                                    </div>
                                    <div class="row g-2 mt-0">
                                        <div class="col-6">
                                            <label class="form-label">Nom</label>
                                            <input type="text" class="form-control" name="last_name"
                                                   t-att-value="last_name" required="required"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Prénom</label>
                                            <input type="text" class="form-control" name="first_name"
                                                   t-att-value="first_name" required="required"/>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Date de naissance</label>
                                        <input type="date" class="form-control" name="birthdate"
                                               t-att-value="birthdate" t-att-max="birthdate_max"
                                               required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">E-mail</label>
                                        <input type="email" class="form-control" name="email"
                                               t-att-value="email" required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Téléphone</label>
                                        <input type="text" class="form-control" name="phone"
                                               t-att-value="phone" required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Adresse</label>
                                        <input type="text" class="form-control" name="street"
                                               t-att-value="street" required="required"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Ville</label>
                                        <input type="text" class="form-control" name="city"
                                               t-att-value="city"/>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Demandes particulières</label>
                                        <textarea class="form-control" name="note" rows="2" t-out="note"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 mt-3"
                                            t-att-disabled="None if proposal['rooms'] else 'disabled'">
                                        <i class="oi me-1" data-icon="check"/>Envoyer ma demande de réservation
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- ================= CONFIRMATION ================= -->
    <template id="booking_confirmation_page" name="Hôtel - Confirmation">
        <t t-call="website.layout">
            <div class="o_hotel_web">
                <div class="container my-5">
                    <div class="o_hotel_confirm text-center">
                        <div class="o_hotel_confirm_icon"><i class="oi oi-filled" data-icon="check_circle"/></div>
                        <h1>Demande de réservation enregistrée !</h1>
                        <p class="lead">
                            Merci <t t-out="reservation.partner_id.name"/>,
                            votre demande <strong t-out="reservation.name"/> a bien été prise en compte.
                            Elle est <strong>en attente de confirmation</strong> par notre équipe.
                        </p>
                        <div class="o_hotel_confirm_card mx-auto">
                            <table class="table mb-0">
                                <tr><th>Référence</th><td t-out="reservation.name"/></tr>
                                <tr t-if="reservation.room_type_id"><th>Formule</th>
                                    <td t-out="reservation.room_type_id.name"/></tr>
                                <tr><th>Chambre(s)</th>
                                    <td t-out="', '.join(reservation.line_ids.mapped('room_id.name')) or '—'"/></tr>
                                <tr t-if="reservation.line_ids.mapped('bed_ids')"><th>Lit(s)</th>
                                    <td t-out="', '.join(reservation.line_ids.mapped('bed_ids.name'))"/></tr>
                                <tr><th>Arrivée</th><td t-out="reservation.checkin"/></tr>
                                <tr><th>Départ</th><td t-out="reservation.checkout"/></tr>
                                <tr><th>Nuits</th><td t-out="reservation.nights"/></tr>
                                <tr><th>Total</th>
                                    <td><span t-field="reservation.amount_total"
                                        t-options='{"widget": "monetary", "display_currency": reservation.currency_id}'/></td></tr>
                            </table>
                        </div>
                        <div class="o_hotel_confirm_card mx-auto mt-3 text-start"
                             t-if="reservation.company_id.hotel_deposit_instructions and reservation.deposit_requested">
                            <h5>Acompte pour garantir votre réservation</h5>
                            <p class="mb-1">Montant demandé :
                                <strong t-field="reservation.deposit_requested"
                                        t-options='{"widget": "monetary", "display_currency": reservation.currency_id}'/></p>
                            <p class="mb-0" style="white-space: pre-line;" t-out="reservation.company_id.hotel_deposit_instructions"/>
                            <p class="text-muted small mb-0">Indiquez la référence <strong t-out="reservation.name"/> lors du virement.</p>
                        </div>
                        <p class="text-muted mt-3">
                            Notre équipe vous contactera pour finaliser votre séjour.
                        </p>
                        <a href="/hotel/rooms" class="btn btn-primary">Retour aux chambres</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
