<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_reservation_mail_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.mail.wizard.form</field>
        <field name="model">hotel.reservation.mail.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoyer mail">
                <group>
                    <field name="reservation_id" invisible="1"/>
                    <field name="email_to" widget="email" placeholder="destinataire@exemple.com"/>
                    <field name="subject"/>
                </group>
                <field name="body" class="oe-bordered-editor" options="{'height': 300}"/>
                <footer>
                    <button name="action_send" string="Envoyer" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_reservation_mail_wizard" model="ir.actions.act_window">
        <field name="name">Envoyer mail</field>
        <field name="res_model">hotel.reservation.mail.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
