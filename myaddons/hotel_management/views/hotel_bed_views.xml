<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_bed_tree" model="ir.ui.view">
        <field name="name">hotel.bed.tree</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="room_id"/>
                <field name="room_type_id" readonly="1"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="status" widget="badge" readonly="1"
                       decoration-success="status == 'free'"
                       decoration-info="status == 'reserved'"
                       decoration-danger="status == 'occupied'"
                       decoration-muted="status in ('maintenance', 'out_of_service')"/>
                <field name="current_guest_id" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_bed_form" model="ir.ui.view">
        <field name="name">hotel.bed.form</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : 101-L1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="room_type_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_bed_search" model="ir.ui.view">
        <field name="name">hotel.bed.search</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_room" string="Chambre" context="{'group_by': 'room_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'room_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_bed" model="ir.actions.act_window">
        <field name="name">Lits</field>
        <field name="res_model">hotel.bed</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hotel_bed_search"/>
    </record>

    <!-- Configuration > Nombre de lits : liste des chambres, puis lits de la chambre -->
    <record id="view_hotel_room_beds_tree" model="ir.ui.view">
        <field name="name">hotel.room.beds.tree</field>
        <field name="model">hotel.room</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <tree string="Nombre de lits" create="0" delete="0">
                <field name="name" string="Chambre"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="rental_mode"/>
                <field name="bed_summary" string="Lits créés"/>
                <field name="bed_availability" string="Disponibilité"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'partial'"
                       decoration-info="status == 'reserved'"
                       decoration-danger="status == 'occupied'"
                       decoration-primary="status == 'cleaning'"
                       decoration-muted="status in ('maintenance', 'out_of_service')"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_room_beds_form" model="ir.ui.view">
        <field name="name">hotel.room.beds.form</field>
        <field name="model">hotel.room</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Lits de la chambre" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Chambre"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_type_id" readonly="1"/>
                            <field name="floor" readonly="1"/>
                            <field name="rental_mode" readonly="1"/>
                            <field name="whole_room_price" widget="monetary"
                                   invisible="rental_mode == 'bed'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="bed_summary" string="Lits créés"/>
                            <field name="bed_availability" string="Disponibilité"
                                   invisible="not bed_count"/>
                            <field name="bed_count" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Lits de la chambre"/>
                    <field name="bed_ids" context="{'default_room_id': id}">
                        <tree editable="bottom">
                            <field name="name" string="Référence"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="status" widget="badge" readonly="1"
                                   decoration-success="status == 'free'"
                                   decoration-info="status == 'reserved'"
                                   decoration-danger="status == 'occupied'"
                                   decoration-muted="status in ('maintenance', 'out_of_service')"/>
                            <field name="current_guest_id" readonly="1"/>
                            <field name="active" string="Actif" widget="boolean_toggle"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_room_beds" model="ir.actions.act_window">
        <field name="name">Nombre de lits</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hotel_room_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hotel_room_beds_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hotel_room_beds_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune chambre pour le moment</p>
            <p>Créez d'abord vos chambres dans le menu « Chambres », puis réglez ici leurs lits.</p>
        </field>
    </record>
</odoo>
