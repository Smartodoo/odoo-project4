<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_bed_tree" model="ir.ui.view">
        <field name="name">hotel.bed.tree</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="action_create_housekeeping" type="object" string="Housekeeping"
                            icon="wand_stars"
                            help="Crée une tâche de ménage pour les lits sélectionnés"/>
                </header>
                <field name="name"/>
                <field name="room_id"/>
                <field name="room_type_id" readonly="1"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="status" widget="badge" readonly="1"
                       decoration-success="status == 'free'"
                       decoration-warning="status == 'cleaning'"
                       decoration-info="status == 'reserved'"
                       decoration-danger="status == 'occupied'"
                       decoration-muted="status in ('maintenance', 'out_of_service')"/>
                <field name="current_guest_id" readonly="1" optional="show"/>
                <field name="housekeeping_status" widget="badge" readonly="1" optional="show"
                       decoration-warning="housekeeping_status == 'dirty'"
                       decoration-info="housekeeping_status == 'inprogress'"
                       decoration-success="housekeeping_status in ('clean', 'inspected')"
                       decoration-danger="housekeeping_status == 'to_repair'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_bed_form" model="ir.ui.view">
        <field name="name">hotel.bed.form</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Statut calculé (réservations / travaux de la chambre),
                         même présentation que la fiche chambre -->
                    <field name="status" widget="statusbar" class="o_hotel_statusbar o_hotel_status"
                           statusbar_visible="free,reserved,occupied,cleaning,maintenance,out_of_service"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_housekeeping" type="object"
                                class="oe_stat_button" icon="wand_stars">
                            <field name="housekeeping_count" widget="statinfo" string="Housekeeping"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : 101-L1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="room_type_id" readonly="1"/>
                            <field name="current_guest_id" invisible="not current_guest_id"/>
                            <field name="housekeeping_status" widget="badge" readonly="1"
                                   decoration-warning="housekeeping_status == 'dirty'"
                                   decoration-info="housekeeping_status == 'inprogress'"
                                   decoration-success="housekeeping_status in ('clean', 'inspected')"
                                   decoration-danger="housekeeping_status == 'to_repair'"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cartes des lits, regroupées par chambre (liseré coloré selon l'état) -->
    <record id="view_hotel_bed_kanban" model="ir.ui.view">
        <field name="name">hotel.bed.kanban</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <kanban class="o_hotel_kanban" quick_create="0"
                    group_create="0" group_delete="0" group_edit="0" sample="1">
                <field name="status"/>
                <field name="currency_id"/>
                <field name="current_guest_id"/>
                <field name="housekeeping_status"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_hotel_kcard o_hotel_kcard_bed_#{record.status.raw_value}">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="fw-bold">
                                    <i class="oi me-1" data-icon="bed" title="Lit"/><field name="name"/>
                                </span>
                                <span t-attf-class="badge rounded-pill o_hotel_bed_badge_#{record.status.raw_value}">
                                    <field name="status"/>
                                </span>
                            </div>
                            <div class="text-muted small">
                                <i class="oi me-1" data-icon="key" title="Chambre"/>
                                <field name="room_id"/> · <field name="room_type_id"/>
                            </div>
                            <div t-if="record.current_guest_id.raw_value" class="small">
                                <i class="oi oi-filled me-1" data-icon="person" title="Client"/>
                                <field name="current_guest_id"/>
                            </div>
                            <div t-if="!['clean', 'inspected'].includes(record.housekeeping_status.raw_value)"
                                 class="small text-warning">
                                <i class="oi me-1" data-icon="wand_stars" title="Housekeeping"/>
                                <field name="housekeeping_status"/>
                            </div>
                            <footer class="mt-1">
                                <div class="ms-auto text-end">
                                    <field name="price" widget="monetary" class="fw-bold"/>
                                    <small class="text-muted"> / nuit</small>
                                </div>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_bed_search" model="ir.ui.view">
        <field name="name">hotel.bed.search</field>
        <field name="model">hotel.bed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <filter name="to_clean" string="À nettoyer"
                        domain="[('housekeeping_status', 'in', ('dirty', 'inprogress'))]"/>
                <separator/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_room" string="Chambre" context="{'group_by': 'room_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'room_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_bed" model="ir.actions.act_window">
        <field name="name">Lits</field>
        <field name="res_model">hotel.bed</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hotel_bed_search"/>
        <field name="context">{'search_default_group_room': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun lit pour le moment</p>
            <p>Ajoutez un lit en choisissant sa chambre ; la référence et le prix sont proposés automatiquement.</p>
        </field>
    </record>

    <!-- Configuration > Nombre de lits : liste des chambres, puis lits de la chambre -->
    <record id="view_hotel_room_beds_tree" model="ir.ui.view">
        <field name="name">hotel.room.beds.tree</field>
        <field name="model">hotel.room</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Nombre de lits" create="0" delete="0">
                <field name="name" string="Chambre"/>
                <field name="room_type_id"/>
                <field name="floor_id"/>
                <field name="rental_mode"/>
                <field name="bed_summary" string="Lits créés"/>
                <field name="bed_availability" string="Disponibilité"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'partial'"
                       decoration-info="status == 'reserved'"
                       decoration-danger="status == 'occupied'"
                       decoration-primary="status == 'cleaning'"
                       decoration-muted="status in ('maintenance', 'out_of_service')"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_beds_form" model="ir.ui.view">
        <field name="name">hotel.room.beds.form</field>
        <field name="model">hotel.room</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Lits de la chambre" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Chambre"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_type_id" readonly="1"/>
                            <field name="floor_id" readonly="1"/>
                            <field name="rental_mode" readonly="1"/>
                            <field name="whole_room_price" widget="monetary"
                                   invisible="rental_mode == 'bed'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="bed_summary" string="Lits créés"/>
                            <field name="bed_availability" string="Disponibilité"
                                   invisible="not bed_count"/>
                            <field name="bed_count" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Lits de la chambre"/>
                    <field name="bed_ids" context="{'default_room_id': id}">
                        <list editable="bottom">
                            <field name="name" string="Référence"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="status" widget="badge" readonly="1"
                                   decoration-success="status == 'free'"
                                   decoration-warning="status == 'cleaning'"
                                   decoration-info="status == 'reserved'"
                                   decoration-danger="status == 'occupied'"
                                   decoration-muted="status in ('maintenance', 'out_of_service')"/>
                            <field name="current_guest_id" readonly="1"/>
                            <field name="active" string="Actif" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_room_beds" model="ir.actions.act_window">
        <field name="name">Nombre de lits</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_room_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hotel_room_beds_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hotel_room_beds_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune chambre pour le moment</p>
            <p>Créez d'abord vos chambres dans le menu « Chambres », puis réglez ici leurs lits.</p>
        </field>
    </record>
</odoo>
