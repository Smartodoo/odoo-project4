<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================= PLANNING GRAPHIQUE (§3.3) ================= -->
    <record id="action_hotel_planning" model="ir.actions.client">
        <field name="name">Planning</field>
        <field name="tag">hotel_planning</field>
    </record>

    <!-- ================= ANALYSE DU CHIFFRE D'AFFAIRES (§15) ================= -->
    <record id="view_hotel_revenue_report_pivot" model="ir.ui.view">
        <field name="name">hotel.revenue.report.pivot</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <pivot string="Chiffre d'affaires" sample="1">
                <field name="room_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="room_nights" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hotel_revenue_report_graph" model="ir.ui.view">
        <field name="name">hotel.revenue.report.graph</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <graph string="Chiffre d'affaires par jour" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hotel_revenue_report_list" model="ir.ui.view">
        <field name="name">hotel.revenue.report.list</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="reservation_id"/>
                <field name="partner_id"/>
                <field name="room_id"/>
                <field name="bed_id"/>
                <field name="source"/>
                <field name="room_nights" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_revenue_report_search" model="ir.ui.view">
        <field name="name">hotel.revenue.report.search</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_id"/>
                <field name="bed_id"/>
                <field name="partner_id"/>
                <field name="reservation_id"/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_day" string="Jour" context="{'group_by': 'date:day'}"/>
                    <filter name="group_month" string="Mois" context="{'group_by': 'date:month'}"/>
                    <filter name="group_room" string="Chambre" context="{'group_by': 'room_id'}"/>
                    <filter name="group_bed" string="Lit" context="{'group_by': 'bed_id'}"/>
                    <filter name="group_type" string="Type de chambre" context="{'group_by': 'room_type_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_revenue_report" model="ir.actions.act_window">
        <field name="name">Chiffre d'affaires</field>
        <field name="res_model">hotel.revenue.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_hotel_revenue_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune nuitée vendue</p>
            <p>Une ligne par nuit et par lit (ou chambre) réservé : regroupez par jour, mois,
               chambre, lit, type ou source pour analyser le chiffre d'affaires hébergement.</p>
        </field>
    </record>

    <record id="action_hotel_revenue_by_bed" model="ir.actions.act_window">
        <field name="name">CA par lit</field>
        <field name="res_model">hotel.revenue.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_hotel_revenue_report_search"/>
        <field name="domain">[('bed_id', '!=', False)]</field>
        <field name="context">{'pivot_row_groupby': ['bed_id'], 'pivot_measures': ['amount', 'bed_nights']}</field>
    </record>

    <record id="action_hotel_revenue_by_source" model="ir.actions.act_window">
        <field name="name">Performance par source</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', 'in', ('confirmed', 'checkin', 'checkout'))]</field>
        <field name="context">{'pivot_row_groupby': ['source'], 'pivot_measures': ['__count', 'amount_total', 'nights', 'guest_count']}</field>
    </record>

    <!-- ================= RAPPORT D'ACTIVITÉ (assistant) ================= -->
    <record id="view_hotel_activity_report_wizard_form" model="ir.ui.view">
        <field name="name">hotel.activity.report.wizard.form</field>
        <field name="model">hotel.activity.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport d'activité">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <div class="text-muted small">
                    Chiffre d'affaires, nuitées, taux d'occupation, durée moyenne des séjours,
                    nombre de clients, encaissements par mode, répartition par source et par chambre.
                </div>
                <footer>
                    <button name="action_print" string="Imprimer (PDF)" type="object" class="btn-primary"/>
                    <button name="action_analyze" string="Analyser" type="object" class="btn-secondary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_activity_report_wizard" model="ir.actions.act_window">
        <field name="name">Rapport d'activité</field>
        <field name="res_model">hotel.activity.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================= CONSOMMATIONS / SERVICES ================= -->
    <record id="view_product_template_form_hotel" model="ir.ui.view">
        <field name="name">product.template.form.hotel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="hotel_service"/>
                    <label for="hotel_service"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="action_hotel_service_products" model="ir.actions.act_window">
        <field name="name">Consommations &amp; services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('hotel_service', '=', True)]</field>
        <field name="context">{'default_hotel_service': True, 'default_type': 'service'}</field>
    </record>

    <record id="view_hotel_reservation_service_list" model="ir.ui.view">
        <field name="name">hotel.reservation.service.list</field>
        <field name="model">hotel.reservation.service</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="reservation_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_reservation_service_pivot" model="ir.ui.view">
        <field name="name">hotel.reservation.service.pivot</field>
        <field name="model">hotel.reservation.service</field>
        <field name="arch" type="xml">
            <pivot string="Consommations">
                <field name="product_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_hotel_reservation_service" model="ir.actions.act_window">
        <field name="name">Consommations vendues</field>
        <field name="res_model">hotel.reservation.service</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- ================= PARAMÈTRES ================= -->
    <record id="res_config_settings_view_form_hotel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hotel</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Auberge" string="Auberge" name="hotel_management"
                     groups="hotel_management.group_hotel_manager">
                    <block title="Facturation et acomptes" name="hotel_billing">
                        <setting string="Facturer automatiquement au départ"
                                 help="Au check-out, la facture du séjour est créée et validée ; les acomptes sont déduits.">
                            <field name="hotel_auto_invoice"/>
                        </setting>
                        <setting string="Acompte demandé"
                                 help="Pourcentage du séjour demandé en acompte (affiché au client du site web).">
                            <field name="hotel_deposit_percent" class="oe_inline"/> %
                        </setting>
                        <setting string="Instructions de paiement de l'acompte"
                                 help="Compte CCP / RIB affiché après une réservation en ligne et dans l'e-mail de confirmation.">
                            <field name="hotel_deposit_instructions" placeholder="CCP n° … clé … — au nom de …"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_hotel_config_settings" model="ir.actions.act_window">
        <field name="name">Paramètres</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'hotel_management'}</field>
    </record>
</odoo>
