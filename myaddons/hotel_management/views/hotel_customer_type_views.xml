<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_customer_type_list" model="ir.ui.view">
        <field name="name">hotel.customer.type.list</field>
        <field name="model">hotel.customer.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="is_blacklist" widget="boolean_toggle"/>
                <field name="partner_count"/>
                <button name="action_view_partners" type="object" string="Voir les clients"
                        icon="group" class="btn-link"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_customer_type_form" model="ir.ui.view">
        <field name="name">hotel.customer.type.form</field>
        <field name="model">hotel.customer.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partners" type="object" class="oe_stat_button"
                                icon="group">
                            <field name="partner_count" widget="statinfo" string="Clients"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Client fidèle"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="is_blacklist" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clients de ce type" name="partners">
                            <field name="partner_ids" readonly="1" context="{'active_test': False}">
                                <list>
                                    <field name="display_name" string="Client"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="city"/>
                                    <field name="hotel_id_number" optional="show"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="text-muted small">
                                Le type se change sur la fiche du client (onglet Auberge) ;
                                le bouton « Clients » ouvre la liste complète, filtrable et imprimable.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_customer_type_search" model="ir.ui.view">
        <field name="name">hotel.customer.type.search</field>
        <field name="model">hotel.customer.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="blacklist" string="Alerte rouge" domain="[('is_blacklist', '=', True)]"/>
                <separator/>
                <filter name="inactive" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hotel_customer_type" model="ir.actions.act_window">
        <field name="name">Types de client</field>
        <field name="res_model">hotel.customer.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un type de client</p>
            <p>Exemples : client fidèle, client VIP, liste noire.
               Le type se choisit sur la fiche client ou sur la réservation.</p>
        </field>
    </record>
</odoo>
