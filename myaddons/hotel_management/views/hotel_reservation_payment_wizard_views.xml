<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Fenêtre « Encaisser » (acompte / paiement) -->
    <record id="view_hotel_reservation_payment_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.payment.wizard.form</field>
        <field name="model">hotel.reservation.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Encaisser">
                <field name="reservation_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <div class="alert alert-info d-flex flex-wrap gap-4 mb-3" role="status">
                    <div>Total séjour : <strong><field name="amount_total" class="oe_inline"/></strong></div>
                    <div>Déjà payé : <strong><field name="amount_paid" class="oe_inline"/></strong></div>
                    <div>Reste à payer : <strong><field name="amount_due" class="oe_inline"/></strong></div>
                </div>
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="payment_kind" widget="radio" options="{'horizontal': true}"/>
                        <field name="payment_mode" widget="radio"/>
                        <field name="cheque_reference" invisible="payment_mode != 'cheque'"
                               required="payment_mode == 'cheque'"/>
                    </group>
                    <group>
                        <field name="amount" widget="monetary"/>
                        <field name="date"/>
                        <field name="payment_method_line_id" options="{'no_create': True, 'no_open': True}"
                               groups="account.group_account_manager"/>
                        <field name="journal_id" readonly="1" groups="account.group_account_invoice"/>
                        <field name="memo" placeholder="Optionnel"/>
                    </group>
                </group>
                <div class="text-muted small" invisible="payment_kind != 'deposit'">
                    <i class="oi oi-filled me-1" data-icon="info" title="Info"/>
                    L'acompte sera déduit automatiquement de la facture à sa validation.
                </div>
                <footer>
                    <button name="action_confirm" string="Encaisser" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Paiement : afficher la réservation, le type et le mode -->
    <record id="view_account_payment_form_hotel" model="ir.ui.view">
        <field name="name">account.payment.form.hotel</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="class">o_hotel_statusbar</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="hotel_reservation_id" invisible="not hotel_reservation_id"/>
                <field name="hotel_payment_kind" invisible="not hotel_reservation_id"/>
                <field name="hotel_payment_mode" invisible="not hotel_payment_mode"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_hotel" model="ir.ui.view">
        <field name="name">account.payment.tree.hotel</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="hotel_payment_mode" optional="show"/>
                <field name="hotel_payment_kind" optional="show"/>
                <field name="hotel_reservation_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Journal : choisir quel mode de l'auberge correspond à chaque ligne -->
    <record id="view_account_journal_form_hotel" model="ir.ui.view">
        <field name="name">account.journal.form.hotel</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']" position="after">
                <field name="hotel_payment_mode" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
