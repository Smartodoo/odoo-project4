<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_checkin" string="Check-in" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_checkout" string="Check-out" type="object"
                            class="btn-primary" invisible="state != 'checkin'"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state in ('checkout', 'cancel')"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object"
                            invisible="state != 'cancel'"/>
                    <button name="action_send_confirmation" string="Envoyer confirmation"
                            type="object" invisible="state not in ('confirmed', 'checkin')"/>
                    <button name="action_create_invoice" string="Créer la facture"
                            type="object" class="btn-primary"
                            invisible="state not in ('checkin', 'checkout') or invoice_count &gt; 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checkin,checkout"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_restaurant_orders" type="object"
                                class="oe_stat_button" icon="fa-cutlery">
                            <field name="restaurant_order_count" widget="statinfo"
                                   string="Resto"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Factures"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="checkin"/>
                            <field name="checkout"/>
                            <field name="nights"/>
                        </group>
                        <group>
                            <field name="adults"/>
                            <field name="children"/>
                            <field name="guest_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chambres" name="rooms">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="room_id"/>
                                    <field name="room_type_id" readonly="1"/>
                                    <field name="nights" readonly="1"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="room_count"/>
                                <field name="amount_total" widget="monetary"/>
                                <field name="restaurant_amount" widget="monetary"/>
                                <field name="amount_grand_total" widget="monetary"
                                       class="oe_subtotal_footer_separator"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Remarques, demandes particulières…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'confirmed'"
                  decoration-success="state == 'checkin'"
                  decoration-muted="state in ('checkout', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="checkin"/>
                <field name="checkout"/>
                <field name="nights"/>
                <field name="room_count"/>
                <field name="guest_count"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'checkin'"
                       decoration-muted="state in ('checkout', 'cancel')"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Réservations" date_start="checkin" date_stop="checkout"
                      color="partner_id" mode="month">
                <field name="partner_id"/>
                <field name="room_count"/>
            </calendar>
        </field>
    </record>

    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmées" domain="[('state', '=', 'confirmed')]"/>
                <filter name="checkin" string="En séjour" domain="[('state', '=', 'checkin')]"/>
                <separator/>
                <filter name="arrivals_today" string="Arrivées du jour"
                        domain="[('checkin', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="departures_today" string="Départs du jour"
                        domain="[('checkout', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_checkin" string="Arrivée" context="{'group_by': 'checkin'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="search_view_id" ref="view_hotel_reservation_search"/>
    </record>
</odoo>
