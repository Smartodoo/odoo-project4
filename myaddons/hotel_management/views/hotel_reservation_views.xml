<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_checkin" string="Entrer" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"
                            help="Le client entre : la/les chambre(s) passent en « Occupée »."/>
                    <button name="action_checkout" string="Sortir" type="object"
                            class="btn-primary" invisible="state != 'checkin'"
                            help="Le client sort : la/les chambre(s) passent en « À nettoyer »."/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state in ('checkout', 'cancel')"/>
                    <button name="%(hotel_management.action_hotel_reservation_mail_wizard)d"
                            string="Envoyer mail" type="action"
                            context="{'default_reservation_id': id}"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object"
                            invisible="state != 'cancel'"/>
                    <button name="action_send_confirmation" string="Envoyer confirmation"
                            type="object" invisible="state not in ('confirmed', 'checkin')"/>
                    <button name="action_create_invoice" string="Créer la facture"
                            type="object" class="btn-primary"
                            invisible="state not in ('checkin', 'checkout') or invoice_count &gt; 0"/>
                    <button name="action_register_hotel_payment" string="Encaisser"
                            type="object" class="btn-primary" icon="payments"
                            invisible="state == 'cancel' or amount_due &lt;= 0"
                            help="Encaisser un acompte ou un paiement (espèces, carte, virement, chèque)."/>
                    <button name="action_refund_hotel_payment" string="Rembourser"
                            type="object" invisible="amount_paid &lt;= 0"
                            help="Rembourser tout ou partie de ce que le client a payé."/>
                    <button name="%(hotel_management.action_report_hotel_reservation_confirmation)d"
                            string="Confirmation" type="action" icon="print"
                            invisible="state not in ('confirmed', 'checkin')"
                            help="Imprimer la confirmation de réservation."/>
                    <button name="%(hotel_management.action_report_hotel_guest_card)d"
                            string="Fiche client" type="action" icon="badge"
                            invisible="state not in ('confirmed', 'checkin', 'checkout')"
                            help="Imprimer la fiche client (police) du check-in."/>
                    <field name="state" widget="statusbar" class="o_hotel_statusbar o_hotel_statusbar_flow"
                           statusbar_visible="draft,confirmed,checkin,checkout"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="article"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Factures"/>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="payments"
                                invisible="payment_count == 0">
                            <field name="payment_count" widget="statinfo"
                                   string="Paiements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <!-- Bandeau paiement : toujours visible en haut de la réservation -->
                    <div class="o_hotel_pay_summary" invisible="not amount_total">
                        <div class="o_hotel_pay_item">
                            <span class="o_hotel_pay_label">Total séjour</span>
                            <field name="amount_total" widget="monetary" class="o_hotel_pay_value"/>
                        </div>
                        <div class="o_hotel_pay_item o_hotel_pay_paid">
                            <span class="o_hotel_pay_label">Payé</span>
                            <field name="amount_paid" widget="monetary" class="o_hotel_pay_value"/>
                            <span class="o_hotel_pay_hint" invisible="not deposit_amount">
                                dont acompte <field name="deposit_amount" widget="monetary" class="oe_inline"/>
                            </span>
                        </div>
                        <div class="o_hotel_pay_item o_hotel_pay_due" invisible="amount_due &lt;= 0">
                            <span class="o_hotel_pay_label">Reste à payer</span>
                            <field name="amount_due" widget="monetary" class="o_hotel_pay_value"/>
                        </div>
                        <div class="o_hotel_pay_item o_hotel_pay_ok" invisible="amount_due &gt; 0">
                            <span class="o_hotel_pay_label">Reste à payer</span>
                            <span class="o_hotel_pay_value"><i class="oi oi-filled me-1" data-icon="check_circle" title="Soldé"/>Soldé</span>
                        </div>
                    </div>
                    <group>
                        <group string="Client" name="client">
                            <field name="partner_id"/>
                            <field name="partner_last_name" invisible="not partner_id"/>
                            <field name="partner_first_name" invisible="not partner_id"/>
                            <field name="partner_birthdate" invisible="not partner_id"
                                   required="partner_id"/>
                            <field name="partner_phone" widget="phone" invisible="not partner_id"/>
                            <label for="partner_street" string="Adresse" invisible="not partner_id"/>
                            <div class="o_row" invisible="not partner_id">
                                <field name="partner_street" placeholder="Rue…"/>
                                <field name="partner_city" placeholder="Ville"/>
                            </div>
                            <field name="partner_id_type" invisible="not partner_id"/>
                            <field name="partner_id_number" invisible="not partner_id"/>
                            <field name="partner_id_document" filename="partner_id_document_name"
                                   invisible="not partner_id"/>
                            <field name="partner_id_document_name" invisible="1"/>
                        </group>
                        <group string="Séjour" name="stay">
                            <field name="checkin"/>
                            <field name="checkout"/>
                            <field name="nights"/>
                            <field name="source"/>
                            <field name="booking_type" widget="radio" options="{'horizontal': true}"/>
                            <label for="adults" string="Personnes"/>
                            <div class="o_row">
                                <field name="adults"/> <span>adulte(s)</span>
                                <field name="children"/> <span>enfant(s)</span>
                            </div>
                            <field name="guest_count" string="Total personnes"/>
                            <field name="places"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert"
                         invisible="not line_ids or guest_count &lt;= places">
                        <i class="oi me-2" data-icon="warning" title="Attention"/>
                        <span>
                            <field name="guest_count" class="oe_inline fw-bold"/> personne(s) pour
                            <field name="places" class="oe_inline fw-bold"/> place(s) réservée(s) :
                            ajoutez des lits ou une chambre, sinon la confirmation sera refusée.
                        </span>
                    </div>
                    <notebook>
                        <page string="Chambres" name="rooms">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="room_id"/>
                                    <field name="booking_type" column_invisible="1"/>
                                    <field name="available_bed_ids" column_invisible="1"/>
                                    <field name="bed_ids" widget="many2many_tags"
                                           domain="[('id', 'in', available_bed_ids)]"
                                           options="{'no_create': True, 'no_open': True}"
                                           readonly="booking_type == 'room'"
                                           required="booking_type == 'bed'"/>
                                    <field name="room_type_id" readonly="1"/>
                                    <field name="nights" readonly="1"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <group string="Remise" name="discount">
                                    <label for="discount_value" string="Remise"/>
                                    <div class="o_row">
                                        <field name="discount_value"/>
                                        <field name="discount_type" nolabel="1"/>
                                    </div>
                                </group>
                                <group class="oe_subtotal_footer">
                                <field name="room_count"/>
                                <field name="amount_rooms" widget="monetary"/>
                                <field name="amount_services" widget="monetary" invisible="not amount_services"/>
                                <field name="amount_discount" widget="monetary" invisible="not amount_discount"/>
                                <field name="amount_untaxed" widget="monetary" invisible="not amount_tax"/>
                                <field name="amount_tax" widget="monetary" invisible="not amount_tax"/>
                                <field name="amount_total" widget="monetary"/>
                                <field name="deposit_amount" widget="monetary" string="dont acompte versé"
                                       invisible="not deposit_amount"/>
                                <field name="amount_paid" widget="monetary"/>
                                <field name="amount_due" widget="monetary"
                                       class="oe_subtotal_footer_separator"
                                       decoration-danger="amount_due &gt; 0"
                                       decoration-success="amount_due &lt;= 0 and amount_total &gt; 0"/>
                                <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Consommations &amp; services" name="services">
                            <field name="service_ids" readonly="state == 'cancel'">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="text-muted small">
                                Ajoutez ici les consommations et services du client (petit-déjeuner,
                                repas, boissons, blanchisserie…). Ils sont ajoutés à la facture du séjour.
                                Pour proposer un nouvel article, cochez « Consommation / service Auberge » sur sa fiche.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Remarques, demandes particulières…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'"
                  decoration-success="state == 'checkin'"
                  decoration-muted="state in ('checkout', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="checkin"/>
                <field name="checkout"/>
                <field name="nights"/>
                <field name="room_count"/>
                <field name="guest_count"/>
                <field name="source" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="deposit_amount" widget="monetary" sum="Acomptes" optional="hide"/>
                <field name="amount_paid" widget="monetary" sum="Payé" optional="show"/>
                <field name="amount_due" widget="monetary" sum="Reste à payer" optional="show"
                       decoration-danger="amount_due &gt; 0 and state in ('checkin', 'checkout')"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'checkin'"
                       decoration-muted="state in ('checkout', 'cancel')"/>
                <button name="action_confirm" type="object" string="Confirmer"
                        icon="check" invisible="state != 'draft'"/>
                <button name="action_checkin" type="object" string="Entrer"
                        icon="login" invisible="state != 'confirmed'"/>
                <button name="action_checkout" type="object" string="Sortir"
                        icon="logout" invisible="state != 'checkin'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Réservations" date_start="checkin" date_stop="checkout"
                      color="partner_id" mode="month">
                <field name="partner_id"/>
                <field name="room_count"/>
            </calendar>
        </field>
    </record>

    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_phone"/>
                <field name="partner_id_number"/>
                <filter name="draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmées" domain="[('state', '=', 'confirmed')]"/>
                <filter name="checkin" string="En séjour" domain="[('state', '=', 'checkin')]"/>
                <separator/>
                <filter name="arrivals_today" string="Arrivées du jour"
                        domain="[('checkin', '=', 'today')]"/>
                <filter name="departures_today" string="Départs du jour"
                        domain="[('checkout', '=', 'today')]"/>
                <filter name="upcoming" string="À venir"
                        domain="[('checkin', '&gt;', 'today'), ('state', 'in', ('draft', 'confirmed'))]"/>
                <filter name="unpaid" string="Impayés"
                        domain="[('amount_due', '&gt;', 0), ('state', 'in', ('checkin', 'checkout'))]"/>
                <separator/>
                <filter name="filter_checkin" string="Date d'arrivée" date="checkin"/>
                <group>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_month" string="Mois d'arrivée" context="{'group_by': 'checkin:month'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_checkin" string="Arrivée" context="{'group_by': 'checkin'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Statistiques des réservations (§15) : performance par source, durée
         moyenne des séjours, nombre de clients -->
    <record id="view_hotel_reservation_pivot" model="ir.ui.view">
        <field name="name">hotel.reservation.pivot</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <pivot string="Réservations" sample="1">
                <field name="source" type="row"/>
                <field name="checkin" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="nights" type="measure" string="Durée moyenne (nuits)"/>
                <field name="guest_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hotel_reservation_graph" model="ir.ui.view">
        <field name="name">hotel.reservation.graph</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <graph string="Réservations par source" type="bar" sample="1">
                <field name="source"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_hotel_reservation_search"/>
    </record>
</odoo>
