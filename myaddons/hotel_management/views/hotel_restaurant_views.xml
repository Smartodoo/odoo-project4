<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============ CATÉGORIES ============ -->
    <record id="view_hotel_rest_category_tree" model="ir.ui.view">
        <field name="name">hotel.restaurant.category.tree</field>
        <field name="model">hotel.restaurant.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_hotel_rest_category" model="ir.actions.act_window">
        <field name="name">Catégories restaurant</field>
        <field name="res_model">hotel.restaurant.category</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- ============ ARTICLES (CARTE) ============ -->
    <record id="view_hotel_rest_item_tree" model="ir.ui.view">
        <field name="name">hotel.restaurant.item.tree</field>
        <field name="model">hotel.restaurant.item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="available" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_rest_item_kanban" model="ir.ui.view">
        <field name="name">hotel.restaurant.item.kanban</field>
        <field name="model">hotel.restaurant.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="available"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_hotel_item_card">
                            <div class="o_kanban_image me-2" t-if="record.image.raw_value">
                                <img t-att-src="kanban_image('hotel.restaurant.item', 'image', record.id.raw_value)"/>
                            </div>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="category_id"/></div>
                                <div>
                                    <field name="price" widget="monetary"/>
                                    <span t-if="!record.available.raw_value" class="badge text-bg-secondary ms-1">Indispo</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_rest_item_form" model="ir.ui.view">
        <field name="name">hotel.restaurant.item.form</field>
        <field name="model">hotel.restaurant.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : Couscous royal"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="available" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_rest_item_search" model="ir.ui.view">
        <field name="name">hotel.restaurant.item.search</field>
        <field name="model">hotel.restaurant.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="available" string="Disponibles" domain="[('available', '=', True)]"/>
                <filter name="unavailable" string="Indisponibles" domain="[('available', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_category" string="Catégorie" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_rest_item" model="ir.actions.act_window">
        <field name="name">Carte / Articles</field>
        <field name="res_model">hotel.restaurant.item</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_hotel_rest_item_search"/>
    </record>

    <!-- ============ COMMANDES ============ -->
    <record id="view_hotel_rest_order_form" model="ir.ui.view">
        <field name="name">hotel.restaurant.order.form</field>
        <field name="model">hotel.restaurant.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_serve" string="Marquer servie" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_invoice" string="Facturée" type="object"
                            invisible="state != 'served'"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state in ('invoiced', 'cancel')"/>
                    <button name="action_draft" string="Brouillon" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,served,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="order_date"/>
                        </group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="room_id"/>
                            <field name="charge_to_room"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Articles" name="items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="item_id"/>
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hotel_rest_order_tree" model="ir.ui.view">
        <field name="name">hotel.restaurant.order.tree</field>
        <field name="model">hotel.restaurant.order</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancel'" decoration-success="state == 'invoiced'">
                <field name="name"/>
                <field name="order_date"/>
                <field name="partner_id"/>
                <field name="reservation_id"/>
                <field name="room_id"/>
                <field name="charge_to_room"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'invoiced'"
                       decoration-muted="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_rest_order_search" model="ir.ui.view">
        <field name="name">hotel.restaurant.order.search</field>
        <field name="model">hotel.restaurant.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reservation_id"/>
                <field name="room_id"/>
                <filter name="draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmées" domain="[('state', '=', 'confirmed')]"/>
                <filter name="to_room" string="Sur le séjour" domain="[('charge_to_room', '=', True)]"/>
                <separator/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('order_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_reservation" string="Séjour" context="{'group_by': 'reservation_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_rest_order" model="ir.actions.act_window">
        <field name="name">Commandes restaurant</field>
        <field name="res_model">hotel.restaurant.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hotel_rest_order_search"/>
    </record>
</odoo>
