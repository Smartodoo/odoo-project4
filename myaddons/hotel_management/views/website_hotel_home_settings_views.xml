<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Personnalisation du bloc « vitrine » de la page d'accueil -->
    <record id="view_website_hotel_home_form" model="ir.ui.view">
        <field name="name">website.hotel.home.form</field>
        <field name="model">website</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Page d'accueil du site">
                <sheet>
                    <div class="oe_title">
                        <h1>Page d'accueil du site</h1>
                        <p class="text-muted">
                            Grand bloc photo affiché juste sous le bandeau de la page d'accueil.
                            Sans photo, une illustration de l'auberge est affichée.
                        </p>
                    </div>
                    <group>
                        <group string="Photo">
                            <field name="hotel_home_image" widget="image" nolabel="1" colspan="2"
                                   options="{'size': [480, 300]}"/>
                            <div class="text-muted" colspan="2">
                                Format paysage conseillé : 1600 × 1000 px ou plus
                                (façade, salon, terrasse, vue…).
                            </div>
                        </group>
                        <group string="Textes">
                            <field name="hotel_home_kicker"/>
                            <field name="hotel_home_title"/>
                            <field name="hotel_home_text"/>
                            <field name="hotel_home_badge"/>
                        </group>
                    </group>
                    <separator string="Galerie de la section « Notre engagement »"/>
                    <p class="text-muted">
                        Trois photos de l'auberge (accueil, salon, terrasse, cuisine, détails déco…).
                        Sans photo, la galerie affiche les photos des chambres.
                    </p>
                    <group col="3">
                        <field name="hotel_gallery_image_1" widget="image" options="{'size': [260, 260]}"/>
                        <field name="hotel_gallery_image_2" widget="image" options="{'size': [200, 200]}"/>
                        <field name="hotel_gallery_image_3" widget="image" options="{'size': [200, 200]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_website_home" model="ir.actions.act_window">
        <field name="name">Page d'accueil du site</field>
        <field name="res_model">website</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_website_hotel_home_form"/>
        <field name="res_id" ref="base.default_website"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_hotel_website_home" name="Page d'accueil du site"
              parent="menu_hotel_config" action="action_hotel_website_home"
              sequence="60" groups="website.group_website_designer"/>
</odoo>
