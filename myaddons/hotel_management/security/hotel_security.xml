<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_hotel" model="ir.module.category">
        <field name="name">Hôtel</field>
        <field name="description">Gestion hôtelière</field>
        <field name="sequence">20</field>
    </record>

        <record id="privilege_module_category_hotel" model="res.groups.privilege">
            <field name="name">Hôtel</field>
            <field name="category_id" ref="module_category_hotel"/>
        </record>

    <record id="group_hotel_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="privilege_id" ref="privilege_module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="privilege_module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
