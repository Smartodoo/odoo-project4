<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_hotel" model="ir.module.category">
        <field name="name">Hôtel</field>
        <field name="description">Gestion hôtelière</field>
        <field name="sequence">20</field>
    </record>

        <record id="privilege_module_category_hotel" model="res.groups.privilege">
            <field name="name">Hôtel</field>
            <field name="category_id" ref="module_category_hotel"/>
        </record>

    <!-- Profils (cahier des charges §17) : Agent de ménage < Réception < Responsable -->
    <record id="group_hotel_housekeeping" model="res.groups">
        <field name="name">Agent de ménage</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="privilege_module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Voit les chambres et le ménage ; signale les réparations.</field>
    </record>

    <record id="group_hotel_user" model="res.groups">
        <field name="name">Réception</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_module_category_hotel"/>
        <!-- Facturation : la réception édite et imprime la facture au départ -->
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_hotel_housekeeping')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Réservations, check-in / check-out, factures et encaissements.</field>
    </record>

    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_module_category_hotel"/>
        <field name="comment">Tout l'accès : configuration, statistiques, contrôle du ménage.</field>
        <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
