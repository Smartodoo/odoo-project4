<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Le portail ne voit que ses propres réservations -->
        <record id="hotel_reservation_portal_rule" model="ir.rule">
            <field name="name">Réservations : portail (les siennes)</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hotel_reservation_line_portal_rule" model="ir.rule">
            <field name="name">Lignes de réservation : portail (les siennes)</field>
            <field name="model_id" ref="model_hotel_reservation_line"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('reservation_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
