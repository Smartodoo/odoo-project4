<odoo>

    <!-- Héritage de la vue du formulaire du produit -->
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Ajouter le champ 'code' dans la vue -->
            <xpath expr="//div[@name='pricing']" position="after">
                <label for="prix_de_gros"/>
                <div name="pricing2" class="o_row">
                    <field name="prix_de_gros" class="oe_inline" widget='monetary'
                           options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="margin_percentage"/>
                <div name="pricing3" class="o_row">
                    <field name="margin_percentage" class="oe_inline" widget="percentage"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>