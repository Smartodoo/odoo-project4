<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================= SESSIONS DE CAISSE (cahier des charges §9) ================= -->
    <record id="view_caisse_session_form" model="ir.ui.view">
        <field name="name">caisse.session.form</field>
        <field name="model">caisse.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Saisie rapide d'un mouvement (caisse ouverte) -->
                    <button name="action_new_in" string="Entrée" type="object" icon="add_circle"
                            class="btn-success" invisible="state != 'open' or not id"/>
                    <button name="action_new_out" string="Sortie" type="object" icon="remove_circle"
                            invisible="state != 'open' or not id"/>
                    <button name="action_new_transfer" string="Transfert" type="object" icon="swap_horiz"
                            invisible="state != 'open' or not id"/>
                    <button name="action_close" string="Fermer la caisse" type="object"
                            class="btn-primary" invisible="state != 'open' or not id"
                            confirm="Fermer la caisse ? Vérifiez d'abord le montant des espèces comptées."/>
                    <button name="action_reopen" string="Rouvrir" type="object"
                            invisible="state != 'closed'"
                            groups="caisse.group_caisse_manager"/>
                    <button name="%(caisse.action_report_caisse_session)d"
                            string="État de caisse" type="action" icon="print" invisible="not id"/>
                    <field name="state" widget="statusbar" class="o_hotel_statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal" type="object"
                                class="oe_stat_button" icon="list_alt" invisible="not id">
                            <field name="journal_count" widget="statinfo" string="Journal"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <!-- Résumé de la caisse : fond + encaissé - dépensé = solde théorique -->
                    <div class="o_caisse_summary" invisible="not id">
                        <div class="o_caisse_sum_item">
                            <span class="o_caisse_sum_label">Fond de caisse</span>
                            <field name="opening_balance" widget="monetary" readonly="1" class="o_caisse_sum_value"/>
                        </div>
                        <div class="o_caisse_sum_op">+</div>
                        <div class="o_caisse_sum_item o_caisse_sum_in">
                            <span class="o_caisse_sum_label">Encaissé</span>
                            <field name="total_collected" widget="monetary" class="o_caisse_sum_value"/>
                            <span class="o_caisse_sum_hint">
                                clients <field name="total_cash_payments" widget="monetary" class="oe_inline"/>
                                · entrées <field name="total_in" widget="monetary" class="oe_inline"/>
                            </span>
                        </div>
                        <div class="o_caisse_sum_op">−</div>
                        <div class="o_caisse_sum_item o_caisse_sum_out">
                            <span class="o_caisse_sum_label">Dépensé</span>
                            <field name="total_spent" widget="monetary" class="o_caisse_sum_value"/>
                            <span class="o_caisse_sum_hint">
                                notes de frais <field name="total_expense_notes" widget="monetary" class="oe_inline"/>
                                · achats <field name="total_supplier_payments" widget="monetary" class="oe_inline"/>
                                · sorties <field name="total_out" widget="monetary" class="oe_inline"/>
                            </span>
                        </div>
                        <div class="o_caisse_sum_op">=</div>
                        <div class="o_caisse_sum_item o_caisse_sum_theo">
                            <span class="o_caisse_sum_label">Solde théorique</span>
                            <field name="theoretical_balance" widget="monetary" class="o_caisse_sum_value"/>
                            <span class="o_caisse_sum_hint">espèces qui doivent être dans la caisse</span>
                        </div>
                        <div class="o_caisse_sum_item o_caisse_sum_gap" invisible="state != 'closed'">
                            <span class="o_caisse_sum_label">Écart (compté − théorique)</span>
                            <field name="difference" widget="monetary" class="o_caisse_sum_value"
                                   decoration-danger="difference &lt; 0" decoration-success="difference == 0"
                                   decoration-warning="difference &gt; 0"/>
                            <span class="o_caisse_sum_hint">
                                compté <field name="closing_balance" widget="monetary" class="oe_inline" readonly="1"/>
                            </span>
                        </div>
                    </div>
                    <group>
                        <group string="Session">
                            <field name="user_id" readonly="state != 'open'"/>
                            <field name="date_open"/>
                            <field name="date_close" invisible="not date_close"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Soldes">
                            <field name="opening_balance" widget="monetary" readonly="state != 'open'"/>
                            <field name="total_collected" widget="monetary"/>
                            <field name="total_spent" widget="monetary"/>
                            <field name="theoretical_balance" widget="monetary" class="fw-bold"/>
                            <field name="closing_balance" widget="monetary" readonly="state != 'open'"/>
                            <field name="difference" widget="monetary" invisible="state != 'closed'"
                                   decoration-danger="difference &lt; 0" decoration-success="difference == 0"
                                   decoration-warning="difference &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mouvements de caisse" name="moves">
                            <!-- Ajout uniquement par les boutons Entrée / Dépense /
                                 Sortie / Transfert : le type est imposé, jamais choisi. -->
                            <field name="move_ids" readonly="state != 'open'">
                                <list editable="bottom" create="0">
                                    <field name="date"/>
                                    <field name="move_type" readonly="1"/>
                                    <field name="reason"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="reference" optional="show"/>
                                    <field name="destination" optional="hide"
                                           invisible="move_type != 'transfer'"/>
                                    <field name="attachment" filename="attachment_name" optional="show"/>
                                    <field name="attachment_name" column_invisible="1"/>
                                    <field name="amount" widget="monetary" sum="Total"/>
                                    <field name="user_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Paiements clients en espèces" name="payments">
                            <field name="customer_payment_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="hotel_reservation_id"/>
                                    <field name="hotel_payment_kind"/>
                                    <field name="amount_company_currency_signed" string="Montant" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Achats fournisseurs" name="supplier_payments">
                            <field name="supplier_payment_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="partner_id" string="Fournisseur"/>
                                    <field name="memo"/>
                                    <field name="amount_company_currency_signed" string="Montant" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <div class="text-muted small">
                                Paiements fournisseurs en espèces de la société (bouton « Payer » d'une
                                facture fournisseur, journal Espèces) : l'argent sort de cette caisse.
                            </div>
                        </page>
                        <page string="Notes de frais" name="expense_notes">
                            <field name="expense_note_payment_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="memo" string="Note de frais"/>
                                    <field name="partner_id" string="Bénéficiaire"/>
                                    <field name="amount_company_currency_signed" string="Montant" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <div class="text-muted small">
                                Notes de frais payées en espèces (payées par la société, ou remboursées
                                à l'employé) : l'argent sort de cette caisse.
                            </div>
                        </page>
                        <page string="Paiements par mode" name="by_mode">
                            <group>
                                <group>
                                    <field name="total_cash_payments" widget="monetary" string="Espèces"/>
                                    <field name="amount_card" widget="monetary"/>
                                    <field name="amount_transfer" widget="monetary"/>
                                    <field name="amount_cheque" widget="monetary"/>
                                </group>
                            </group>
                            <div class="text-muted small">
                                Seules les espèces passent physiquement par la caisse ; les autres modes
                                sont affichés pour le contrôle (paiements de la période de la session).
                            </div>
                        </page>
                        <page string="Observations" name="note">
                            <field name="note" placeholder="Remarques, explication d'un écart…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_caisse_session_list" model="ir.ui.view">
        <field name="name">caisse.session.list</field>
        <field name="model">caisse.session</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'open'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="date_open"/>
                <field name="date_close"/>
                <field name="opening_balance" widget="monetary"/>
                <field name="theoretical_balance" widget="monetary"/>
                <field name="closing_balance" widget="monetary"/>
                <field name="difference" widget="monetary"
                       decoration-danger="difference &lt; 0"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_caisse_session_search" model="ir.ui.view">
        <field name="name">caisse.session.search</field>
        <field name="model">caisse.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="open" string="Ouvertes" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Fermées" domain="[('state', '=', 'closed')]"/>
                <filter name="date_open" string="Date d'ouverture" date="date_open"/>
                <filter name="mine" string="Mes caisses" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_user" string="Caissier" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mois" context="{'group_by': 'date_open:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_caisse_session_kanban" model="ir.ui.view">
        <field name="name">caisse.session.kanban</field>
        <field name="model">caisse.session</field>
        <field name="arch" type="xml">
            <kanban class="o_caisse_kanban" sample="1">
                <field name="state"/>
                <field name="currency_id"/>
                <field name="difference"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_caisse_card o_caisse_card_#{record.state.raw_value}">
                            <div class="d-flex justify-content-between align-items-start">
                                <field name="name" class="fw-bold fs-5"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'open'"
                                       decoration-muted="state == 'closed'"/>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-muted small mt-1">
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <field name="date_open"/>
                            </div>
                            <div class="o_caisse_figures mt-2">
                                <div>
                                    <span class="o_caisse_label">Fond de caisse</span>
                                    <field name="opening_balance" widget="monetary"/>
                                </div>
                                <div>
                                    <span class="o_caisse_label">Encaissé</span>
                                    <field name="total_collected" widget="monetary" class="text-success"/>
                                </div>
                                <div>
                                    <span class="o_caisse_label">Dépensé</span>
                                    <field name="total_spent" widget="monetary" class="text-danger"/>
                                </div>
                                <div>
                                    <span class="o_caisse_label">Solde théorique</span>
                                    <field name="theoretical_balance" widget="monetary" class="fw-bold"/>
                                </div>
                            </div>
                            <div t-if="record.state.raw_value == 'closed'"
                                 t-attf-class="o_caisse_gap mt-2 #{record.difference.raw_value &lt; 0 ? 'text-danger' : (record.difference.raw_value &gt; 0 ? 'text-warning' : 'text-success')}">
                                Écart : <field name="difference" widget="monetary"/>
                            </div>
                            <footer t-if="record.state.raw_value == 'open'" class="mt-2">
                                <button name="action_close" type="object" class="btn btn-sm btn-primary"
                                        confirm="Fermer la caisse ? Vérifiez d'abord le montant des espèces comptées.">
                                    Fermer la caisse
                                </button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caisse_session_graph" model="ir.ui.view">
        <field name="name">caisse.session.graph</field>
        <field name="model">caisse.session</field>
        <field name="arch" type="xml">
            <graph string="Fonds de caisse" type="bar" sample="1">
                <field name="date_open" interval="day"/>
                <field name="opening_balance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_caisse_session" model="ir.actions.act_window">
        <field name="name">Sessions de caisse</field>
        <field name="res_model">caisse.session</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_caisse_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ouvrez la caisse</p>
            <p>Saisissez le fond de caisse à l'ouverture ; les paiements clients en espèces
               s'y rattachent automatiquement. À la fermeture, comptez les espèces : l'écart est calculé.</p>
        </field>
    </record>

    <record id="action_caisse_current" model="ir.actions.server">
        <field name="name">Caisse du jour</field>
        <field name="model_id" ref="model_caisse_session"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_current()</field>
    </record>

    <!-- Journal de caisse : tous les mouvements -->
    <record id="view_caisse_move_list" model="ir.ui.view">
        <field name="name">caisse.move.list</field>
        <field name="model">caisse.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="session_id"/>
                <field name="move_type" column_invisible="context.get('default_move_type')"/>
                <field name="reason"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="signed_amount" string="Montant" widget="monetary" sum="Total"/>
                <field name="user_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_caisse_move_form" model="ir.ui.view">
        <field name="name">caisse.move.form</field>
        <field name="model">caisse.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert" invisible="session_id">
                        Aucune caisse n'est ouverte : ouvrez d'abord la caisse du jour
                        (menu Caisse du jour) pour pouvoir enregistrer ce mouvement.
                    </div>
                    <group>
                        <group>
                            <field name="session_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <!-- Type imposé par le menu (Entrées, Dépenses, Sorties,
                                 Transferts) : il n'est jamais choisi sur la fiche. -->
                            <field name="move_type" invisible="1"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="partner_id" string="Bénéficiaire / tiers"
                                   required="move_type == 'out'"/>
                            <field name="reference"/>
                            <field name="destination" invisible="move_type != 'transfer'"/>
                            <field name="attachment" filename="attachment_name"/>
                            <field name="attachment_name" invisible="1"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caisse_move_search" model="ir.ui.view">
        <field name="name">caisse.move.search</field>
        <field name="model">caisse.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="reason"/>
                <field name="session_id"/>
                <field name="partner_id"/>
                <filter name="in" string="Entrées" domain="[('move_type', '=', 'in')]"/>
                <filter name="out" string="Sorties" domain="[('move_type', '=', 'out')]"/>
                <filter name="expense" string="Dépenses" domain="[('move_type', '=', 'expense')]"/>
                <filter name="transfer" string="Transferts" domain="[('move_type', '=', 'transfer')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'move_type'}"/>
                    <filter name="group_session" string="Caisse" context="{'group_by': 'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_caisse_move_kanban" model="ir.ui.view">
        <field name="name">caisse.move.kanban</field>
        <field name="model">caisse.move</field>
        <field name="arch" type="xml">
            <kanban class="o_caisse_kanban" sample="1" quick_create="0">
                <field name="move_type"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_caisse_move o_caisse_move_#{record.move_type.raw_value}">
                            <div class="d-flex justify-content-between">
                                <field name="reason" class="fw-bold"/>
                                <field name="amount" widget="monetary" class="fw-bold"/>
                            </div>
                            <div class="text-muted small">
                                <field name="date"/> · <field name="session_id"/>
                            </div>
                            <div class="small" t-if="record.partner_id.raw_value">
                                <i class="oi me-1" data-icon="person" title="Tiers"/><field name="partner_id"/>
                            </div>
                            <div class="small text-muted" t-if="record.reference.raw_value">
                                Pièce : <field name="reference"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caisse_move_pivot" model="ir.ui.view">
        <field name="name">caisse.move.pivot</field>
        <field name="model">caisse.move</field>
        <field name="arch" type="xml">
            <pivot string="Mouvements de caisse" sample="1">
                <field name="move_type" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_caisse_move_graph" model="ir.ui.view">
        <field name="name">caisse.move.graph</field>
        <field name="model">caisse.move</field>
        <field name="arch" type="xml">
            <graph string="Mouvements de caisse" type="bar" stacked="1" sample="1">
                <field name="date" interval="day"/>
                <field name="move_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Saisie rapide d'un mouvement depuis la caisse (fenêtre) -->
    <record id="view_caisse_move_form_quick" model="ir.ui.view">
        <field name="name">caisse.move.form.quick</field>
        <field name="model">caisse.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form>
                <field name="session_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="move_type" invisible="1"/>
                        <field name="amount" widget="monetary" class="fs-4 fw-bold"/>
                        <field name="reason" placeholder="ex : achat produits ménage, appoint monnaie…"/>
                    </group>
                    <group>
                        <field name="partner_id" string="Bénéficiaire / tiers"
                               required="move_type == 'out'"
                               placeholder="À qui l'argent est remis (obligatoire pour une sortie)"/>
                        <field name="reference" placeholder="N° de reçu / facture"/>
                        <field name="destination" invisible="move_type != 'transfer'"
                               placeholder="Banque, coffre…"/>
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Enregistrer" special="save" class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================= JOURNAL DE CAISSE UNIFIÉ ================= -->
    <record id="view_caisse_journal_list" model="ir.ui.view">
        <field name="name">caisse.journal.list</field>
        <field name="model">caisse.journal</field>
        <field name="arch" type="xml">
            <list string="Journal de caisse" create="0" edit="0" delete="0"
                  decoration-success="category == 'in'"
                  decoration-danger="category == 'expense'"
                  decoration-warning="category == 'out'">
                <!-- Boutons « Nouveau » selon le menu ouvert (Entrées / Dépenses / Sorties) -->
                <header>
                    <button name="action_caisse_new_in" type="object" string="Nouvelle entrée"
                            class="btn-primary" display="always"
                            invisible="context.get('caisse_menu') != 'in'"/>
                    <button name="action_caisse_new_out" type="object" string="Nouvelle sortie"
                            class="btn-primary" display="always"
                            invisible="context.get('caisse_menu') != 'out'"/>
                    <button name="action_caisse_new_transfer" type="object" string="Nouveau transfert"
                            display="always"
                            invisible="context.get('caisse_menu') != 'out'"/>
                </header>
                <field name="category" column_invisible="1"/>
                <field name="date"/>
                <field name="session_id" optional="show"/>
                <field name="kind" widget="badge"
                       decoration-success="category == 'in'"
                       decoration-danger="category == 'expense'"
                       decoration-warning="category == 'out'"/>
                <field name="label"/>
                <field name="partner_id" optional="show"/>
                <field name="reservation_id" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="has_attachment" string="Justif." optional="show"/>
                <field name="amount_in" widget="monetary" sum="Total entrées"/>
                <field name="amount_out" widget="monetary" sum="Total sorties"/>
                <field name="amount" widget="monetary" sum="Solde" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_open_source" type="object" icon="open_in_new"
                        title="Ouvrir l'opération"/>
            </list>
        </field>
    </record>

    <record id="view_caisse_journal_search" model="ir.ui.view">
        <field name="name">caisse.journal.search</field>
        <field name="model">caisse.journal</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="partner_id"/>
                <field name="session_id"/>
                <field name="reservation_id"/>
                <filter name="ins" string="Entrées" domain="[('category', '=', 'in')]"/>
                <filter name="expenses" string="Dépenses" domain="[('category', '=', 'expense')]"/>
                <filter name="outs" string="Sorties" domain="[('category', '=', 'out')]"/>
                <separator/>
                <filter name="expense_notes" string="Notes de frais"
                        domain="[('kind', 'in', ('expense_note', 'expense'))]"/>
                <filter name="purchases" string="Achats fournisseurs"
                        domain="[('kind', 'in', ('purchase', 'purchase_refund'))]"/>
                <filter name="no_proof" string="Sans justificatif"
                        domain="[('move_id', '!=', False), ('kind', '!=', 'in'), ('has_attachment', '=', False)]"/>
                <separator/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('day', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="day" string="Date" date="day"/>
                <filter name="open_session" string="Caisse ouverte"
                        domain="[('session_id.state', '=', 'open')]"/>
                <group>
                    <filter name="group_day" string="Jour" context="{'group_by': 'day:day'}"/>
                    <filter name="group_category" string="Catégorie" context="{'group_by': 'category'}"/>
                    <filter name="group_kind" string="Opération" context="{'group_by': 'kind'}"/>
                    <filter name="group_session" string="Caisse" context="{'group_by': 'session_id'}"/>
                    <filter name="group_user" string="Saisi par" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_caisse_journal_pivot" model="ir.ui.view">
        <field name="name">caisse.journal.pivot</field>
        <field name="model">caisse.journal</field>
        <field name="arch" type="xml">
            <pivot string="Journal de caisse" sample="1">
                <field name="kind" type="row"/>
                <field name="day" interval="month" type="col"/>
                <field name="amount_in" type="measure"/>
                <field name="amount_out" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_caisse_journal_graph" model="ir.ui.view">
        <field name="name">caisse.journal.graph</field>
        <field name="model">caisse.journal</field>
        <field name="arch" type="xml">
            <graph string="Entrées et sorties de caisse" type="bar" stacked="1" sample="1">
                <field name="day" interval="day"/>
                <field name="kind"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_caisse_journal" model="ir.actions.act_window">
        <field name="name">Journal de caisse</field>
        <field name="res_model">caisse.journal</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_caisse_journal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune opération de caisse</p>
            <p>Tout l'argent qui entre dans la caisse ou en sort : paiements clients en espèces,
               entrées, sorties, dépenses et transferts.</p>
        </field>
    </record>


    <!-- Menus Entrées / Dépenses (notes de frais, achats) / Sorties -->
    <record id="action_caisse_entrees" model="ir.actions.act_window">
        <field name="name">Entrées</field>
        <field name="res_model">caisse.journal</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_caisse_journal_search"/>
        <field name="domain">[('category', '=', 'in')]</field>
        <field name="context">{'caisse_menu': 'in'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune entrée d'argent</p>
            <p>Paiements des réservations en espèces, et entrées saisies à la main (par exemple l'argent déjà présent dans la caisse au démarrage).</p>
        </field>
    </record>
    <record id="action_caisse_depenses" model="ir.actions.act_window">
        <field name="name">Dépenses</field>
        <field name="res_model">caisse.journal</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_caisse_journal_search"/>
        <field name="domain">[('category', '=', 'expense')]</field>
        <field name="context">{'caisse_menu': 'expense'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune dépense</p>
            <p>Notes de frais et achats payés en espèces : chaque paiement validé apparaît ici.</p>
        </field>
    </record>
    <record id="action_caisse_notes_frais" model="ir.actions.act_window">
        <field name="name">Notes de frais</field>
        <field name="res_model">caisse.journal</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_caisse_journal_search"/>
        <field name="domain">[('kind', 'in', ('expense_note', 'expense'))]</field>
        <field name="context">{'caisse_menu': 'expense_note'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune note de frais payée en espèces</p>
            <p>Les notes de frais se créent dans l'application Notes de frais.
               Payée par la société en espèces (journal Espèces), une note sort de la caisse
               dès sa validation ; un remboursement d'employé payé en espèces aussi.</p>
        </field>
    </record>
    <record id="action_caisse_achats" model="ir.actions.act_window">
        <field name="name">Achats</field>
        <field name="res_model">caisse.journal</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_caisse_journal_search"/>
        <field name="domain">[('kind', 'in', ('purchase', 'purchase_refund'))]</field>
        <field name="context">{'caisse_menu': 'purchase'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun achat payé en espèces</p>
            <p>Les achats se créent dans l'application Achats. Quand leur facture fournisseur
               est payée en espèces (bouton « Payer », journal Espèces), le paiement sort de
               la caisse et apparaît ici.</p>
        </field>
    </record>
    <record id="action_caisse_sorties" model="ir.actions.act_window">
        <field name="name">Sorties</field>
        <field name="res_model">caisse.journal</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_caisse_journal_search"/>
        <field name="domain">[('category', '=', 'out')]</field>
        <field name="context">{'caisse_menu': 'out'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune sortie d'argent</p>
            <p>Remboursements des clients, argent remis à quelqu'un (avance, retrait…) et transferts vers la banque ou le coffre.</p>
        </field>
    </record>

    <!-- ================= TABLEAU DE BORD ================= -->
    <record id="action_caisse_dashboard" model="ir.actions.client">
        <field name="name">Tableau de bord caisse</field>
        <field name="tag">caisse_dashboard</field>
    </record>

    <!-- Application « Caisse » -->
    <menuitem id="menu_caisse_root" name="Caisse"
              web_icon="caisse,static/description/icon.png"
              action="action_caisse_dashboard"
              sequence="25" groups="caisse.group_caisse_user"/>
    <menuitem id="menu_caisse_dashboard" name="Tableau de bord"
              parent="menu_caisse_root" action="action_caisse_dashboard" sequence="0"/>
    <menuitem id="menu_caisse_current" name="Caisse du jour"
              parent="menu_caisse_root" action="action_caisse_current" sequence="1"/>
    <menuitem id="menu_caisse_sessions" name="Sessions de caisse"
              parent="menu_caisse_root" action="action_caisse_session" sequence="10"/>
    <menuitem id="menu_caisse_journal" name="Journal de caisse"
              parent="menu_caisse_root" action="action_caisse_journal" sequence="15"/>
    <menuitem id="menu_caisse_entrees" name="Entrées"
              parent="menu_caisse_root" action="action_caisse_entrees" sequence="5"/>
    <menuitem id="menu_caisse_depenses" name="Dépenses"
              parent="menu_caisse_root" sequence="6"/>
    <menuitem id="menu_caisse_depenses_all" name="Toutes les dépenses"
              parent="menu_caisse_depenses" action="action_caisse_depenses" sequence="1"/>
    <menuitem id="menu_caisse_notes_frais" name="Notes de frais"
              parent="menu_caisse_depenses" action="action_caisse_notes_frais" sequence="2"/>
    <menuitem id="menu_caisse_achats" name="Achats"
              parent="menu_caisse_depenses" action="action_caisse_achats" sequence="3"/>
    <menuitem id="menu_caisse_sorties" name="Sorties"
              parent="menu_caisse_root" action="action_caisse_sorties" sequence="7"/>

    <!-- Fenêtre « Encaisser » de la réservation : caisse utilisée -->
    <record id="view_hotel_reservation_payment_wizard_form_caisse" model="ir.ui.view">
        <field name="name">hotel.reservation.payment.wizard.form.caisse</field>
        <field name="model">hotel.reservation.payment.wizard</field>
        <field name="inherit_id" ref="hotel_management.view_hotel_reservation_payment_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cheque_reference']" position="after">
                <field name="caisse_session_id" invisible="payment_mode != 'cash'" readonly="1"
                       placeholder="Aucune caisse ouverte"/>
            </xpath>
            <xpath expr="//footer" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="payment_mode != 'cash' or caisse_session_id">
                    Aucune caisse n'est ouverte : ouvrez la caisse (application Caisse &gt; Caisse du jour)
                    avant d'encaisser en espèces.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Paiement : caisse de rattachement -->
    <record id="view_account_payment_form_caisse" model="ir.ui.view">
        <field name="name">account.payment.form.caisse</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="hotel_management.view_account_payment_form_hotel"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hotel_payment_mode']" position="after">
                <field name="caisse_session_id" invisible="not caisse_session_id"/>
            </xpath>
        </field>
    </record>
</odoo>
