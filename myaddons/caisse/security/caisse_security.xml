<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_caisse" model="ir.module.category">
        <field name="name">Caisse</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_caisse" model="res.groups.privilege">
        <field name="name">Caisse</field>
        <field name="category_id" ref="module_category_caisse"/>
    </record>

    <record id="group_caisse_user" model="res.groups">
        <field name="name">Caissier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_caisse"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ouvre et ferme la caisse, saisit les mouvements.</field>
    </record>

    <record id="group_caisse_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_caisse"/>
        <field name="implied_ids" eval="[(4, ref('group_caisse_user'))]"/>
        <field name="comment">Peut en plus rouvrir une caisse fermée et supprimer une session vide.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- La réception de l'auberge encaisse : elle est caissière -->
    <record id="hotel_management.group_hotel_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_caisse_user'))]"/>
    </record>
    <record id="hotel_management.group_hotel_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_caisse_manager'))]"/>
    </record>
</odoo>
