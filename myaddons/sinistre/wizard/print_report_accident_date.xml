<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sinistre_print_wizard_form" model="ir.ui.view">
        <field name="name">sinistre.print.wizard.form</field>
        <field name="model">sinistre.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer Sinistres par Mois">
                <group>
                    <field name="month"/>
                    <field name="year"/>
                </group>
                <footer>
                    <button name="print_report" string="Imprimer" type="object" class="oe_highlight"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sinistre_print_wizard" model="ir.actions.act_window">
        <field name="name">Imprimer par mois</field>
        <field name="res_model">sinistre.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
