<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_communication_list" model="ir.actions.report">
        <field name="name">Liste des Communications</field>
        <field name="model">commercial.communication.list.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">commercial.report_communication_list_template</field>
        <field name="report_file">commercial.report_communication_list_template</field>
        <field name="print_report_name">'Communications - %s' % object.partner_id.name</field>
        <field name="paperformat_id" ref="paperformat_commercial_portrait"/>
    </record>

    <template id="report_communication_list_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="commercial.external_layout_commercial">
                    <t t-set="partner" t-value="doc.partner_id"/>

                    <div class="page" style="font-family: 'Times New Roman', Times, serif; font-size: 12px;">

                        <!-- Title -->
                        <div style="text-align: center; margin-bottom: 5px;">
                            <span style="font-size: 18px; color: #0000CC;">
                                Liste des Communications
                            </span>
                        </div>

                        <!-- Client info -->
                        <div style="margin-bottom: 15px;">
                            <strong>Client :</strong> <t t-esc="partner.name or ''"/>
                            <span style="margin-left: 30px;">
                                <strong>Tel :</strong> <t t-esc="partner.phone or partner.mobile or ''"/>
                            </span>
                            <span style="float: right;">
                                <t t-esc="time.strftime('%d/%m/%Y')"/>
                            </span>
                        </div>

                        <!-- Communications table -->
                        <table style="width: 100%; border-collapse: collapse; border: 2px solid #000;">
                            <thead>
                                <tr style="background-color: #e9e9e9;">
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 15%;">Date</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%;">Type</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 25%;">Motif</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 25%;">Résultat</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 20%;">Note</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 15%;">Commercial</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.communication_ids" t-as="comm">
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                            <t t-esc="comm.date_heure" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                            <t t-if="comm.type_communication == 'entrant'">Entrant</t>
                                            <t t-if="comm.type_communication == 'sortant'">Sortant</t>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 5px;">
                                            <t t-esc="dict(comm._fields['motif'].selection).get(comm.motif, '')"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 5px;">
                                            <t t-esc="dict(comm._fields['resultat'].selection).get(comm.resultat, '')"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 5px;">
                                            <t t-esc="comm.note or ''"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                            <t t-esc="comm.commercial_id.name or ''"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not doc.communication_ids">
                                    <tr>
                                        <td colspan="6" style="border: 1px solid #000; padding: 15px; text-align: center; color: #999;">
                                            Aucune communication
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Total -->
                        <div style="margin-top: 10px; text-align: right;">
                            <strong>Total : <t t-esc="len(doc.communication_ids)"/> communication(s)</strong>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
