<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action : Décharge Remboursement -->
    <record id="action_report_decharge_remboursement" model="ir.actions.report">
        <field name="name">Décharge Remboursement</field>
        <field name="model">commercial.remboursement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">commercial.decharge_remboursement_template</field>
        <field name="report_file">commercial.decharge_remboursement_template</field>
        <field name="print_report_name">'Décharge Remboursement - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_commercial_portrait"/>
    </record>

    <!-- QWeb Template : Décharge Remboursement -->
    <template id="decharge_remboursement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="commercial.external_layout_commercial">
                    <t t-set="user" t-value="doc.env.user"/>
                    <t t-set="user_civilite" t-value="'Mme' if user.genre == 'femme' else 'M.'"/>
                    <t t-set="client" t-value="doc.client_id"/>
                    <t t-set="client_civilite" t-value="'Mme' if client.genre == 'femme' else 'M.'"/>
                    <t t-set="id_doc" t-value="doc.get_client_id_document()"/>
                    <div class="page" style="font-family: 'Times New Roman', Times, serif; font-size: 24px; padding: 70px 80px; position: relative; min-height: 900px;">

                        <!-- Date en haut à droite -->
                        <p style="text-align: right; margin-bottom: 40px; font-size: 24px;">
                            Tizi Ouzou le
                            <t t-if="doc.date"><t t-esc="doc.date" t-options='{"widget": "date"}'/></t>
                            <t t-else="">..../.../......</t>
                        </p>

                        <!-- Titre -->
                        <h2 style="text-align: center; font-weight: bold; margin-bottom: 5px; color: #003366; font-size: 32px;">
                            DECHARGE
                        </h2>
                        <h3 style="text-align: center; font-weight: bold; margin-bottom: 40px; color: #003366; font-size: 28px;">
                            DE REMBOURSEMENT
                        </h3>

                        <!-- Corps en un seul paragraphe continu -->
                        <p style="text-align: justify; line-height: 2.4; font-size: 24px;">
                            Je soussigné<t t-if="client.genre == 'femme'">e</t>
                            <strong> <t t-esc="client_civilite"/> <t t-esc="client.name or '...'"/></strong>

                            Né<t t-if="client.genre == 'femme'">e</t> le
                            <t t-if="client.date_naissance"><strong><t t-esc="client.date_naissance" t-options='{"widget": "date"}'/></strong></t>
                            <t t-else="">..../.../......</t>

                            <t t-if="id_doc">
                                Titulaire de
                                <strong><t t-esc="doc.get_type_document_label(id_doc)"/></strong>
                                N° : <strong><t t-esc="id_doc.numero_document or '...'"/></strong>
                                Délivré le
                                <t t-if="id_doc.date_delivrance"><strong><t t-esc="id_doc.date_delivrance" t-options='{"widget": "date"}'/></strong></t>
                                <t t-else="">..../.../......</t>
                                Par <strong><t t-esc="id_doc.delivre_par or '...'"/></strong>
                            </t>

                            avoir reçu le
                            <t t-if="doc.date"><strong><t t-esc="doc.date" t-options='{"widget": "date"}'/></strong></t>
                            <t t-else="">..../.../......</t>

                            la somme de
                            <strong><t t-esc="'{:,.2f}'.format(doc.montant_rembourse).replace(',', ' ')"/> DA</strong>
                            la Part de
                            <strong><t t-esc="user_civilite"/> <t t-esc="user.name"/></strong>
                        </p>

                        <p style="text-align: justify; line-height: 2.4; font-size: 24px;">
                            Déjà versé le
                            <t t-if="doc.versement_id.date"><strong><t t-esc="doc.versement_id.date" t-options='{"widget": "date"}'/></strong></t>
                            <t t-else="">..../.../......</t>
                        </p>

                        <!-- Signatures -->
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 0 60px; font-size: 24px;">
                            <div style="float: left; width: 50%; text-align: center;">
                                <p style="margin-bottom: 0;"><strong>D'une part</strong></p>
                                <p style="margin-top: 0;"><t t-esc="user_civilite"/> <t t-esc="user.name"/></p>
                            </div>
                            <div style="float: right; width: 50%; text-align: center;">
                                <p style="margin-bottom: 0;"><strong>D'autre part</strong></p>
                                <p style="margin-top: 0;"><t t-esc="client_civilite"/> <t t-esc="client.name or '...'"/></p>
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
