<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_commercial_location" model="ir.sequence">
        <field name="name">Contrat Location</field>
        <field name="code">commercial.location</field>
        <field name="prefix">LOC/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_commercial_versement_location" model="ir.sequence">
        <field name="name">Versement Location</field>
        <field name="code">commercial.versement.location</field>
        <field name="prefix">VLOC/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
