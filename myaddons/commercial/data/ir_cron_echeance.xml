<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_cron_check_upcoming_echeances" model="ir.cron">
            <field name="name">Notification Échéances Paiement</field>
            <field name="model_id" ref="commercial.model_commercial_echeance"/>
            <field name="state">code</field>
            <field name="code">model.check_upcoming_echeances()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="nextcall" eval="(datetime.now())"/>
        </record>
    </data>
</odoo>
