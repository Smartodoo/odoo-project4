<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="commercial_etage_view_tree" model="ir.ui.view">
        <field name="name">commercial.etage.tree</field>
        <field name="model">commercial.etage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="niveau"/>
                <field name="etiquette"/>
                <field name="bloc_id"/>
                <field name="projet_id"/>
                <field name="type_etage"/>
                <field name="nombre_logements"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="commercial_etage_view_form" model="ir.ui.view">
        <field name="name">commercial.etage.form</field>
        <field name="model">commercial.etage</field>
        <field name="arch" type="xml">
            <form string="Étage">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_categories"
                                icon="fa-th-list">
                            <field name="categorie_count" widget="statinfo" string="Catégories"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="niveau"/>
                            <field name="etiquette"/>
                            <field name="type_etage"/>
                        </group>
                        <group>
                            <field name="bloc_id"/>
                            <field name="projet_id"/>
                            <field name="nombre_logements"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="commercial_etage_action" model="ir.actions.act_window">
        <field name="name">Étages</field>
        <field name="res_model">commercial.etage</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
