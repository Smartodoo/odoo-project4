<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Intéressé - Tree View -->
    <record id="commercial_client_interesse_view_tree" model="ir.ui.view">
        <field name="name">commercial.client.interesse.tree</field>
        <field name="model">commercial.client.interesse</field>
        <field name="arch" type="xml">
            <tree>
                <field name="numero"/>
                <field name="date"/>
                <field name="nom_prenom"/>
                <field name="telephone"/>
                <field name="email"/>
                <field name="fonction"/>
                <field name="interesse_projet"/>
                <field name="interesse_bloc"/>
                <field name="interesse_etage"/>
                <field name="interesse_type"/>
                <field name="commercial_id"/>
                <field name="remarque"/>
                <field name="observation"/>
                <field name="state" widget="badge"
                       invisible="state != 'valide'"/>
                <button name="action_valider" type="object"
                        string="Valider"
                        class="btn btn-success"
                        invisible="state == 'valide'"/>
            </tree>
        </field>
    </record>

    <!-- Client Intéressé - Form View -->
    <record id="commercial_client_interesse_view_form" model="ir.ui.view">
        <field name="name">commercial.client.interesse.form</field>
        <field name="model">commercial.client.interesse</field>
        <field name="arch" type="xml">
            <form string="Client intéressé">
                <header>
                    <field name="state" invisible="1"/>
                    <button name="action_valider" type="object"
                            class="btn btn-success" icon="fa-check"
                            string="Valider"
                            confirm="Voulez-vous créer un contact en pré-réservation pour ce client ?"
                            invisible="state == 'valide'"/>
                    <span class="badge text-bg-secondary ms-2" style="font-size: 1em;"
                          invisible="state != 'valide'">Validé</span>
                    <button name="action_view_communications" type="object"
                            class="btn btn-secondary" icon="fa-comments"
                            string="Communications"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="not partner_id">
                            <span class="o_stat_text">Voir Contact</span>
                        </button>
                    </div>
                    <field name="partner_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="numero"/>
                            <field name="date"/>
                            <field name="nom_prenom"/>
                            <field name="telephone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="fonction"/>
                        </group>
                        <group>
                            <field name="commercial_id"/>
                        </group>
                    </group>
                    <separator string="Intéressé par"/>
                    <group>
                        <group>
                            <field name="interesse_projet"/>
                            <field name="interesse_bloc"/>
                        </group>
                        <group>
                            <field name="interesse_etage"/>
                            <field name="interesse_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <group>
                                <field name="remarque"/>
                
                                <field name="observation"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Client Intéressé - Search View -->
    <record id="commercial_client_interesse_view_search" model="ir.ui.view">
        <field name="name">commercial.client.interesse.search</field>
        <field name="model">commercial.client.interesse</field>
        <field name="arch" type="xml">
            <search string="Client intéressé">
                <field name="nom_prenom"/>
                <field name="telephone"/>
                <field name="email"/>
                <field name="commercial_id"/>
                <field name="fonction"/>
                <field name="interesse_projet" string="Projet"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_projet" string="Projet" context="{'group_by': 'interesse_projet'}"/>
                    <filter name="group_commercial" string="Commercial" context="{'group_by': 'commercial_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Client Intéressé - Action -->
    <record id="commercial_client_interesse_action" model="ir.actions.act_window">
        <field name="name">Clients intéressés</field>
        <field name="res_model">commercial.client.interesse</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="commercial_client_interesse_view_search"/>
        <field name="context">{}</field>
    </record>

</odoo>
