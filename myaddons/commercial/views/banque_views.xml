<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="commercial_banque_view_tree" model="ir.ui.view">
        <field name="name">commercial.banque.tree</field>
        <field name="model">commercial.banque</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="compte"/>
                <field name="adresse"/>
            </tree>
        </field>
    </record>

    <record id="commercial_banque_view_form" model="ir.ui.view">
        <field name="name">commercial.banque.form</field>
        <field name="model">commercial.banque</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="compte"/>
                        <field name="adresse"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commercial_banque_action" model="ir.actions.act_window">
        <field name="name">Banques</field>
        <field name="res_model">commercial.banque</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
