<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client par Projet - Tree View (nom du projet seulement) -->
    <record id="commercial_client_projet_view_tree" model="ir.ui.view">
        <field name="name">commercial.client.projet.tree</field>
        <field name="model">commercial.projet</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree js_class="client_projet_list" create="false" delete="false">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Client par Projet - Form View (champs et pages invisibles, pas de creation) -->
    <record id="commercial_client_projet_view_form" model="ir.ui.view">
        <field name="name">commercial.client.projet.form</field>
        <field name="model">commercial.projet</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Client par Projet" create="false" delete="false">
                <header>
                </header>
                <sheet>
                    <field name="name" invisible="1"/>
                    <notebook>
                        <page string="Clients" name="cp_clients">
                            <widget name="client_search_bar"/>
                            <field name="client_ids" nolabel="1"
                                   widget="client_navigable_one2many"
                                   context="{'default_contact_category': 'interne', 'is_contact_externe': True, 'default_type_client_commercial': 'client', 'projet_readonly': True}">
                                <tree>
                                    <field name="is_blocked" column_invisible="1"/>
                                    <field name="name" string="Nom"/>
                                    <field name="blocked_display" string=" " nolabel="1"/>
                                    <field name="phone" string="Téléphone"/>
                                    <field name="email" string="Email"/>
                                    <field name="commercial_lot_projet_ids" string="Projet" widget="many2many_tags"/>
                                    <field name="commercial_lot_bloc_ids" string="Bloc" widget="many2many_tags" optional="show"/>
                                    <field name="commercial_lot_ids" string="Lots"
                                           widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <notebook invisible="1">
                        <page string="Informations g&#233;n&#233;rales" name="cp_informations_generales">
                            <group>
                                <group>
                                    <field name="intitule_administratif"/>
                                    <field name="code"/>
                                    <field name="type_projet_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="avancement" widget="progressbar"/>
                                    <field name="date_debut"/>
                                    <field name="duree_realisation"/>
                                    <field name="date_achevement"/>
                                </group>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="Localisation" name="cp_localisation">
                            <group>
                                <group>
                                    <field name="pays_id"/>
                                    <field name="wilaya_id" options="{'no_create_edit': True}"/>
                                    <field name="daira_id" options="{'no_create_edit': True}"/>
                                    <field name="commune_id" options="{'no_create_edit': True}"/>
                                    <field name="lieu_dit"/>
                                </group>
                                <group>
                                    <field name="repere"/>
                                    <field name="adresse"/>
                                    <field name="superficie_terrain"/>
                                </group>
                            </group>
                        </page>
                        <page string="Identification" name="cp_identification">
                            <separator string=" Identification juridique et technique"/>
                            <group>
                                <group>
                                    <field name="conservation_fonciere"/>
                                    <field name="livret_foncier"/>
                                </group>
                                <group>
                                    <field name="delivre_le"/>
                                    <field name="delivre_par"/>
                                </group>
                            </group>
                            <separator string=" Acte notari&#233;"/>
                            <group>
                                <group>
                                    <field name="acte_numero_enregistrement"/>
                                    <field name="acte_date_publication"/>
                                </group>
                                <group>
                                    <field name="acte_volume"/>
                                    <field name="acte_folio"/>
                                </group>
                            </group>
                            <separator string=" &#201;tat descriptif de division"/>
                            <group>
                                <group>
                                    <field name="edd_numero_enregistrement"/>
                                    <field name="edd_date_publication"/>
                                    <field name="reference_cadastrale"/>
                                </group>
                                <group>
                                    <field name="edd_volume"/>
                                    <field name="edd_folio"/>
                                </group>
                            </group>
                            <separator string=" Permis et Certificat"/>
                            <group col="3">
                                <group string="Permis de lotir">
                                    <field name="permis_lotir_numero"/>
                                    <field name="permis_lotir_date"/>
                                    <field name="permis_lotir_par"/>
                                </group>
                                <group string="Certificat d'am&#233;nagement">
                                    <field name="certificat_amenagement_numero"/>
                                    <field name="certificat_amenagement_date"/>
                                    <field name="certificat_amenagement_par"/>
                                </group>
                                <group string="Permis de construire">
                                    <field name="permis_construire_numero"/>
                                    <field name="permis_construire_date"/>
                                    <field name="permis_construire_par"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                    <field name="company_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Client par Projet - Action -->
    <record id="commercial_client_projet_action" model="ir.actions.act_window">
        <field name="name">Mes dossiers</field>
        <field name="res_model">commercial.projet</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" eval="['!', ('type_projet_ids', 'in', [ref('commercial_type_projet_location')])]"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('commercial_client_projet_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('commercial_client_projet_view_form')}),
        ]"/>
    </record>

    <!-- ============ Lots par Projet ============ -->

    <!-- Lots par Projet - Tree View (nom du projet, bouton Nouveau Lot) -->
    <record id="commercial_lots_par_projet_view_tree" model="ir.ui.view">
        <field name="name">commercial.lots.par.projet.tree</field>
        <field name="model">commercial.projet</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree js_class="lots_par_projet_list" create="false" delete="false">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Lots par Projet - Form View (nom du projet + page Lots) -->
    <record id="commercial_lots_par_projet_view_form" model="ir.ui.view">
        <field name="name">commercial.lots.par.projet.form</field>
        <field name="model">commercial.projet</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Lots par Projet" js_class="lots_par_projet_form" create="false" delete="false" edit="true">
                <sheet>
                    <field name="name" invisible="1"/>
                    <notebook>
                        <page string="Lots" name="lpp_lots">
                            <widget name="lot_search_bar"/>
                            <field name="used_categorie_ids" invisible="1"/>
                            <field name="full_etage_ids" invisible="1"/>
                            <field name="lot_ids" nolabel="1">
                                <tree create="true" delete="true" decoration-success="state == 'disponible'"
                                      decoration-info="state == 'en_option'"
                                      decoration-warning="state == 'reserve'"
                                      decoration-bf="state == 'loue'"
                                      decoration-danger="state == 'vendu'">
                                    <field name="numero_lot"/>
                                    <field name="code_perso"/>
                                    <field name="bloc_id" domain="[('projet_id', '=', parent.id)]"/>
                                    <field name="etage_id" domain="[('bloc_id', '=', bloc_id), '|', ('id', 'not in', parent.full_etage_ids), ('id', '=', etage_id)]"/>
                                    <field name="categorie_id" domain="[('etage_id', '=', etage_id), '|', ('id', 'not in', parent.used_categorie_ids), ('id', '=', categorie_id)]"/>
                                    <field name="surface_globale"/>
                                    <field name="montant_global" readonly="state not in ('disponible', 'en_option')"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'disponible'"
                                           decoration-info="state == 'en_option'"
                                           decoration-warning="state == 'reserve'"
                                           decoration-bf="state == 'loue'"
                                           decoration-danger="state == 'vendu'"/>
                                </tree>
                                <form string="Lot">
                                    <header>
                                        <field name="state" widget="statusbar" statusbar_visible="disponible,reserve,loue,vendu"/>
                                    </header>
                                    <sheet>
                                        <!-- En-tête -->
                                        <group>
                                            <group>
                                                <field name="numero_lot"/>
                                                <field name="code_perso"/>
                                            </group>
                                            <group>
                                                <field name="numero_porte"/>
                                                <field name="montant_mensuel"/>
                                            </group>
                                        </group>
                                        <group>
                                            <!-- Emplacement -->
                                            <group string="Emplacement">
                                                <field name="bloc_id" domain="[('projet_id', '=', parent.id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                                <field name="etage_id" domain="[('bloc_id', '=', bloc_id), '|', ('id', 'not in', parent.full_etage_ids), ('id', '=', etage_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                                <field name="categorie_id" domain="[('etage_id', '=', etage_id), '|', ('id', 'not in', parent.used_categorie_ids), ('id', '=', categorie_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                            </group>
                                            <!-- Superficies -->
                                            <group string="Superficies">
                                                <group>
                                                    <field name="surface_01"/>
                                                    <field name="surface_02"/>
                                                </group>
                                                <group>
                                                    <field name="prix_m2_surface_01"/>
                                                    <field name="prix_m2_surface_02"/>
                                                </group>
                                                <group colspan="2">
                                                    <field name="surface_globale"/>
                                                    <field name="prix_m2_global"/>
                                                    <field name="montant_surface_01"/>
                                                    <field name="montant_surface_02"/>
                                                    <field name="montant_global" readonly="state not in ('disponible', 'en_option')"/>
                                                </group>
                                            </group>
                                        </group>
                                        <group>
                                            <!-- Déclaration fiscale -->
                                            <group string="Déclaration fiscale">
                                                <group>
                                                    <field name="prix_m2_fiscal_1"/>
                                                    <field name="prix_m2_fiscal_2"/>
                                                </group>
                                                <group>
                                                    <field name="prix_m2_ht_fiscal_1"/>
                                                    <field name="prix_m2_ht_fiscal_2"/>
                                                </group>
                                                <group colspan="2">
                                                    <field name="montant_declare"/>
                                                    <field name="tva"/>
                                                    <field name="montant_ht"/>
                                                </group>
                                            </group>
                                            <!-- Consistance + Quotes-parts -->
                                            <group>
                                                <field name="consistance"/>
                                                <field name="quot_part_1"/>
                                                <field name="quot_part_2"/>
                                                <field name="quot_part_3"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <field name="company_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- EDD Promotionnel - Action (exclut les projets de type Location) -->
    <record id="commercial_lots_par_projet_action" model="ir.actions.act_window">
        <field name="name">EDD Promotionnel</field>
        <field name="res_model">commercial.projet</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
        <field name="domain" eval="['!', ('type_projet_ids', 'in', [ref('commercial_type_projet_location')])]"/>
        <field name="search_view_id" ref="commercial_projet_view_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('commercial_lots_par_projet_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('commercial_lots_par_projet_view_form')}),
        ]"/>
    </record>

    <!-- EDD Location - Action (uniquement projets de type Location) -->
    <record id="commercial_lots_par_projet_location_action" model="ir.actions.act_window">
        <field name="name">EDD Location</field>
        <field name="res_model">commercial.projet</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
        <field name="domain" eval="[('type_projet_ids', 'in', [ref('commercial_type_projet_location')])]"/>
        <field name="search_view_id" ref="commercial_projet_view_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('commercial_lots_par_projet_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('commercial_lots_par_projet_view_form')}),
        ]"/>
    </record>

</odoo>