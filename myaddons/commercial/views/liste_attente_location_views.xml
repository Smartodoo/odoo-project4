<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="commercial_liste_attente_location_tree" model="ir.ui.view">
        <field name="name">commercial.liste.attente.location.tree</field>
        <field name="model">commercial.liste.attente.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="genre"/>
                <field name="telephone"/>
                <field name="email"/>
                <field name="lot_display"/>
                <field name="projet_display"/>
                <field name="commercial_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="commercial_liste_attente_location_form" model="ir.ui.view">
        <field name="name">commercial.liste.attente.location.form</field>
        <field name="model">commercial.liste.attente.location</field>
        <field name="arch" type="xml">
            <form string="Liste d'attente Location">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name" string="Nom et Prénom"/>
                        <h1>
                            <field name="name" placeholder="Nom et Prénom"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identité">
                            <field name="genre" widget="radio" options="{'horizontal': true}"/>
                            <field name="telephone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Naissance">
                            <field name="date_naissance"/>
                            <field name="lieu_naissance"/>
                            <field name="pays_naissance" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="numero_acte_naissance"/>
                        </group>
                    </group>

                    <group>
                        <group string="Adresse">
                            <field name="adresse" placeholder="Adresse complète..." nolabel="1" colspan="2"/>
                        </group>
                        <group string="Notes">
                            <field name="remarque" placeholder="Remarques..." nolabel="1" colspan="2"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="commercial_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lots intéressés" name="lots_interesses">
                            <field name="commercial_projet_id" invisible="1"/>
                            <field name="commercial_bloc_id" invisible="1"/>
                            <field name="commercial_etage_id" invisible="1"/>
                            <widget name="liste_attente_lot_search_bar"/>
                            <field name="lot_ids" nolabel="1"
                                   domain="[('is_location', '=', True), ('state', '=', 'loue'), ('projet_id', '=?', commercial_projet_id), ('bloc_id', '=?', commercial_bloc_id), ('etage_id', '=?', commercial_etage_id)]">
                                <tree editable="bottom"
                                      decoration-bf="state == 'loue'">
                                    <field name="numero_lot" readonly="1"/>
                                    <field name="projet_id" readonly="1" options="{'no_open': True}"/>
                                    <field name="bloc_id" readonly="1" options="{'no_open': True}"/>
                                    <field name="etage_id" readonly="1" options="{'no_open': True}"/>
                                    <field name="surface_globale" readonly="1"/>
                                    <field name="montant_global" readonly="1"/>
                                    <field name="state" widget="badge"
                                           decoration-bf="state == 'loue'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="commercial_liste_attente_location_search" model="ir.ui.view">
        <field name="name">commercial.liste.attente.location.search</field>
        <field name="model">commercial.liste.attente.location</field>
        <field name="arch" type="xml">
            <search string="Liste d'attente Location">
                <field name="name"/>
                <field name="telephone"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Commercial" name="group_commercial" context="{'group_by': 'commercial_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="commercial_liste_attente_location_action" model="ir.actions.act_window">
        <field name="name">Liste d'attente Location</field>
        <field name="res_model">commercial.liste.attente.location</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="commercial_liste_attente_location_search"/>
    </record>

</odoo>
