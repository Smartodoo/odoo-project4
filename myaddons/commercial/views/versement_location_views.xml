<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="commercial_versement_location_view_tree" model="ir.ui.view">
        <field name="name">commercial.versement.location.tree</field>
        <field name="model">commercial.versement.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="lot_id"/>
                <field name="client_location_id"/>
                <field name="montant" sum="Total"/>
                <field name="mode_paiement"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'brouillon'"
                       decoration-success="state == 'confirme'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="commercial_versement_location_view_form" model="ir.ui.view">
        <field name="name">commercial.versement.location.form</field>
        <field name="model">commercial.versement.location</field>
        <field name="arch" type="xml">
            <form string="Versement Location">
                <header>
                    <button name="action_confirmer" type="object"
                            string="Confirmer" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,confirme"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Référence"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="lot_id"/>
                            <field name="client_location_id"/>
                        </group>
                        <group>
                            <field name="montant"/>
                            <field name="date"/>
                            <field name="mode_paiement"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="commercial_versement_location_view_search" model="ir.ui.view">
        <field name="name">commercial.versement.location.search</field>
        <field name="model">commercial.versement.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="client_location_id"/>
                <field name="location_id"/>
                <field name="date"/>
                <separator/>
                <filter name="brouillon" string="Brouillon"
                        domain="[('state', '=', 'brouillon')]"/>
                <filter name="confirme" string="Confirmé"
                        domain="[('state', '=', 'confirme')]"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_contrat" string="Contrat"
                            context="{'group_by': 'location_id'}"/>
                    <filter name="group_lot" string="Lot"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_client" string="Client"
                            context="{'group_by': 'client_location_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
