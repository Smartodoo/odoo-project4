<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="document_preview_wizard_form" model="ir.ui.view">
        <field name="name">commercial.document.preview.wizard.form</field>
        <field name="model">commercial.document.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Aperçu du document">
                <field name="document_id" invisible="1"/>
                <field name="fichier_type" invisible="1"/>
                <div class="mb-2" style="display:flex;justify-content:space-between;align-items:center;">
                    <h4>
                        <field name="fichier_name" readonly="1" nolabel="1"/>
                    </h4>
                </div>
                <field name="preview_html" nolabel="1" readonly="1"/>
                <footer>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>