<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="commercial_add_lot_wizard_form" model="ir.ui.view">
        <field name="name">commercial.add.lot.wizard.form</field>
        <field name="model">commercial.add.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter des lots">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="lot_ids" nolabel="1" widget="many2many_tags"
                           domain="[('state', 'in', ('disponible', 'en_option'))]"
                           options="{'no_create': True, 'no_create_edit': True}"
                           style="min-height: 50px;"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Ajouter" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
