<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="commercial_print_remboursement_wizard_form" model="ir.ui.view">
        <field name="name">commercial.print.remboursement.wizard.form</field>
        <field name="model">commercial.print.remboursement.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer un remboursement">
                <group>
                    <field name="versement_id" invisible="1"/>
                    <field name="remboursement_id"/>
                </group>
                <footer>
                    <button name="action_print" string="Imprimer" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
