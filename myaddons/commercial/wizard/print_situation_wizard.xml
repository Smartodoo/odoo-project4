<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="print_situation_wizard_form" model="ir.ui.view">
        <field name="name">commercial.print.situation.wizard.form</field>
        <field name="model">commercial.print.situation.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="available_lot_ids" invisible="1"/>
                    <field name="lot_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="paiement_id" invisible="1"/>
                    <field name="type_impression"/>
                </group>
                <footer>
                    <button name="action_print" string="Imprimer" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
