<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="document_delete_wizard_form" model="ir.ui.view">
        <field name="name">commercial.document.delete.wizard.form</field>
        <field name="model">commercial.document.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmer la suppression">
                <field name="document_id" invisible="1"/>
                <div style="text-align:center;padding:20px;">
                    <i class="fa fa-exclamation-triangle"
                       style="font-size:48px;color:#dc3545;"/>
                    <h4 style="margin-top:15px;">
                        Voulez-vous vraiment supprimer ce document ?
                    </h4>
                    <p style="color:#666;font-size:14px;margin-top:10px;">
                        <strong><field name="document_type" readonly="1" nolabel="1"/></strong>
                        <br/>
                        <field name="document_name" readonly="1" nolabel="1"/>
                    </p>
                    <p style="color:#999;font-size:12px;">
                        Cette action est irréversible.
                    </p>
                </div>
                <footer>
                    <button string="OK" type="object" name="action_delete"
                            class="btn-danger"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
