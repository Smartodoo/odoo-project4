<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= TEMPLATE PDF - PAIEMENTS FOURNISSEURS ================= -->
    <template id="report_caisse_expense_supplier_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="company" t-value="docs[0].company_id if docs else env.company"/>
                <div class="page">

                <!-- ============ EN-TÊTE ============ -->
                <table style="width: 100%; margin-bottom: 10px;">
                    <tr>
                        <!-- Logo à gauche -->
                        <td style="width: 120px; vertical-align: top; text-align: center;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="max-height: 90px; max-width: 100px;" alt="Logo"/>
                        </td>
                        <!-- Nom et données entreprise -->
                        <td style="vertical-align: middle; text-align: center; padding-left: 20px;">
                            <div style="font-size: 26px; font-weight: bold; color: #1a5ba8; letter-spacing: 2px; margin-bottom: 10px;">
                                <t t-esc="company.name"/>
                            </div>
                            <div style="font-size: 11px; color: #333; line-height: 1.8;">
                                <div t-if="company.street">
                                    <t t-esc="company.street"/>
                                    <t t-if="company.street2">, <t t-esc="company.street2"/></t>
                                    <t t-if="company.city">, <t t-esc="company.city"/></t>
                                    <t t-if="company.zip"> <t t-esc="company.zip"/></t>
                                </div>
                                <div t-if="company.email" style="margin-top: 3px;">
                                    <t t-esc="company.email"/>
                                </div>
                                <div t-if="company.phone" style="margin-top: 3px;">
                                    Tel: <t t-esc="company.phone"/>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Ligne de séparation bleue -->
                <div style="border-bottom: 2px solid #1a5ba8; margin-top: 10px;"></div>

                <!-- ============ TITRE DU RAPPORT ============ -->
                <div style="text-align: center; margin: 25px 0;">
                    <div style="display: inline-block; background-color: #fd7e14; border: 3px solid #fd7e14; padding: 12px 50px; border-radius: 3px;">
                        <span style="font-size: 20px; font-weight: bold; color: #ffffff; letter-spacing: 1px;">
                            RAPPORT DES PAIEMENTS FOURNISSEURS
                        </span>
                    </div>
                </div>

                <!-- Informations générales -->
                <div style="margin-bottom: 25px;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="width: 50%; border: none; padding: 5px;">
                                <strong>Date d'impression:</strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')" style="margin-left: 10px;"/>
                            </td>
                            <td style="width: 50%; border: none; padding: 5px;">
                                <strong>Nombre de paiements:</strong>
                                <span t-esc="len(docs)" style="margin-left: 10px;"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: none; padding: 5px;">
                                <strong>Société:</strong>
                                <span t-esc="company.name" style="margin-left: 10px;"/>
                            </td>
                            <td style="border: none; padding: 5px;">
                                <strong>Généré par:</strong>
                                <span t-esc="user.name" style="margin-left: 10px;"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Calcul des totaux -->
                <t t-set="total_amount" t-value="0"/>
                <t t-set="total_paid" t-value="0"/>
                <t t-set="total_residual" t-value="0"/>

                <t t-foreach="docs" t-as="doc">
                    <t t-set="total_amount" t-value="total_amount + doc.amount"/>
                    <t t-set="total_paid" t-value="total_paid + doc.amount_verse"/>
                    <t t-set="total_residual" t-value="total_residual + doc.amount_residual"/>
                </t>

                <!-- Résumé financier -->
                <div style="margin-bottom: 25px;">
                    <h4 style="background-color: #fd7e14; color: white; padding: 8px; margin-bottom: 0;">RÉSUMÉ FINANCIER</h4>
                    <table class="table table-bordered" style="margin-bottom: 0;">
                        <thead style="background-color: #ecf0f1;">
                            <tr>
                                <th style="width: 33%; text-align: center; padding: 10px;">Montant Total</th>
                                <th style="width: 33%; text-align: center; padding: 10px;">Montant Versé</th>
                                <th style="width: 34%; text-align: center; padding: 10px;">Reste à Payer</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="text-align: center; font-size: 16px; font-weight: bold; padding: 10px;">
                                    <span t-esc="'%.2f' % total_amount"/>
                                    <span t-esc="docs[0].company_currency_id.symbol if docs else 'DA'"/>
                                </td>
                                <td style="text-align: center; font-size: 16px; font-weight: bold; color: #27ae60; padding: 10px;">
                                    <span t-esc="'%.2f' % total_paid"/>
                                    <span t-esc="docs[0].company_currency_id.symbol if docs else 'DA'"/>
                                </td>
                                <td style="text-align: center; font-size: 16px; font-weight: bold; color: #e74c3c; padding: 10px;">
                                    <span t-esc="'%.2f' % total_residual"/>
                                    <span t-esc="docs[0].company_currency_id.symbol if docs else 'DA'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Tableau détaillé -->
                <h4 style="background-color: #fd7e14; color: white; padding: 8px; margin-bottom: 0;">DÉTAIL DES PAIEMENTS</h4>
                <table class="table table-bordered table-sm" style="font-size: 9px;">
                    <thead style="background-color: #ecf0f1;">
                        <tr>
                            <th style="width: 9%;">Référence</th>
                            <th style="width: 7%;">Date</th>
                            <th style="width: 12%;">Fournisseur</th>
                            <th style="width: 10%;">Bon Commande</th>
                            <th style="width: 10%;">Projet</th>
                            <th style="width: 8%;">Caisse</th>
                            <th style="width: 17%;">Description</th>
                            <th style="width: 9%; text-align: right;">Montant</th>
                            <th style="width: 9%; text-align: right;">Versé</th>
                            <th style="width: 9%; text-align: right;">Reste</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="doc">
                            <tr t-att-style="'background-color: %s;' % ('#e8f5e9' if doc.state == 'approuve' else '#fff3cd')">
                                <td><span t-field="doc.name"/></td>
                                <td><span t-field="doc.date" t-options='{"format": "dd/MM/yyyy"}'/></td>
                                <td><span t-field="doc.fournisseur.name"/></td>
                                <td><span t-field="doc.purchase_id.name"/></td>
                                <td><span t-field="doc.project_id.name"/></td>
                                <td><span t-field="doc.cashbox_id.name"/></td>
                                <td><span t-field="doc.description"/></td>
                                <td style="text-align: right;">
                                    <span t-field="doc.amount" t-options='{"widget": "monetary", "display_currency": doc.company_currency_id}'/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-field="doc.amount_verse" t-options='{"widget": "monetary", "display_currency": doc.company_currency_id}'/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-field="doc.amount_residual" t-options='{"widget": "monetary", "display_currency": doc.company_currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot style="background-color: #fd7e14; color: white; font-weight: bold;">
                        <tr>
                            <td colspan="7" style="text-align: right; padding: 8px;">TOTAL GÉNÉRAL:</td>
                            <td style="text-align: right; padding: 8px;">
                                <span t-esc="'%.2f' % total_amount"/>
                                <span t-esc="docs[0].company_currency_id.symbol if docs else 'DA'"/>
                            </td>
                            <td style="text-align: right; padding: 8px;">
                                <span t-esc="'%.2f' % total_paid"/>
                                <span t-esc="docs[0].company_currency_id.symbol if docs else 'DA'"/>
                            </td>
                            <td style="text-align: right; padding: 8px;">
                                <span t-esc="'%.2f' % total_residual"/>
                                <span t-esc="docs[0].company_currency_id.symbol if docs else 'DA'"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                </div>
            </t>
        </t>
    </template>

    <!-- ================= ACTION REPORT ================= -->
    <record id="action_report_caisse_expense_supplier" model="ir.actions.report">
        <field name="name">Paiements Fournisseurs</field>
        <field name="model">caisse.expense.supplier</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">caisse2.report_caisse_expense_supplier_template</field>
        <field name="report_file">caisse2.report_caisse_expense_supplier_template</field>
        <field name="print_report_name">
            'Paiements_Fournisseurs_%s' % (time.strftime('%Y%m%d_%H%M%S'))
        </field>
        <field name="binding_model_id" ref="model_caisse_expense_supplier"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
