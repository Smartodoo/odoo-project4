<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

        <record id="view_account_payment_register_form_inherit_cashbox" model="ir.ui.view">
            <field name="name">account.payment.register.form.inherit.cashbox</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="after">
                    <group name="cashbox_group" string="Caisse">
                        <field name="cashbox_id" options="{'no_create': True}"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="view_account_payment_form_inherit_cashbox" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.cashbox</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group2']" position="inside">
                    <field name="cashbox_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

</odoo>