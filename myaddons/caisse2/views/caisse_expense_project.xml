<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Vue Tree -->
    <record id="caisse_expense_project_view_tree" model="ir.ui.view">
        <field name="name">caisse.expense.project.view.tree</field>
        <field name="model">caisse.expense.project</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="project_id"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="total_situation_amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                <field name="total_supplier_amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                <field name="total_expense_amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                <field name="total_paid_amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                <field name="total_residual_amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
            </tree>
        </field>
    </record>

    <!-- Vue Kanban -->
    <record id="caisse_expense_project_view_kanban" model="ir.ui.view">
        <field name="name">caisse.expense.project.view.kanban</field>
        <field name="model">caisse.expense.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="false">
                <field name="project_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="partner_ids"/>
                <field name="total_expense_amount"/>
                <field name="total_paid_amount"/>
                <field name="total_residual_amount"/>
                <field name="total_situation_amount"/>
                <field name="total_supplier_amount"/>
                <field name="company_currency_id"/>
                <field name="company_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="min-width: 340px; margin: 10px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.12); border: none;">

                            <!-- Header avec gradient -->
                            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; color: white;">
                                <div style="display: flex; align-items: center; margin-bottom: 12px;">
                                    <div style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                                        <i class="fa fa-briefcase fa-lg" style="color: white;" title="Projet"/>
                                    </div>
                                    <div style="flex: 1;">
                                        <h3 style="margin: 0; font-size: 18px; font-weight: 600; line-height: 1.3;">
                                            <field name="project_id"/>
                                        </h3>
                                        <small style="opacity: 0.9; font-size: 12px;">
                                            Récap du <t t-esc="record.date_from.value"/> au <t t-esc="record.date_to.value"/>
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Montant Total -->
                            <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 16px; text-align: center;">
                                <span style="font-size: 11px; color: rgba(255,255,255,0.9); text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Montant Total</span>
                                <div style="font-size: 28px; font-weight: 700; color: white; margin-top: 5px;">
                                    <field name="total_expense_amount" widget="monetary"/>
                                </div>
                            </div>

                            <!-- Stats Grid -->
                            <div style="padding: 16px; background: #f8f9fa;">
                                <!-- Versé et Reste -->
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                                    <div style="background: white; border-radius: 10px; padding: 12px; text-align: center; border-left: 4px solid #28a745;">
                                        <div style="font-size: 10px; color: #6c757d; text-transform: uppercase; margin-bottom: 5px; font-weight: 600;">Versé</div>
                                        <div style="font-size: 18px; font-weight: 700; color: #28a745;">
                                            <field name="total_paid_amount" widget="monetary"/>
                                        </div>
                                    </div>
                                    <div style="background: white; border-radius: 10px; padding: 12px; text-align: center; border-left: 4px solid #dc3545;">
                                        <div style="font-size: 10px; color: #6c757d; text-transform: uppercase; margin-bottom: 5px; font-weight: 600;">Reste</div>
                                        <div style="font-size: 18px; font-weight: 700; color: #dc3545;">
                                            <field name="total_residual_amount" widget="monetary"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Situations et Fournisseurs -->
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                    <div style="background: white; border-radius: 10px; padding: 12px; border: 1px solid #e9ecef;">
                                        <div style="display: flex; align-items: center; margin-bottom: 6px;">
                                            <i class="fa fa-file-text" style="color: #17a2b8; font-size: 14px; margin-right: 6px;"/>
                                            <span style="font-size: 10px; color: #6c757d; text-transform: uppercase; font-weight: 600;">Situations</span>
                                        </div>
                                        <div style="font-size: 16px; font-weight: 700; color: #17a2b8;">
                                            <field name="total_situation_amount" widget="monetary"/>
                                        </div>
                                    </div>
                                    <div style="background: white; border-radius: 10px; padding: 12px; border: 1px solid #e9ecef;">
                                        <div style="display: flex; align-items: center; margin-bottom: 6px;">
                                            <i class="fa fa-truck" style="color: #fd7e14; font-size: 14px; margin-right: 6px;"/>
                                            <span style="font-size: 10px; color: #6c757d; text-transform: uppercase; font-weight: 600;">Fournisseurs</span>
                                        </div>
                                        <div style="font-size: 16px; font-weight: 700; color: #fd7e14;">
                                            <field name="total_supplier_amount" widget="monetary"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Partenaires -->
                            <div style="padding: 14px 16px; background: white; border-top: 1px solid #e9ecef;">
                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                                    <div style="display: flex; align-items: center;">
                                        <i class="fa fa-users" style="color: #6c757d; margin-right: 8px; font-size: 14px;"/>
                                        <span style="font-size: 11px; color: #6c757d; font-weight: 600; text-transform: uppercase;">Partenaires</span>
                                    </div>
                                </div>
                                <div style="margin-top: 8px;">
                                    <field name="partner_ids" widget="many2many_tags"/>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div style="padding: 10px 16px; background: #f8f9fa; border-top: 1px solid #e9ecef; display: flex; align-items: center; justify-content: space-between;">
                                <div style="font-size: 11px; color: #6c757d;">
                                    <i class="fa fa-building-o" style="margin-right: 5px;" title="Société"/>
                                    <field name="company_id"/>
                                </div>
                                <div style="font-size: 11px; color: #6c757d;">
                                    <i class="fa fa-calendar" style="margin-right: 5px;"/>
                                    <t t-esc="record.date_from.value"/> - <t t-esc="record.date_to.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Form -->
    <record id="caisse_expense_project_view_form" model="ir.ui.view">
        <field name="name">caisse.expense.project.view.form</field>
        <field name="model">caisse.expense.project</field>
        <field name="arch" type="xml">
            <form string="Récap Projet">
                <header>
                    <button name="%(caisse2.action_project_payment_print_wizard)d"
                            type="action"
                            string="Imprimer les Paiements"
                            class="btn-primary"
                            context="{'default_project_recap_id': id}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_preview_report" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <span class="o_stat_text">Aperçu</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="project_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Résumé Financier -->
                    <group string="Résumé Financier">
                        <group>
                            <label for="total_situation_amount" string="Paiements Situations"/>
                            <div>
                                <field name="total_situation_amount" widget="monetary" class="oe_inline"/>
                            </div>

                            <label for="total_supplier_amount" string="Paiements Fournisseurs"/>
                            <div>
                                <field name="total_supplier_amount" widget="monetary" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <label for="total_expense_amount" string="Montant Total"/>
                            <div>
                                <field name="total_expense_amount" widget="monetary" class="oe_inline" style="font-size: 18px; font-weight: bold;"/>
                            </div>

                            <label for="total_paid_amount" string="Montant Versé"/>
                            <div>
                                <field name="total_paid_amount" widget="monetary" class="oe_inline" style="color: #28a745; font-weight: bold;"/>
                            </div>

                            <label for="total_residual_amount" string="Reste à Payer"/>
                            <div>
                                <field name="total_residual_amount" widget="monetary" class="oe_inline" style="color: #dc3545; font-weight: bold;"/>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <!-- Page Paiements Situations -->
                        <page string="Paiements Situations" name="situations">
                            <field name="expenses_line_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="situation_id"/>
                                    <field name="cashbox_id"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                                    <field name="amount_verse" string="Versé" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                                    <field name="amount_residual" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approuve'"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Page Paiements Fournisseurs -->
                        <page string="Paiements Fournisseurs" name="suppliers">
                            <field name="expenses_supplier_line_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="purchase_id"/>
                                    <field name="fournisseur"/>
                                    <field name="cashbox_id"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="amount" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                                    <field name="amount_verse" string="Versé" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                                    <field name="amount_residual" widget="monetary" options="{'currency_field':'company_currency_id'}"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approuve'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue Search -->
    <record id="caisse_expense_project_view_search" model="ir.ui.view">
        <field name="name">caisse.expense.project.view.search</field>
        <field name="model">caisse.expense.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="partner_ids"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id"/>

                <group expand="0" string="Grouper par">
                    <filter string="Projet" name="project_id" context="{'group_by':'project_id'}"/>
                    <filter string="Société" name="company_id" context="{'group_by':'company_id'}"/>
                    <filter string="Date" name="date_group" context="{'group_by':'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Server Action pour aperçu des enregistrements sélectionnés -->
    <record id="action_preview_expense_project_multi" model="ir.actions.server">
        <field name="name">Aperçu PDF</field>
        <field name="model_id" ref="caisse2.model_caisse_expense_project"/>
        <field name="binding_model_id" ref="caisse2.model_caisse_expense_project"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_preview_report_multi()</field>
    </record>

    <!-- Action Window -->
    <record id="action_caisse_expense_project" model="ir.actions.act_window">
        <field name="name">Récap par Projet</field>
        <field name="res_model">caisse.expense.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="caisse_expense_project_view_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Aucun récapitulatif par projet disponible.
            </p>
            <p>
                Les récapitulatifs de dépenses par projet sont générés automatiquement à partir des paiements approuvés.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_caisse_expense_project"
              name="Récap par Projet"
              parent="caisse2.menu_caisse_expense"
              action="action_caisse_expense_project"
              groups="caisse2.group_comptable,caisse2.group_caissier"
              sequence="4"/>
</odoo>
