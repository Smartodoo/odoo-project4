<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="sequence_caisse_entry" model="ir.sequence">
            <field name="name">Encaissements</field>
            <field name="code">caisse.entry</field>
            <field name="prefix">EC</field>
            <field name="suffix">/%(range_year)s</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record>

        <record id="seq_caisse_transfert" model="ir.sequence">
            <field name="name">Transfert</field>
            <field name="code">cashbox.transfer</field>
            <field name="prefix">TC</field>
            <field name="suffix">/%(range_year)s</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_caisse_expense_supplier" model="ir.sequence">
            <field name="name">Payement fournisseur</field>
            <field name="code">caisse.expense.supplier</field>
            <field name="prefix">PF</field>
            <field name="suffix">/%(range_year)s</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_caisse_expense" model="ir.sequence">
            <field name="name">Notes de frais</field>
            <field name="code">caisse.expense</field>
            <field name="prefix">NF</field>
            <field name="suffix">/%(range_year)s</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>


    </data>
</odoo>
