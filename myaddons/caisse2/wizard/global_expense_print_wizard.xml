<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vue Form du Wizard -->
    <record id="global_expense_print_wizard_view_form" model="ir.ui.view">
        <field name="name">global.expense.print.wizard.form</field>
        <field name="model">global.expense.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Impression des Paiements">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="partner_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Aperçu" name="action_preview_report" type="object" class="btn-secondary" icon="fa-eye"/>
                    <button string="Imprimer" name="action_print_report" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_global_expense_print_wizard" model="ir.actions.act_window">
        <field name="name">Imprimer les Paiements</field>
        <field name="res_model">global.expense.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
