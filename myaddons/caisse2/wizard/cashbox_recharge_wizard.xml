<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

        <record id="view_cashbox_recharge_wizard_form" model="ir.ui.view">
            <field name="name">cashbox.recharge.wizard.form</field>
            <field name="model">cashbox.recharge.wizard</field>
            <field name="arch" type="xml">
                <form string="Rechargement de caisse">
                    <group>
                        <field name="cashbox_id" readonly="1"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                    <footer>
                        <button name="action_confirm_recharge" type="object" string="Confirmer" class="btn-primary"/>
                        <button string="Annuler" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

</odoo>