<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">document.document.form</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <form string="">

                    <field name="name"/>
                    <field name="document_ids">
                        <kanban class="o_kanban_small_column" sample="1">
                            <field name="name"/>
                            <field name="nom_dossier" readonly="1"/>


                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click oe_kanban_record_link o_document_kanban_card">
                                        <!-- Optional folder icon on left -->
                                        <div class="o_kanban_image_fill_left d-none d-md-block">
                                            <img t-att-src="'/web/static/src/img/icons/Folder.png'"
                                                 t-att-alt="record.name.value"/>
                                        </div>
                                        <div class="o_kanban_image d-md-none d-block">
                                            <img t-att-src="'/web/static/src/img/icons/Folder.png'"
                                                 t-att-alt="record.name.value"/>
                                        </div>

                                        <!-- Ribbon if archived -->
                                        <div class="ribbon ribbon-top-right" t-if="record.active == false">
                                            <span class="text-bg-danger">Archived</span>
                                        </div>

                                        <!-- Details section -->
                                        <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                            <div>
                                                <!--strong class="o_kanban_record_title">
                                                    <field name="name"/>
                                                </strong-->
                                                <ul>
                                                    <!--li>
                                                        Dossier parent:
                                                        <field name="nom_dossier" readonly="1"/>
                                                    </li-->

                                                </ul>
                                            </div>
                                            <div class="o_kanban_record_bottom">
                                                <div class="oe_kanban_bottom_left"/>
                                                <div class="oe_kanban_bottom_right"/>
                                            </div>
                                        </div>
                                        <!-- Bouton Ouvrir -->
                                        <div class="o_kanban_record_bottom">
                                            <t t-if="record.id.raw_value">
                                                <button type="object"
                                                        name="action_open_fichier_form"
                                                        string="Ouvrir"
                                                        class="btn btn-primary btn-sm"/>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>



            </form>
        </field>
    </record>

    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">document.document.tree</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <tree string="Documents">

                <field name="name"/>
                <field name="dossier_id"/>
                <field name="detenteur_id"/>
                <field name="mise_a_jour"/>
                <field name="taille_de_fichier"/>
            </tree>
        </field>
    </record>

    <record id="view_document_kanban" model="ir.ui.view">
        <field name="name">document.document.kanban</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" sample="1">
                <field name="name"/>


                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_record_link o_document_kanban_card">
                            <!-- Optional folder icon on left -->
                            <div class="o_kanban_image_fill_left d-none d-md-block">
                                <img t-att-src="'/web/static/src/img/icons/Folder.png'" t-att-alt="record.name.value"/>
                            </div>
                            <div class="o_kanban_image d-md-none d-block">
                                <img t-att-src="'/web/static/src/img/icons/Folder.png'" t-att-alt="record.name.value"/>
                            </div>

                            <!-- Ribbon if archived -->
                            <div class="ribbon ribbon-top-right" t-if="record.active == false">
                                <span class="text-bg-danger">Archived</span>
                            </div>

                            <!-- Details section -->
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <div>

                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left"/>
                                    <div class="oe_kanban_bottom_right"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">document.document</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>


    <menuitem id="menu_document" name="Documents" parent="document_knowledge.menu_document_root"
              action="action_document" sequence="5"/>
</odoo>