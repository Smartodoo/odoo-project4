<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- H�ritage vue formulaire hr.employee -->
    <record id="view_employee_form_inherit_fleet" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.fleet</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="role_employe"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Chauffeur" name="chauffeur_info" invisible="role_employe != 'chauffeur'">
                    <group>
                        <group>
                            <group string="Informations d'identit�">
                                <field name="date_naissance"/>
                                <field name="lieu_naissance"/>
                                <field name="date_recrutement"/>
                                <field name="poste_occupe"/>
                                <field name="formation_suivie"/>
                                <field name="telephone_chauffeur"/>
                            </group>

                            <group string="Informations M�dicales">
                                <field name="groupe_sanguin"/>
                                <field name="aptitude_medicale"/>
                                <field name="date_validite_aptitude"/>
                                <field name="etablissement_sante"/>
                            </group>
                        </group>
                        <group>
                            <group string="Permis de conduire">
                                <field name="numero_permis"/>
                                <field name="date_delivrance_permis"/>
                                <field name="date_expiration_permis"/>
                                <field name="categorie_permis"/>
                            </group>

                            <group string="Brevet de conduite">
                                <field name="brevet"/>
                                <field name="date_validite_brevet"/>
                                <field name="date_expiration_brevet"/>
                            </group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Filtrer les chauffeurs dans la vue recherche employ� -->
    <record id="view_employee_search_inherit_fleet" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.fleet</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_chauffeur" string="Chauffeurs"
                        domain="[('role_employe', '=', 'chauffeur')]"/>
            </xpath>
        </field>
    </record>

    <!-- Filtre conducteur (chauffeur) sur parc auto -->
    <record id="view_fleet_vehicle_form_inherit_chauffeur" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.chauffeur</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="domain">[('is_chauffeur', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Cron : v�rification expiration permis/brevet chauffeurs -->
    <record id="ir_cron_check_expiration_chauffeur" model="ir.cron">
        <field name="name">V�rification expiration permis/brevet chauffeurs (Fleet)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiration_chauffeur()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
