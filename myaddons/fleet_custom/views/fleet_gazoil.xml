<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action Fenetre -->
    <record id="action_fleet_gazoil" model="ir.actions.act_window">
        <field name="name">Consommation Gazoil</field>
        <field name="res_model">fleet.gazoil</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vue Liste -->
    <record id="view_fleet_gazoil_list" model="ir.ui.view">
        <field name="name">fleet.gazoil.tree</field>
        <field name="model">fleet.gazoil</field>
        <field name="arch" type="xml">
            <tree string="Consommations Gazoil">
                <header>
                    <button name="%(fleet_custom.action_gazoil_wizard)d"
                            type="action"
                            string="Imprimer rapport per"
                            class="btn-primary"/>
                </header>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <field name="department_id" optional="hide"/>
                <field name="montant" sum="Total DA"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_fleet_gazoil_form" model="ir.ui.view">
        <field name="name">fleet.gazoil.form</field>
        <field name="model">fleet.gazoil</field>
        <field name="arch" type="xml">
            <form string="Consommation Gazoil">
                <header>
                    <button name="%(fleet_custom.action_report_gazoil)d" type="action"
                            string="Imprimer rapport" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1>
                            <field name="employee_id" placeholder="Selectionner un conducteur..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Vehicule et Service">
                            <field name="vehicle_id"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Details de la saisie">
                            <field name="date"/>
                            <field name="montant"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
            id="menu_fleet_gazoil"
            name="Consommation Gazoil"
            action="action_fleet_gazoil"
            parent="fleet.menu_root"
            sequence="52"/>

</odoo>