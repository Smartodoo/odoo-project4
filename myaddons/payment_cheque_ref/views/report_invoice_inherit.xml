<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Override du rapport PDF facture :
         - Titres en français (Facture / Avoir / Facture fournisseur / etc.)
         - Utilise custom_invoice_number si renseigné, sinon le numéro Odoo. -->
    <template id="report_invoice_document_inherit_custom_number"
              inherit_id="account.report_invoice_document">

        <!-- Remplace le titre Anglais par sa version Française -->
        <xpath expr="//h2/span[@t-if=&quot;o.move_type == 'out_invoice' and o.state == 'posted'&quot;]" position="replace">
            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Facture</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'out_invoice' and o.state == 'draft'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Brouillon de facture</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'out_invoice' and o.state == 'cancel'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Facture annulée</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'out_refund' and o.state == 'posted'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Avoir</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'out_refund' and o.state == 'draft'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Brouillon d'avoir</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'out_refund' and o.state == 'cancel'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Avoir annulé</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'in_refund'&quot;]" position="replace">
            <span t-elif="o.move_type == 'in_refund'">Avoir fournisseur</span>
        </xpath>
        <xpath expr="//h2/span[@t-elif=&quot;o.move_type == 'in_invoice'&quot;]" position="replace">
            <span t-elif="o.move_type == 'in_invoice'">Facture fournisseur</span>
        </xpath>

        <!-- Numéro de facture : custom si renseigné, sinon name Odoo -->
        <xpath expr="//span[@t-field='o.name']" position="replace">
            <span t-if="o.custom_invoice_number" t-esc="o.custom_invoice_number">CUSTOM/2026/0001</span>
            <span t-elif="o.name != '/'" t-field="o.name">INV/2023/0001</span>
        </xpath>
    </template>
</odoo>
