<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Mode Chèque pour les journaux banque, dans les deux directions -->
    <record id="payment_method_cheque_ref_in" model="account.payment.method">
        <field name="name">Chèque</field>
        <field name="code">cheque_ref</field>
        <field name="payment_type">inbound</field>
    </record>
    <record id="payment_method_cheque_ref_out" model="account.payment.method">
        <field name="name">Chèque</field>
        <field name="code">cheque_ref</field>
        <field name="payment_type">outbound</field>
    </record>
</odoo>
