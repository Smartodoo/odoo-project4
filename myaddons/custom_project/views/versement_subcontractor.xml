<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_versement_subcontractor_form" model="ir.ui.view">
        <field name="name">versement.subcontractor.form</field>
        <field name="model">versement.subcontractor</field>
        <field name="arch" type="xml">
            <form string="Versement Subcontractor">
                <header>
                    <button name="action_register" string="Enregistrer" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_confirm" string="Confirmer" type="object"
                            invisible="state != 'registered'"
                            groups="custom_groups.group_technique" class="btn-warning"/>
                    <button name="action_set_to_draft" string="Remettre au Brouillon" type="object"
                            invisible="state not in ('registered', 'confirmed')" class="btn-secondary"/>
                    <button name="action_validate_paiements" string="Terminer" type="object"
                            invisible="state != 'confirmed'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,registered,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_preview_report" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <span class="o_stat_text">Aperçu</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Enregistré" bg_color="text-bg-info"
                            invisible="state != 'registered'"/>
                    <widget name="web_ribbon" title="Confirmé" bg_color="text-bg-warning"
                            invisible="state != 'confirmed'"/>
                    <widget name="web_ribbon" title="Terminé" bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <group class="col-6">
                        <field name="name" readonly="1"/>
                    </group>
                    <group>
                        <group class="col-6">
                            <field name="subcontractor_id" readonly="state in ['registered','confirmed','done']"/>
                            <field name="amount" readonly="state in ['registered','confirmed','done']"/>
                            <field name="date" readonly="state in ['registered','confirmed','done']"/>
                            <field name="objet_versement" readonly="state in ['registered','confirmed','done']"/>
                        </group>
                        <group class="col-6">
                            <field name="project_id" readonly="state in ['registered','confirmed','done']"/>
                            <field name="situation_id" readonly="state in ['registered','confirmed','done']"/>
                            <field name="lots_id" readonly="state in ['registered','confirmed','done']" widget="many2many_tags"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="tasks_ids" readonly="state in ['registered','confirmed','done']" widget="many2many_tags"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="tva_included" readonly="state in ['registered','confirmed','done']"/>
                            <field name="r_g_st_included" readonly="state in ['registered','confirmed','done']"/>
                        </group>
                        <group class="col-6">
                            <field name="tva_amount" readonly="1" invisible="tva_included != True"/>
                            <field name="rgs_amount" readonly="1" invisible="r_g_st_included != True"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="amount_due" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="tasks_ids">
                            <tree editable="bottom" nolabel="1">
                                <field name="designation" readonly="1"/>
                                <field name="montant_mois" readonly="1"/>
                                <field name="amount_distributed"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_versement_subcontractor_tree" model="ir.ui.view">
        <field name="name">versement.subcontractor.tree</field>
        <field name="model">versement.subcontractor</field>
        <field name="arch" type="xml">
            <tree string="Versement Subcontractors">
                <field name="name"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="subcontractor_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_versement_subcontractor" model="ir.actions.act_window">
        <field name="name">Versement Subcontractors</field>
        <field name="res_model">versement.subcontractor</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- configuration_versement_subcontractor defined in menu_base.xml -->

    <menuitem id="menu_versement_subcontractor"
              name="Versements"
              parent="custom_project.configuration_versement_subcontractor"
              groups="base.group_system,custom_groups.group_financiere"
              action="action_versement_subcontractor"
              sequence="1"/>

    #avoir le meme veresement comme un menue dans le module contact -> configuration
    <menuitem id="menu_versement_subcontractor_in_contacts"
              name="Versements Sous-traitants"
              parent="contacts.res_partner_menu_config"
              groups="base.group_system,custom_groups.group_financiere"
              action="action_versement_subcontractor"
              sequence="10"/>
</odoo>