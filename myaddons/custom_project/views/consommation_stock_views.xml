    <!-- Alternative: Simplified Form View -->
    <record id="view_cunsomation_stock_form_simple" model="ir.ui.view">
        <field name="name">cunsomation.stock.form.simple</field>
        <field name="model">cunsomation.stock</field>
        <field name="arch" type="xml">
            <form string="Consommation Stock">
                <sheet>
                    <group>
                        <group string="Détails">
                            <field name="product_id" string="Produit"/>
                            <field name="project_id" string="Projet"/>
                            <field name="quantity" string="Quantité"/>
                            <field name="date_consumption" string="Date"/>
                        </group>
                        <group string="Références">
                            <field name="user_id" string="Utilisateur"/>
                            <field name="purchase_order_id" string="Bon de commande"/>
                            <field name="available_product_ids" invisible="0"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action for Cunsomation Stock -->
    <record id="action_cunsomation_stock" model="ir.actions.act_window">
        <field name="name">Consommations Stock</field>
        <field name="res_model">cunsomation.stock</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune consommation enregistrée.
            </p>
            <p>
                Les consommations stock représentent les produits consommés pour chaque projet.
                Chaque consommation est automatiquement déduite du stock disponible.
            </p>
        </field>
    </record>
