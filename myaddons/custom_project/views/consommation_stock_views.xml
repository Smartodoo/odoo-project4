    <!-- Tree View -->
    <record id="view_cunsomation_stock_tree" model="ir.ui.view">
        <field name="name">cunsomation.stock.tree</field>
        <field name="model">cunsomation.stock</field>
        <field name="arch" type="xml">
            <tree string="Consommations Stock" decoration-danger="quantity &lt;= 0">
                <field name="product_id" string="Produit"/>
                <field name="project_id" string="Projet"/>
                <field name="quantity" string="Quantité" widget="float"/>
                <field name="date_consumption" string="Date consommation"/>
                <field name="user_id" string="Utilisateur" widget="many2one_avatar"/>
                <field name="company_id" string="Société" groups="base.group_multi_company"/>
                <field name="purchase_order_id" string="Bon de commande"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cunsomation_stock_search" model="ir.ui.view">
        <field name="name">cunsomation.stock.search</field>
        <field name="model">cunsomation.stock</field>
        <field name="arch" type="xml">
            <search string="Rechercher Consommations">
                <field name="product_id" string="Produit"/>
                <field name="project_id" string="Projet"/>
                <field name="user_id" string="Utilisateur"/>
                <field name="purchase_order_id" string="Bon de commande"/>
                <field name="date_consumption" string="Date consommation"/>

                <filter
                        name="today"
                        string="Aujourd'hui"
                        domain="[('date_consumption', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>

                <filter
                        name="this_week"
                        string="Cette semaine"
                        domain="[('date_consumption', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_consumption', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d 23:59:59'))]"/>

                <filter
                        name="my_consumptions"
                        string="Mes consommations"
                        domain="[('user_id', '=', uid)]"/>

                <separator/>

                <group expand="0" string="Group By">
                    <filter name="group_by_product" string="Produit" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_project" string="Projet" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_user" string="Utilisateur" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date_consumption:day'}"/>
                </group>
            </search>
        </field>
    </record>

