<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="account_register_payment_view_form_wizard_inherit" model="ir.ui.view">
        <field name="name">account.register.payment.view.form.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="show_check_number" invisible="1"/>
                <field name="show_virement_ref" invisible="1"/>
                <field name="bank_name"/>
                <field name="bank_check_number" invisible="not show_check_number"/>
                <field name="virement_ref" invisible="not show_virement_ref"/>
            </xpath>
        </field>
    </record>


    <record id="account_payment_view_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.view.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="show_check_number" invisible="1"/>
                <field name="show_virement_ref" invisible="1"/>
                <field name="bank_name"/>
                <field name="bank_check_number" invisible="not show_check_number"/>
                <field name="virement_ref" invisible="not show_virement_ref"/>
            </xpath>
        </field>
    </record>
</odoo>