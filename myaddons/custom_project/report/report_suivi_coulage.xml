<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_suivi_coulage" model="report.paperformat">
            <field name="name">Suivi Coulage A4 Paysage</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">35</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">28</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_suivi_coulage" model="ir.actions.report">
            <field name="name">Suivi Coulage</field>
            <field name="model">suivi.coulage</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_project.report_suivi_coulage_template</field>
            <field name="report_file">custom_project.report_suivi_coulage_template</field>
            <field name="paperformat_id" ref="paperformat_suivi_coulage"/>
            <field name="binding_model_id" ref="model_suivi_coulage"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Suivi_Coulage_%s' % (object.name or '').replace('/', '_')</field>
        </record>

        <template id="report_suivi_coulage_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page sc-doc">
                            <style>
                                .sc-doc { font-size: 9pt !important; line-height: 1.35; color: #2c3e50; }
                                .sc-doc * { font-size: inherit; }
                                .sc-title { background: #00695c; color: #fff; padding: 9pt 14pt;
                                            margin-bottom: 10pt; border-radius: 3px;
                                            font-size: 16pt !important; font-weight: 700; }
                                .sc-title-num { float: right; font-size: 12pt !important; }
                                .sc-state { display: inline-block; padding: 3pt 10pt; background: rgba(255,255,255,0.25);
                                            border-radius: 12pt; font-size: 9pt !important;
                                            font-weight: 600; text-transform: uppercase; margin-left: 6pt; }
                                .sc-info-table { width: 100%; border-collapse: collapse; margin-bottom: 10pt; }
                                .sc-info-cell { width: 50%; vertical-align: top; padding: 7pt 10pt;
                                                border: 1pt solid #cfd8dc; background: #f5f5f5; }
                                .sc-info-title { font-size: 10pt !important; font-weight: 700; color: #00695c;
                                                 padding-bottom: 4pt; border-bottom: 1pt solid #cfd8dc;
                                                 margin-bottom: 5pt; text-transform: uppercase; }
                                .sc-kv { width: 100%; font-size: 9pt !important; }
                                .sc-kv td { padding: 2pt 0; }
                                .sc-kv td.k { color: #607d8b; width: 40%; }
                                .sc-kv td.v { text-align: right; font-weight: 500; }
                                .sc-kpis { width: 100%; border-collapse: collapse; margin-bottom: 10pt; }
                                .sc-kpi { width: 16.66%; padding: 8pt; text-align: center; color: #fff; }
                                .sc-kpi-label { font-size: 8.5pt !important; text-transform: uppercase;
                                                margin-bottom: 3pt; display: block; }
                                .sc-kpi-value { font-size: 14pt !important; font-weight: 700; }
                                .sc-kpi.blue { background: #1565c0; }
                                .sc-kpi.teal { background: #00695c; }
                                .sc-kpi.green { background: #2e7d32; }
                                .sc-kpi.red { background: #c62828; }
                                .sc-kpi.orange { background: #ef6c00; }
                                .sc-kpi.purple { background: #6a1b9a; }
                                .sc-section { background: #00695c; color: #fff; padding: 6pt 12pt;
                                              font-size: 10pt !important; font-weight: 700;
                                              border-radius: 3pt 3pt 0 0; }
                                .sc-table { width: 100%; border-collapse: collapse; font-size: 8.5pt !important; }
                                .sc-table thead th { background: #00897b; color: #fff; padding: 5pt 3pt;
                                                     border: 1pt solid #00695c; font-weight: 700;
                                                     text-align: center; font-size: 8.5pt !important; }
                                .sc-table tbody td { padding: 4pt 3pt; border: 1pt solid #cfd8dc; }
                                .sc-table tbody tr:nth-child(even) td { background: #f8f9fc; }
                                .sc-badge { display: inline-block; padding: 2pt 6pt; font-weight: 700;
                                            font-size: 8pt !important; }
                                .sc-conf { background: #c8e6c9; color: #1b5e20; }
                                .sc-nonconf { background: #ffcdd2; color: #b71c1c; }
                                .sc-pending { background: #e0e0e0; color: #424242; }
                                .sc-partial { background: #fff3cd; color: #e65100; }
                                .sc-notes { margin-top: 9pt; padding: 7pt 12pt; background: #f5f5f5;
                                            border: 1pt solid #cfd8dc; font-size: 9pt !important; }
                                .sc-signs { width: 100%; margin-top: 22pt; border-collapse: collapse; }
                                .sc-sign { width: 24%; text-align: center; padding-top: 35pt;
                                           border-top: 1pt solid #2c3e50; font-size: 9.5pt !important;
                                           font-weight: 700; }
                                .sc-spacer { width: 1%; }
                                .text-end { text-align: right; }
                                .text-center { text-align: center; }
                            </style>

                            <div class="sc-title">
                                SUIVI DES COULAGES
                                <span class="sc-title-num">
                                    N&#176; <span t-field="doc.name"/>
                                    <span class="sc-state"
                                          t-esc="{'draft': 'Brouillon', 'in_progress': 'En Cours', 'done': 'Terminé'}.get(doc.state, '-')"/>
                                </span>
                            </div>

                            <table class="sc-info-table">
                                <tr>
                                    <td class="sc-info-cell">
                                        <div class="sc-info-title">Projet et société</div>
                                        <table class="sc-kv">
                                            <tr><td class="k">Projet :</td><td class="v"><span t-field="doc.project_id.name"/></td></tr>
                                            <tr><td class="k">Société :</td><td class="v"><span t-field="doc.company_id.name"/></td></tr>
                                            <tr><td class="k">Date Début :</td><td class="v">
                                                <span t-if="doc.date_start" t-esc="doc.date_start.strftime('%d/%m/%Y')"/>
                                            </td></tr>
                                            <tr><td class="k">Date Fin :</td><td class="v">
                                                <span t-if="doc.date_end" t-esc="doc.date_end.strftime('%d/%m/%Y')"/>
                                            </td></tr>
                                        </table>
                                    </td>
                                    <td class="sc-info-cell">
                                        <div class="sc-info-title">Intervenants</div>
                                        <table class="sc-kv">
                                            <tr><td class="k">Maître Ouvrage :</td><td class="v"><span t-field="doc.maitre_ouvrage"/></td></tr>
                                            <tr><td class="k">Entreprise :</td><td class="v"><span t-field="doc.entreprise_realisation"/></td></tr>
                                            <tr><td class="k">BET de Suivi :</td><td class="v"><span t-field="doc.bet_suivi"/></td></tr>
                                            <tr><td class="k">Responsable :</td><td class="v"><span t-field="doc.responsable_suivi"/></td></tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <t t-set="lines" t-value="doc.line_ids"/>
                            <t t-set="total_qte" t-value="sum(lines.mapped('quantite'))"/>
                            <t t-set="conf_28" t-value="lines.filtered(lambda l: l.is_conforme_28)"/>
                            <t t-set="nonconf_28" t-value="lines.filtered(lambda l: l.resultat_28_jours and not l.is_conforme_28)"/>
                            <t t-set="pending" t-value="lines.filtered(lambda l: not l.resultat_28_jours)"/>
                            <t t-set="taux_conf" t-value="(len(conf_28) / (len(conf_28) + len(nonconf_28)) * 100) if (len(conf_28) + len(nonconf_28)) else 0"/>

                            <table class="sc-kpis">
                                <tr>
                                    <td class="sc-kpi blue">
                                        <span class="sc-kpi-label">Coulages</span>
                                        <div class="sc-kpi-value"><t t-esc="len(lines)"/></div>
                                    </td>
                                    <td class="sc-kpi teal">
                                        <span class="sc-kpi-label">Volume m&#179;</span>
                                        <div class="sc-kpi-value"><t t-esc="'%.1f' % total_qte"/></div>
                                    </td>
                                    <td class="sc-kpi green">
                                        <span class="sc-kpi-label">Conformes 28j</span>
                                        <div class="sc-kpi-value"><t t-esc="len(conf_28)"/></div>
                                    </td>
                                    <td class="sc-kpi red">
                                        <span class="sc-kpi-label">Non conformes</span>
                                        <div class="sc-kpi-value"><t t-esc="len(nonconf_28)"/></div>
                                    </td>
                                    <td class="sc-kpi orange">
                                        <span class="sc-kpi-label">En attente</span>
                                        <div class="sc-kpi-value"><t t-esc="len(pending)"/></div>
                                    </td>
                                    <td class="sc-kpi purple">
                                        <span class="sc-kpi-label">Taux conf.</span>
                                        <div class="sc-kpi-value"><t t-esc="'%.1f' % taux_conf"/>%</div>
                                    </td>
                                </tr>
                            </table>

                            <div class="sc-section">DÉTAIL DES COULAGES ET ESSAIS</div>
                            <table class="sc-table">
                                <thead>
                                    <tr>
                                        <th style="width:3%;">N&#176;</th>
                                        <th style="width:18%;">Désignation</th>
                                        <th style="width:6%;">Bloc</th>
                                        <th style="width:5%;">Qté m&#179;</th>
                                        <th style="width:9%;">Centrale</th>
                                        <th style="width:7%;">Date Coul.</th>
                                        <th style="width:4%;">T&#176; C</th>
                                        <th style="width:5%;">Heure</th>
                                        <th style="width:5%;">Nb Ép.</th>
                                        <th style="width:7%;">Date 7j</th>
                                        <th style="width:6%;">7j MPA</th>
                                        <th style="width:7%;">Date 28j</th>
                                        <th style="width:6%;">28j MPA</th>
                                        <th style="width:12%;">Conformité</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.line_ids" t-as="line">
                                        <td class="text-center"><t t-esc="line.sequence"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-center">
                                            <span t-esc="{'bloc_a': 'A', 'bloc_b': 'B', 'bloc_ab': 'A et B'}.get(line.bloc, '-')"/>
                                        </td>
                                        <td class="text-end"><t t-esc="'%.2f' % (line.quantite or 0)"/></td>
                                        <td><span t-field="line.centrale_beton"/></td>
                                        <td class="text-center">
                                            <span t-if="line.date_coulage" t-esc="line.date_coulage.strftime('%d/%m/%Y')"/>
                                        </td>
                                        <td class="text-end"><t t-esc="'%.1f' % (line.temperature or 0)"/></td>
                                        <td class="text-center"><span t-field="line.heure"/></td>
                                        <td class="text-center"><t t-esc="line.nb_eprouvettes"/></td>
                                        <td class="text-center">
                                            <span t-if="line.date_7_jours" t-esc="line.date_7_jours.strftime('%d/%m/%Y')"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="line.resultat_7_jours" t-esc="'%.1f' % line.resultat_7_jours"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-if="line.date_28_jours" t-esc="line.date_28_jours.strftime('%d/%m/%Y')"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="line.resultat_28_jours" t-esc="'%.1f' % line.resultat_28_jours"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-if="line.resultat_28_jours">
                                                <span t-if="line.is_conforme_28" class="sc-badge sc-conf">CONFORME</span>
                                                <span t-else="" class="sc-badge sc-nonconf">NON CONF.</span>
                                            </t>
                                            <t t-elif="line.resultat_7_jours">
                                                <span class="sc-badge sc-partial">7j seul</span>
                                            </t>
                                            <t t-else="">
                                                <span class="sc-badge sc-pending">En attente</span>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div t-if="doc.notes" class="sc-notes">
                                <strong>Notes :</strong>
                                <p t-field="doc.notes" style="margin: 4pt 0 0 0;"/>
                            </div>

                            <table class="sc-signs">
                                <tr>
                                    <td class="sc-sign">Le Laboratoire</td>
                                    <td class="sc-spacer"></td>
                                    <td class="sc-sign">Le BET de Suivi</td>
                                    <td class="sc-spacer"></td>
                                    <td class="sc-sign">L'Entreprise</td>
                                    <td class="sc-spacer"></td>
                                    <td class="sc-sign">Le Maître d'Ouvrage</td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
