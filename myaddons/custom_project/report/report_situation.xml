<odoo>
    <template id="report_situation_document">
        <t t-name="custom_project.report_situation_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="custom_project.etb_tph_layout">
                        <style type="text/css">
                            /* General Styles */
                            .report-page {
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 12px;
                            color: #111;
                            line-height: 1.4;
                            }

                            .report-header h2 {
                            margin: 0;
                            font-size: 18px;
                            text-align: center;
                            padding: 10px 0;
                            background: #f8f9fa;
                            border-bottom: 2px solid #dee2e6;
                            }

                            .meta {
                            margin-bottom: 15px;
                            font-size: 13px;
                            padding: 10px;
                            background: #f8f9fa;
                            border-radius: 4px;
                            }

                            .meta-grid {
                            display: flex;
                            flex-wrap: wrap;
                            }

                            .meta-left, .meta-right {
                            width: 50%;
                            }

                            .meta .row {
                            margin-bottom: 4px;
                            display: flex;
                            }

                            .meta .row strong {
                            min-width: 140px;
                            }

                            /* Table Styles */
                            .report-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 11px;
                            table-layout: fixed;
                            }

                            .report-table th,
                            .report-table td {
                            border: 1px solid #adb5bd;
                            padding: 6px 4px;
                            vertical-align: top;
                            word-wrap: break-word;
                            }

                            .report-table thead th {
                            background: #e9ecef;
                            font-weight: 600;
                            text-align: center;
                            font-size: 10px;
                            padding: 8px 4px;
                            }

                            /* Column widths handled by colgroup */

                            .report-table .section-header td {
                            background: #e9ecef;
                            font-weight: 700;
                            font-size: 11px;
                            }

                            .report-table .subtotal-row td {
                            background: #dee2e6;
                            font-weight: 700;
                            font-size: 11px;
                            }

                            .report-table .total-row td {
                            background: #d6d8db;
                            font-weight: 700;
                            font-size: 11px;
                            }

                            .report-table .total-ttc-row td {
                            background: #c8cbcf;
                            font-weight: 700;
                            font-size: 12px;
                            }

                            .report-table td:nth-child(2) {
                            font-size: 11px;
                            text-align: left;
                            line-height: 1.3;
                            padding: 6px 8px;
                            }

                            .report-table td:nth-child(n+4) {
                            text-align: right;
                            font-family: 'Courier New', monospace;
                            font-size: 10px;
                            }

                            .report-table thead { display: table-header-group; }
                            .report-table tfoot { display: table-row-group; }

                            /* Summary Block */
                            .summary {
                            margin-top: 20px;
                            width: 300px;
                            float: right;
                            font-size: 12px;
                            border: 1px solid #dee2e6;
                            border-radius: 4px;
                            padding: 12px;
                            background: #f8f9fa;
                            }

                            .summary .item {
                            display: flex;
                            justify-content: space-between;
                            padding: 4px 0;
                            border-bottom: 1px solid #dee2e6;
                            }

                            .summary .item:last-child {
                            border-bottom: none;
                            }

                            .summary .item strong {
                            color: #333;
                            }

                            .clearfix {
                            clear: both;
                            }

                            .report-footer-section {
                            page-break-inside: avoid;
                            }

                            @media print {
                            .report-table {
                            font-size: 9px;
                            }
                            .report-table td, .report-table th {
                            padding: 3px 2px;
                            }
                            .report-table td:nth-child(2) {
                            font-size: 9px;
                            }
                            .report-table td:nth-child(n+4) {
                            font-size: 8px;
                            }
                            .summary {
                            margin-top: 10px;
                            padding: 8px;
                            }
                            .report-footer-section {
                            page-break-inside: avoid;
                            }
                            }
                        </style>

                        <div class="report-page">
                            <!-- Header / Entête -->
                            <div class="report-header">
                                <h2>SITUATION N° <t t-esc="o.get_subcontractor_situation_number()"/> </h2>
                            </div>

                            <!-- Infos situation (gauche) et sous-traitant (droite) côte à côte
                                 Chaque ligne s'affiche UNIQUEMENT si sa valeur n'est ni vide ni 0. -->
                            <t t-set="sub" t-value="o.original_subcontractor_id"/>
                            <t t-set="addr_parts" t-value="[p for p in [
                                sub.street, sub.street2, sub.city, sub.zip
                            ] if p]"/>
                            <table style="width: 100%; margin-bottom: 15px; font-size: 13px; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding: 10px; background: #f8f9fa; border: 1px solid #dee2e6;">
                                        <t t-if="o.name">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Nom Situation :</strong>
                                                <span t-esc="o.name"/>
                                            </div>
                                        </t>
                                        <t t-if="o.date">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Date :</strong>
                                                <span t-field="o.date"/>
                                            </div>
                                        </t>
                                        <t t-if="o.project_id and o.project_id.name">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Projet :</strong>
                                                <span t-esc="o.project_id.name"/>
                                            </div>
                                        </t>
                                        <t t-if="o.type_situation">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Type :</strong>
                                                <span t-if="o.type_situation == 'primary'">Service</span>
                                                <span t-if="o.type_situation == 'secondary'">Logements</span>
                                            </div>
                                        </t>
                                        <t t-if="o.lots_id">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Lot :</strong>
                                                <span t-esc="', '.join(o.lots_id.mapped('name'))"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td style="width: 50%; vertical-align: top; padding: 10px; background: #f8f9fa; border: 1px solid #dee2e6; border-left: none;">
                                        <t t-if="sub and sub.name">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Sous-traitant :</strong>
                                                <span t-esc="sub.name"/>
                                            </div>
                                        </t>
                                        <t t-if="addr_parts">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Adresse :</strong>
                                                <span t-esc="', '.join(addr_parts)"/>
                                            </div>
                                        </t>
                                        <t t-if="sub.phone">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Téléphone :</strong>
                                                <span t-esc="sub.phone"/>
                                            </div>
                                        </t>
                                        <t t-if="sub.email">
                                            <div style="margin-bottom: 4px;">
                                                <strong>Email :</strong>
                                                <span t-esc="sub.email"/>
                                            </div>
                                        </t>
                                        <t t-if="sub.vat">
                                            <div style="margin-bottom: 4px;">
                                                <strong>NIF :</strong>
                                                <span t-esc="sub.vat"/>
                                            </div>
                                        </t>
                                    </td>
                                </tr>
                            </table>


                            <!-- Table des lignes -->
                            <table class="report-table">
                                <colgroup>
                                    <col style="width: 4%;"/>
                                    <col style="width: 26%;"/>
                                    <col style="width: 4%;"/>
                                    <col style="width: 5.5%;"/>
                                    <col style="width: 5.5%;"/>
                                    <col style="width: 5.5%;"/>
                                    <col style="width: 5.5%;"/>
                                    <col style="width: 6%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 7%;"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th rowspan="2">N°</th>
                                        <th rowspan="2">Désignation des ouvrages</th>
                                        <th rowspan="2">U</th>
                                        <th colspan="4" style="text-align: center;">QUANTITE</th>
                                        <th rowspan="2">P/U</th>
                                        <th colspan="4" style="text-align: center;">MONTANT</th>
                                    </tr>
                                    <tr>
                                        <th>Marché</th>
                                        <th>Précédent</th>
                                        <th>Mois</th>
                                        <th>Cumul</th>
                                        <th>Marché</th>
                                        <th>Précédent</th>
                                        <th>Mois</th>
                                        <th>Cumul</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Pre-compute line groups -->
                                    <t t-set="primary_lines" t-value="o.situation_sous_traitant_ids.filtered(lambda l: l.type_tasks == 'primary').sorted('sequence')"/>
                                    <t t-set="secondary_lines" t-value="o.situation_sous_traitant_ids.filtered(lambda l: l.type_tasks == 'secondary').sorted('sequence')"/>
                                    <t t-set="other_lines" t-value="o.situation_sous_traitant_ids.filtered(lambda l: not l.type_tasks).sorted('sequence')"/>

                                    <!-- Tax rate -->
                                    <t t-set="tax_percent" t-value="sum(o.project_id1.tax_ids.mapped('amount')) if o.project_id1 and o.project_id1.tax_ids else 0"/>
                                    <t t-set="tax_rate" t-value="tax_percent / 100.0"/>

                                    <!-- ========== Section I : Service ========== -->
                                    <t t-if="primary_lines">
                                        <tr class="section-header">
                                            <td style="text-align: center;">I</td>
                                            <td colspan="11">Service</td>
                                        </tr>
                                        <t t-foreach="primary_lines" t-as="line">
                                            <tr>
                                                <td style="text-align: center;"><t t-esc="line.num"/></td>
                                                <td><t t-esc="line.designation"/></td>
                                                <td style="text-align: center;"><t t-esc="line.unit and line.unit.name or ''"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_marche"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_precedente"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_du_mois"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_cummulee"/></td>
                                                <td><t t-esc="'%.2f' % line.prix_unitaire_convention"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_marche"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_precedent"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_mois"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_cummulee"/></td>
                                            </tr>
                                        </t>
                                        <tr class="subtotal-row">
                                            <td colspan="8" style="text-align: right; padding-right: 8px;">S/TOTAL (I)</td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(primary_lines.mapped('montant_marche'))"/></td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(primary_lines.mapped('montant_precedent'))"/></td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(primary_lines.mapped('montant_mois'))"/></td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(primary_lines.mapped('montant_cummulee'))"/></td>
                                        </tr>
                                    </t>

                                    <!-- ========== Section II : Logements ========== -->
                                    <t t-if="secondary_lines">
                                        <tr class="section-header">
                                            <td style="text-align: center;">II</td>
                                            <td colspan="11">Logements</td>
                                        </tr>
                                        <t t-foreach="secondary_lines" t-as="line">
                                            <tr>
                                                <td style="text-align: center;"><t t-esc="line.num"/></td>
                                                <td><t t-esc="line.designation"/></td>
                                                <td style="text-align: center;"><t t-esc="line.unit and line.unit.name or ''"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_marche"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_precedente"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_du_mois"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_cummulee"/></td>
                                                <td><t t-esc="'%.2f' % line.prix_unitaire_convention"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_marche"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_precedent"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_mois"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_cummulee"/></td>
                                            </tr>
                                        </t>
                                        <tr class="subtotal-row">
                                            <td colspan="8" style="text-align: right; padding-right: 8px;">S/TOTAL (II)</td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(secondary_lines.mapped('montant_marche'))"/></td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(secondary_lines.mapped('montant_precedent'))"/></td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(secondary_lines.mapped('montant_mois'))"/></td>
                                            <td style="text-align: right;"><t t-esc="'%.2f' % sum(secondary_lines.mapped('montant_cummulee'))"/></td>
                                        </tr>
                                    </t>

                                    <!-- ========== Lignes sans type ========== -->
                                    <t t-if="other_lines">
                                        <t t-foreach="other_lines" t-as="line">
                                            <tr>
                                                <td style="text-align: center;"><t t-esc="line.num"/></td>
                                                <td><t t-esc="line.designation"/></td>
                                                <td style="text-align: center;"><t t-esc="line.unit and line.unit.name or ''"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_marche"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_precedente"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_du_mois"/></td>
                                                <td><t t-esc="'%.2f' % line.qty_cummulee"/></td>
                                                <td><t t-esc="'%.2f' % line.prix_unitaire_convention"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_marche"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_precedent"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_mois"/></td>
                                                <td><t t-esc="'%.2f' % line.montant_cummulee"/></td>
                                            </tr>
                                        </t>
                                    </t>

                                    <!-- ========== Totaux ========== -->
                                    <t t-set="all_vis" t-value="o.situation_sous_traitant_ids"/>
                                    <t t-set="ht_marche" t-value="sum(all_vis.mapped('montant_marche'))"/>
                                    <t t-set="ht_prec" t-value="sum(all_vis.mapped('montant_precedent'))"/>
                                    <t t-set="ht_mois" t-value="sum(all_vis.mapped('montant_mois'))"/>
                                    <t t-set="ht_cumul" t-value="sum(all_vis.mapped('montant_cummulee'))"/>

                                    <!-- MONTANT TOTAL H.T -->
                                    <tr class="total-row">
                                        <td colspan="8" style="text-align: right; padding-right: 8px;">MONTANT TOTAL H.T</td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % ht_marche"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % ht_prec"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % ht_mois"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % ht_cumul"/></td>
                                    </tr>

                                    <!-- TVA -->
                                    <tr class="total-row">
                                        <td colspan="8" style="text-align: right; padding-right: 8px;">TVA <t t-esc="'%.0f' % tax_percent"/>%</td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_marche * tax_rate)"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_prec * tax_rate)"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_mois * tax_rate)"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_cumul * tax_rate)"/></td>
                                    </tr>

                                    <!-- MONTANT TOTAL EN TTC -->
                                    <tr class="total-ttc-row">
                                        <td colspan="8" style="text-align: right; padding-right: 8px;">MONTANT TOTAL EN TTC</td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_marche * (1 + tax_rate))"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_prec * (1 + tax_rate))"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_mois * (1 + tax_rate))"/></td>
                                        <td style="text-align: right;"><t t-esc="'%.2f' % (ht_cumul * (1 + tax_rate))"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Montant en lettres + Signatures (ne pas couper entre pages) -->
                            <div class="report-footer-section">

                            <!-- Bloc récapitulatif (Montant T.R / T.Brut / TVA / TTC / Net à payer / R.G.C)
                                 retiré sur demande client : les totaux figurent déjà dans le tableau ci-dessus. -->

                            <!-- Montant en lettres -->
                            <div style="margin-top: 10px; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; background: #f8f9fa;">
                                <strong>Arrêtée la présente situation à la somme de :</strong>
                                <br/>
                                <span style="font-style: italic; font-size: 12px;">
                                    <t t-esc="o.amount_to_words()"/>
                                </span>
                            </div>

                            <!-- Signatures -->
                            <div style="margin-top: 15px; overflow: hidden;">
                                <div style="width: 45%; float: left; text-align: center;">
                                    <strong>Le Sous-traitant</strong>
                                    <br/>
                                    <span t-esc="o.original_subcontractor_id.name"/>
                                    <br/><br/><br/>
                                    <div style="border-top: 1px solid #333; width: 80%; margin: 0 auto; padding-top: 5px;">
                                        Signature et cachet
                                    </div>
                                </div>
                                <div style="width: 45%; float: right; text-align: center;">
                                    <strong>L'Entreprise</strong>
                                    <br/>
                                    <span t-esc="o.company_id.name"/>
                                    <br/><br/><br/>
                                    <div style="border-top: 1px solid #333; width: 80%; margin: 0 auto; padding-top: 5px;">
                                        Signature et cachet
                                    </div>
                                </div>
                            </div>

                            </div> <!-- /report-footer-section -->

                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_situation" model="ir.actions.report">
        <field name="name">Imprimer la situation</field>
        <field name="model">situation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_project.report_situation_document</field>
        <field name="report_file">custom_project.report_situation_document</field>
        <field name="binding_type">report</field>
    </record>
</odoo>