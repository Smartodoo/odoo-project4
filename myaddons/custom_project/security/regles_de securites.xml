<odoo>
    <data noupdate="1">
        <!-- Record Rule: Initial Info group can only access draft projects -->
        <record id="rule_project_initial_info_draft_only" model="ir.rule">
            <field name="name">Projets: Informations Initiales - Brouillons uniquement</field>
            <field name="model_id" ref="custom_project.model_custom_project"/>
            <field name="groups" eval="[(4, ref('custom_project.group_project_initial_info'))]"/>
            <field name="domain_force">[('state', '=', 'draft')]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
