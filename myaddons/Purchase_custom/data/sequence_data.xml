<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_versement_fournisseur" model="ir.sequence">
            <field name="name">Versement Fournisseur</field>
            <field name="code">versement.versement</field>
            <field name="prefix">N°</field>
            <field name="suffix">/%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="seq_situation_brise_roche" model="ir.sequence">
            <field name="name">Situation Brise Roche</field>
            <field name="code">situation.brise.roche</field>
            <field name="prefix">SBR/</field>
            <field name="suffix">/%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_nettoyage_situation" model="ir.sequence">
            <field name="name">Nettoyage Situation</field>
            <field name="code">nettoyage.situation</field>
            <field name="prefix">NET/</field>
            <field name="suffix">/%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
        </record>

    </data>
</odoo>
