<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="situation_brise_roche_view_tree" model="ir.ui.view">
            <field name="name">situation.brise.roche.tree</field>
            <field name="model">situation.brise.roche</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="type_engin"/>
                    <field name="n_bon"/>
                    <field name="engin"/>
                    <field name="project_id"/>
                    <field name="sous_traitant_id"/>
                    <field name="nombre_heures"/>
                    <field name="total_journalite"/>
                    <field name="prix_unitaire_jour"/>
                    <field name="montant" sum="Total"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="situation_brise_roche_view_form" model="ir.ui.view">
            <field name="name">situation.brise.roche.form</field>
            <field name="model">situation.brise.roche</field>
            <field name="arch" type="xml">
                <form string="Situation Brise Roche">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Informations">
                                <field name="date"/>
                                <field name="type_engin"/>
                                <field name="n_bon"/>
                                <field name="engin"/>
                                <field name="designation" placeholder="Ex: brise roche LJTV"/>
                                <field name="project_id"/>
                                <field name="sous_traitant_id"/>
                            </group>
                            <group string="Calcul">
                                <field name="nombre_heures"/>
                                <field name="total_journalite" readonly="1"/>
                                <field name="prix_unitaire_jour"/>
                                <field name="montant" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="observation" placeholder="Observation..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="situation_brise_roche_view_search" model="ir.ui.view">
            <field name="name">situation.brise.roche.search</field>
            <field name="model">situation.brise.roche</field>
            <field name="arch" type="xml">
                <search string="Recherche Brise Roche">
                    <field name="date"/>
                    <field name="type_engin"/>
                    <field name="n_bon"/>
                    <field name="engin"/>
                    <field name="project_id"/>
                    <field name="sous_traitant_id"/>
                    <filter name="filter_today" string="Aujourd'hui" domain="[('date','=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="filter_this_month" string="Ce mois" domain="[('date','&gt;=', (context_today() - datetime.timedelta(days=context_today().day - 1)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Grouper par">
                        <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                        <filter name="group_type_engin" string="Type d'engin" context="{'group_by': 'type_engin'}"/>
                        <filter name="group_engin" string="Engin" context="{'group_by': 'engin'}"/>
                        <filter name="group_project" string="Projet" context="{'group_by': 'project_id'}"/>
                        <filter name="group_sous_traitant" string="Sous Traitant" context="{'group_by': 'sous_traitant_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="situation_brise_roche_view_kanban" model="ir.ui.view">
            <field name="name">situation.brise.roche.kanban</field>
            <field name="model">situation.brise.roche</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="engin"/>
                    <field name="type_engin"/>
                    <field name="project_id"/>
                    <field name="sous_traitant_id"/>
                    <field name="nombre_heures"/>
                    <field name="total_journalite"/>
                    <field name="montant"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div><strong>Date:</strong> <field name="date"/></div>
                                    <div><strong>Engin:</strong> <field name="engin"/></div>
                                    <div><strong>Type:</strong> <field name="type_engin"/></div>
                                    <div><strong>Projet:</strong> <field name="project_id"/></div>
                                    <div><strong>Sous Traitant:</strong> <field name="sous_traitant_id"/></div>
                                    <div><strong>Heures:</strong> <field name="nombre_heures"/> | <strong>Journalité:</strong> <field name="total_journalite"/></div>
                                    <div class="text-primary fw-bold mt-1">
                                        <strong>Montant:</strong> <field name="montant"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="situation_brise_roche_action" model="ir.actions.act_window">
            <field name="name">Situation Brise Roche</field>
            <field name="res_model">situation.brise.roche</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('company_id', '=', allowed_company_ids[0])]</field>
            <field name="search_view_id" ref="situation_brise_roche_view_search"/>
        </record>

