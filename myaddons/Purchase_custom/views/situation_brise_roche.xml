<!--                  name="Situation Brise Roche"-->
<!--                  parent="Purchase_custom.menu_situation_parent"-->
<!--                  action="situation_brise_roche_action"-->
<!--                  sequence="2"/>-->

        <!-- Même entrée dans le module Projets S-T -->
        <menuitem id="situation_brise_roche_menu_project"
                  name="Situation Brise Roche"
                  parent="Purchase_custom.menu_situation_parent_project"
                  action="situation_brise_roche_action"
                  sequence="2"/>
    </data>
</odoo>