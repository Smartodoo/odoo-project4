    <menuitem id="menu_vente_dairas"
              name="Dairas"
              parent="menu_vente_configuration"
              action="action_vente_daira"
              sequence="20"/>

    <menuitem id="menu_vente_communes"
              name="Communes"
              parent="menu_vente_configuration"
              action="action_vente_commune"
              sequence="30"/>
</odoo>
