<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_vente_immobiliere_root"
              name="Vente Immobiliere"
              sequence="50"
              web_icon="vente_immobiliere,static/description/icon.png"/>

    <!-- Projets -->
    <menuitem id="menu_vente_projets"
              name="Projets"
              parent="menu_vente_immobiliere_root"
              sequence="10"/>

    <menuitem id="menu_vente_projets_all"
              name="Tous les Projets"
              parent="menu_vente_projets"
