<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Un locataire portail ne voit que SES locations -->
        <record id="rule_rental_portal" model="ir.rule">
            <field name="name">Location: Locataire ne voit que ses contrats</field>
            <field name="model_id" ref="model_property_rental"/>
            <field name="domain_force">[('client_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Un locataire ne voit que SES paiements -->
        <record id="rule_payment_portal" model="ir.rule">
            <field name="name">Paiement: Locataire ne voit que ses paiements</field>
            <field name="model_id" ref="model_rental_payment"/>
            <field name="domain_force">[('client_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
        </record>
    </data>
</odoo>