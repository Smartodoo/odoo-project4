<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_property_rental" model="ir.sequence">
        <field name="name">Contrat de Location</field>
        <field name="code">property.rental</field>
        <field name="prefix">LOC-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_property_inspection" model="ir.sequence">
        <field name="name">Inspection</field>
        <field name="code">property.inspection</field>
        <field name="prefix">INS-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_rental_payment" model="ir.sequence">
        <field name="name">Paiement</field>
        <field name="code">rental.payment</field>
        <field name="prefix">PAY-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_property_maintenance" model="ir.sequence">
        <field name="name">Maintenance</field>
        <field name="code">property.maintenance</field>
        <field name="prefix">MAINT-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>