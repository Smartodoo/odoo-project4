<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CONTRAT DE LOCATION -->
    <record id="report_rental_contract" model="ir.actions.report">
        <field name="name">📄 Contrat de Location</field>
        <field name="model">property.rental</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_management.report_contract_template</field>
        <field name="report_file">rental_management.report_contract_template</field>
        <field name="print_report_name">'Contrat - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_property_rental"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_contract_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Georgia, serif; font-size: 14px;">
                        <h1 style="text-align: center; color: #5E6AD2; border-bottom: 3px solid #5E6AD2; padding-bottom: 10px;">
                            CONTRAT DE LOCATION
                        </h1>
                        <div style="margin-top: 30px;">
                            <p>
                                <strong>N° Contrat :</strong>
                                <span t-field="doc.name"/>
                            </p>
                            <p>
                                <strong>Date :</strong>
                                <span t-field="doc.date_start"/>
                            </p>
                        </div>
                        <div style="margin-top: 20px; background: #f8f9ff; padding: 20px; border-radius: 10px;">
                            <h3>👤 LOCATAIRE</h3>
                            <p>
                                <strong>Nom :</strong>
                                <span t-field="doc.client_id.name"/>
                            </p>
                            <p>
                                <strong>Email :</strong>
                                <span t-field="doc.client_id.email"/>
                            </p>
                            <p>
                                <strong>Téléphone :</strong>
                                <span t-field="doc.client_id.phone"/>
                            </p>
                        </div>
                        <div style="margin-top: 20px; background: #f8f9ff; padding: 20px; border-radius: 10px;">
                            <h3>🏠 BIEN LOUÉ</h3>
                            <p>
                                <strong>Appartement :</strong>
                                <span t-field="doc.property_id.name"/>
                            </p>
                            <p>
                                <strong>Type :</strong>
                                <span t-field="doc.property_id.type"/>
                            </p>
                            <p>
                                <strong>Adresse :</strong>
                                <span t-field="doc.property_id.address"/>
                            </p>
                        </div>
                        <div style="margin-top: 20px;">
                            <h3>📅 CONDITIONS</h3>
                            <table class="table table-bordered" style="width: 100%;">
                                <tr>
                                    <td>Date d'arrivée</td>
                                    <td>
                                        <span t-field="doc.date_start"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Date de départ</td>
                                    <td>
                                        <span t-field="doc.date_end"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Durée</td>
                                    <td>
                                        <span t-field="doc.duration_days"/>
                                        jours
                                    </td>
                                </tr>
                                <tr>
                                    <td>Type de période</td>
                                    <td>
                                        <span t-field="doc.period_type"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Prix total</td>
                                    <td>
                                        <strong>
                                            <span t-field="doc.total_price"/>
                                            DA
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Caution</td>
                                    <td>
                                        <span t-field="doc.deposit_amount"/>
                                        DA
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-top: 50px;">
                            <div style="width: 45%; float: left; text-align: center;">
                                <p>Signature du Locataire</p>
                                <div style="border-top: 1px solid #333; margin-top: 60px;"></div>
                            </div>
                            <div style="width: 45%; float: right; text-align: center;">
                                <p>Signature du Gérant</p>
                                <div style="border-top: 1px solid #333; margin-top: 60px;"></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- QUITTANCE DE LOYER -->
    <record id="report_quittance" model="ir.actions.report">
        <field name="name">📄 Quittance de Loyer</field>
        <field name="model">property.rental</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_management.report_quittance_template</field>
        <field name="report_file">rental_management.report_quittance_template</field>
        <field name="print_report_name">'Quittance - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_property_rental"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_quittance_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page"
                         style="font-family: 'Helvetica', 'Arial', sans-serif; font-size: 14px; color: #333;">

                        <div style="text-align: center; margin-bottom: 30px;">
                            <h1 style="color: #2DC071; text-transform: uppercase; margin-bottom: 5px;">Quittance de
                                Loyer
                            </h1>
                            <p style="color: #666; font-size: 16px;">
                                Référence :
                                <strong>
                                    <span t-field="doc.name"/>
                                </strong>
                            </p>
                        </div>

                        <div style="border: 1px solid #2DC071; padding: 30px; border-radius: 10px; line-height: 1.8;">
                            <p>Je soussigné,
                                <strong>
                                    <span t-field="res_company.name"/>
                                </strong>
                                , propriétaire (ou mandataire) du logement désigné ci-dessous, déclare avoir reçu de la
                                part de :
                            </p>

                            <p style="padding-left: 20px;">
                                M./Mme
                                <strong>
                                    <span t-field="doc.client_id.name"/>
                                </strong>
                                <br/>
                                demeurant au :<span t-field="doc.client_id.street"/>,
                                <span t-field="doc.client_id.city"/>
                            </p>

                            <p>la somme de :
                                <strong>
                                    <span t-field="doc.amount_paid"/>
                                    DA
                                </strong>
                                <t t-if="doc.amount_paid">
                                    (<span t-esc="res_company.currency_id.amount_to_text(doc.amount_paid)"/>)
                                </t>
                            </p>

                            <p>au titre du paiement du loyer et des charges pour la période du
                                <strong>
                                    <span t-field="doc.date_start"/>
                                </strong>
                                au
                                <strong>
                                    <span t-field="doc.date_end"/>
                                </strong>
                                .
                            </p>

                            <p>Désignation du bien :
                                <strong>
                                    <span t-field="doc.property_id.name"/>
                                </strong>
                            </p>
                        </div>

                        <div style="margin-top: 30px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 50%;">
                                        <p>
                                            <strong>Mode de règlement :</strong>
                                            <span>Espèces</span>
                                        </p>
                                        <p style="font-size: 11px; color: #888;">* Cette quittance annule tout reçu
                                            relatif à la même période.
                                        </p>
                                    </td>
                                    <td style="text-align: right;">
                                        <p>Fait à
                                            <strong>
                                                <span t-field="res_company.city"/>
                                            </strong>
                                            , le
                                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                        </p>
                                        <div style="margin-top: 20px;">
                                            <p>
                                                <strong>Le Gérant (Cachet et Signature)</strong>
                                            </p>
                                            <div style="height: 80px;"></div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>