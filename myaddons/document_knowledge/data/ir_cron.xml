<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron pour notifier les audiences à venir 3 jours avant -->
        <record id="ir_cron_check_notif_date_exp" model="ir.cron">
            <field name="name">Notification des fichiers expirés</field>
            <field name="model_id" ref="document_knowledge.model_ir_attachment"/>
            <field name="state">code</field>
            <field name="code">model.cron_notify_expired_attachments()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <!--field name="nextcall" eval="(datetime.now())"/-->
        </record>


    </data>
</odoo>


