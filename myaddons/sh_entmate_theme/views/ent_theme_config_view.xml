								<field name="login_page_banner_image" widget="image" invisible="login_page_style != 'style_2'" required="login_page_style == 'style_2'" class="oe_avatar" options="{'preview_image': 'login_page_banner_image', 'size': [90, 90]}"/>
					 			
							</group>
