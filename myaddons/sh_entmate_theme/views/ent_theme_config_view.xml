									<div>
								<field name="kanban_box_style" widget="selection" class="oe_inline" style="width: 70% !important;"/>
								<button
			                        type="object"
			                        name="action_preview_theme_style"
			                        class="btn-sm btn-link mb4 fa fa-eye"
			                        aria-label="Preview"
			                        title="Preview"
			                        context="{'which_style': 'kanban box'}"
			                        />
			                        </div>	
			                    																		
