<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension" owl="1">
		<xpath expr="//ActionContainer" position="after">
            <ZoomWidget/>
        </xpath>
    </t>

    <t t-name="ZoomWidget">
        <div class="sh_zoom_view_layout">
             <t t-if="this.show_zoom">
                 <button class=" btn sh_zoom" t-on-click="this.zoomDropdown">
                     <span class="oi" data-icon="zoom_in"></span>
                 </button>
                 <div class="sh-zoom-panel collapse" id="zoomPanel">
                     <div class="d-flex align-items-center">
                         <div class="sh_full">100%</div>
                         <div class="d-flex align-items-center mx-2">
                             <button class="btn btn-small sh_dec" t-on-click="this.setDecZoom">-</button>
                             <button class="btn btn-small sh_inc" t-on-click="this.setIncZoom">+</button>
                         </div>
                         <button class="oi btn btn-secondary sh_reset" data-icon="redo" t-on-click="this.setResetZoom"></button>
                     </div>
                 </div>
             </t>
       </div>
     </t>
</templates>
