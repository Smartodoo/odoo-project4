<?xml version="1.0" encoding="utf-8"?>

<templates id="sh_add_button" xml:space="preserve">
    <t t-name="web.ListRenderer.RecordRow_sh" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('o_list_record_selector')]" position="after">
            <t t-if="this.is_list_view and this.show_open_record_new_tab_button_listrenderer">
                <td>
                    <button type="button" class="btn btn-info p-1 open_record_new_tab" t-on-click="() => this.OpenRecord(record.resId)">
                        Click
                    </button>
                </td>
            </t>
        </xpath>
    </t>

    <!-- Header cell for the "Open in new tab" column. Added through Owl template
         inheritance (not jQuery) so it stays in sync with the virtual DOM across
         re-renders, including inline editing. -->
    <t t-name="web.ListRenderer_sh_open_header" t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//thead//th[hasclass('o_list_record_selector')]" position="after">
            <t t-if="this.is_list_view and this.show_open_record_new_tab_button_listrenderer">
                <th class="o_list_open_record_header w-print-0 p-print-0"/>
            </t>
        </xpath>
    </t>
</templates>
