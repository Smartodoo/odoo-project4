<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ThemeConfigurationTemplate">
		<t t-if="this.is_group_theme_configuration_user">
		<div class="theme_settings">
			<a class="theme_configuration float-right" t-on-click="this._click_theme_configuration" role="button" >
				<span class="oi oi-filled icon-theme_setting" data-icon="settings"/>
			</a> 
		</div>
		</t>
	</t>
</templates>