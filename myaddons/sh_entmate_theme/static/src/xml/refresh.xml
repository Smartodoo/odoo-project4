<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="web.KanbanView.Buttons" t-inherit="web.KanbanView.Buttons" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <button name="sh_refresh" class="btn btn-primary sh_refresh" t-on-click="this._onClickRefreshView">
				<i class="oi" data-icon="refresh"></i>
			</button>
        </xpath>
    </t>

    <t t-name="web.CalendarController.controlButtons" t-inherit="web.CalendarController.controlButtons" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <button name="sh_refresh" class="btn btn-primary sh_refresh" t-on-click="this._onClickRefreshView">
				<i class="oi" data-icon="refresh"></i>
			</button>
        </xpath>
    </t>

    <t t-name="web.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <button name="sh_refresh" class="btn btn-primary sh_refresh" t-on-click="this._onClickRefreshView">
				<i class="oi" data-icon="refresh"></i>
			</button>
            <t t-if="this.show_expand_collapse">
                <button
                    class="oi btn btn-secondary" data-icon="expand_content"
                    title="Expand groups"
                    type="button"
                    t-on-click="this.shExpandGroups"
                />
                <button
                    class="oi btn btn-secondary" data-icon="close_fullscreen"
                    title="Collapse groups"
                    type="button"
                    t-on-click="this.shCollapseGroups"
                />
            </t> 
        </xpath>
    </t>


</templates>