<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <!-- Odoo 20: the 'control-panel-create-button' slot no longer exists; append to 'control-panel-buttons' -->
        <xpath expr="//Layout/t[@t-set-slot='control-panel-buttons']" position="inside">
                <t t-if="!this.env.inDialog and this.disableEditButton()">
                    <t t-if="this.shDisplayButtons()">
                        <button type="button" data-hotkey="c"
                            t-on-click="this._onClickEditView" class="btn btn-outline-primary sh_form_button_edit saved">Edit</button>
                    </t>
                    <t t-else="">
                        <button type="button" data-hotkey="c"
                            t-on-click="this._onClickEditView" class="btn btn-outline-primary sh_form_button_edit dirty">Edit</button>
                    </t>
