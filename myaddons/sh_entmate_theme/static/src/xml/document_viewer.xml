<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

   <t t-name="shDocumentViewer.Content">
        <div class="o_viewer_content h-100">
            <t t-set="model" t-value="this.widget.modelName"/>
            <div class="attch-viewer-header">
                <div class="image_filename_div ms-2">
                    <span class="o_image_caption">
                        <i class="oi mr8" data-icon="image" t-if="this.widget.activeAttachment.fileType == 'image'" role="img" aria-label="Image" title="Image"/>
                        <i class="oi oi-filled mr8" data-icon="article" t-if="this.widget.activeAttachment.fileType == 'application/pdf'" role="img" aria-label="PDF file" title="PDF file"/>
                        <i class="oi oi-filled mr8" data-icon="videocam" t-if="this.widget.activeAttachment.fileType == 'video'" role="img" aria-label="Video" title="Video"/>
                        <span class="o_viewer_document_name" t-out="this.widget.activeAttachment.name"/>
                    </span>
                </div>
                <div class="download_clsoe_div">
                    <a class="o_download_btn o_document_viewer_topbar_button btn" href="#" title="Download">
                        <i class="oi oi-fw" data-icon="download" role="img" aria-label="Download"/>
                        <span class="d-none d-md-inline ml-2">Download</span>
                    </a>
                    <a role="button" href="#" class="o_close_btn o_document_viewer_topbar_button btn" title="Close">
                        <i class="oi oi-fw" data-icon="close" role="img" aria-label="Close"/>
                    </a>
                </div>
            </div>
            <div class="o_viewer_img_wrapper h-100">
                <div class="o_viewer_zoomer h-100">
                    <t t-if="this.widget.activeAttachment.fileType === 'image'">
                        <div class="o_loading_img text-center">
                            <i class="oi oi-spin oi-3x oi-fw text-gray-light" data-icon="autorenew" role="img" aria-label="Loading" title="Loading"/>
                        </div>
                        <t t-set="unique" t-value="this.widget.activeAttachment.checksum ? this.widget.activeAttachment.checksum.slice(-8) : ''"/>
                        <img class="o_viewer_img img-fluid" t-attf-src="/web/image/#{this.widget.activeAttachment.id}?unique=#{unique}&amp;model=#{model}" alt="Viewer"/>
                    </t>
                    <iframe t-if="this.widget.activeAttachment.fileType == 'application/pdf'" class="o_viewer_pdf" t-attf-src="/web/static/lib/pdfjs/web/viewer.html?file=/web/content/#{this.widget.activeAttachment.id}?model%3D#{model}%26filename%3D#{window.encodeURIComponent(this.widget.activeAttachment.name)}"/>
                    <iframe t-if="(this.widget.activeAttachment.fileType || '').indexOf('text') !== -1" class="o_viewer_text" t-attf-src="/web/content/#{this.widget.activeAttachment.id}?model=#{model}"/>
                    <iframe t-if="this.widget.activeAttachment.fileType == 'youtu'" class="o_viewer_text" allow="autoplay; encrypted-media" width="560" height="315" t-attf-src="https://www.youtube.com/embed/#{this.widget.activeAttachment.youtube}"/>
                    <video t-if="this.widget.activeAttachment.fileType == 'video'" class="o_viewer_video" controls="controls">
                        <source t-attf-src="/web/image/#{this.widget.activeAttachment.id}?model=#{model}" t-att-data-type="this.widget.activeAttachment.mimetype"/>
                    </video>
                </div>
            </div>
            <div t-if="this.widget.activeAttachment.fileType == 'image'" class="o_viewer_toolbar btn-toolbar" role="toolbar">
                <div class="btn-group" role="group">
                    <a role="button" href="#" class="o_viewer_toolbar_btn btn o_zoom_in" data-toggle="tooltip" title="Zoom In"><i class="oi oi-fw" data-icon="add" role="img" aria-label="Zoom In"/></a>
                    <a role="button" href="#" class="o_viewer_toolbar_btn btn o_zoom_reset disabled" data-toggle="tooltip" title="Reset Zoom"><i class="oi oi-fw" data-icon="search" role="img" aria-label="Reset Zoom"/></a>
                    <a role="button" href="#" class="o_viewer_toolbar_btn btn o_zoom_out disabled" data-toggle="tooltip" title="Zoom Out"><i class="oi oi-fw" data-icon="remove" role="img" aria-label="Zoom Out"/></a>
                </div>
                <div class="btn-group" role="group">
                    <a role="button" href="#" class="o_viewer_toolbar_btn btn o_rotate" data-toggle="tooltip" title="Rotate"><i class="oi oi-fw" data-icon="redo" role="img" aria-label="Rotate"/></a>
                </div>
                <div class="btn-group" role="group">
                    <a role="button" href="#" class="o_viewer_toolbar_btn btn o_print_btn" data-toggle="tooltip" title="Print"><i class="oi oi-fw" data-icon="print" role="img" aria-label="Print"/></a>
                    <a role="button" href="#" class="o_viewer_toolbar_btn btn o_download_btn" data-toggle="tooltip" title="Download"><i class="oi oi-fw" data-icon="download" role="img" aria-label="Download"/></a>
                </div>
            </div>
        </div>
    </t>


    <t t-name="shDocumentViewer">
        <div class="modal o_modal_fullscreen" id="myModal">
            <div class="modal-dialog modal-lg">
                <div class="attch-modal-content h-100">
                    <t class="this.o_document_viewer_content_call" t-call="shDocumentViewer.Content"/>
                    <t t-if="this.widget.attachment.length !== 1">
                        <a class="arrow arrow-left move_previous" href="#">
                            <span class="oi" data-icon="chevron_left" role="img" aria-label="Previous" title="Previous"/>
                        </a>
                        <a class="arrow arrow-right move_next" href="#">
                            <span class="oi" data-icon="chevron_right" role="img" aria-label="Next" title="Next"/>
                        </a>
                    </t>
                </div>
            </div>
        </div>
    </t>

     <t t-name="PrintImage">
        <html>
            <head>
                <script>
                    function onload_img() {
                        setTimeout('print_img()', 10);
                    }
                    function print_img() {
                        window.print();
                        window.close();
                    }
                </script>
            </head>
            <body onload="onload_img()">
                <img t-att-src="this.src" alt=""/>
            </body>
        </html>
    </t>
</templates>