<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="NightModeTemplate">
		<div class="o_night_mode">
				<t t-if="this.day_mode">
					<span class="oi" data-icon="dark_mode" id="moon_button" t-on-click="this._click_moon_button" style="font-size: 16px;vertical-align: 0;display:inline-flex;"></span>
					<span class="oi" data-icon="light_mode" id="sun_button" t-on-click="this._click_sun_button" style="display:none;font-size: 16px;vertical-align: 0;"></span>
				</t>
				<t t-else="">
					<span class="oi" data-icon="dark_mode" id="moon_button" t-on-click="this._click_moon_button" style="font-size: 16px;vertical-align: 0;display:none;"></span>
					<span class="oi" data-icon="light_mode" id="sun_button" t-on-click="this._click_sun_button" style="display:inline-flex;font-size: 16px;vertical-align: 0;"></span>
				</t>


			 <input type="checkbox" id="night_checkbox" style="display:none;"/>
        </div>
	</t>
</templates>
