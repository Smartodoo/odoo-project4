<?xml version="1.0" encoding="utf-8"?>
<template id="todo_card">
    <t t-name="sh_entmate_theme.todo_card">
        <div class="sh_main_card">
            <!-- <div class="sh_blank_div"></div> -->
            <!--<div
            t-att-id="rec" t-att-class="is_done ? 'card sh_done_todo' : 'card'">-->
            <div class="card-header card" id="headingOne">
                <div class="sh-card-header">
                    <div class="o-checkbox custom-control custom-checkbox">
                        <t t-if="this.is_done">
                            <input checked="checked" t-on-change="this._click_sh_todo_checklist"
                                type="checkbox"
                                t-att-id="this.rec"
                                class="form-check-input custom-control-input sh_todo_checklist" />
                        </t>
                        <t t-else="">
                            <input type="checkbox" t-on-change="this._click_sh_todo_checklist"
                                t-att-id="this.rec"
                                class="form-check-input custom-control-input sh_todo_checklist" />
                        </t>

                        <label t-att-for="this.rec" class="form-check-label custom-control-label"></label>
                        <!-- <div class="sh_to_do_check_btn"> -->
                        <span class="sh_mark_completed_tooltip">Mark Completed</span>
                        <!-- </div> -->
                    </div>
                </div>
                <div class="sh-card-header-button">
                    <div class="sh_to_do_edit_btn">
                        <span class="oi oi-filled sh_header_pencil" data-icon="edit"
                            t-on-click="this._click_sh_header_pencil"
                            t-att-id="this.rec" />
                        <span class="sh_mark_edit_tooltip">Edit</span>
                    </div>
                    <div class="sh_to_do_save_btn">
                        <span class="oi sh_header_save" data-icon="save"
                            t-on-click="this._focusout_sh_todo_description"
                            t-att-id="this.rec" style="display:none;" />
                        <span class="sh_mark_save_tooltip">Save</span>
                    </div>
                    <span class="oi sh_header_times" data-icon="close" t-on-click="this._remove_todo"
                        t-att-id="this.rec" />
                    <span class="sh_mark_remove_tooltip"></span>
                </div>
                <div class="sh_to_do_remove_btn">
                </div>
            </div>
            <div class="card-body">
                <span t-att-class="this.is_done ? 'sh_todo_label sh_done_todo' : 'sh_todo_label'">
                    <t t-out="this.name" />
                </span>
                <textarea class="sh_todo_description" t-att-id="this.rec"
                    style="white-space:normal;display:none;">
                    <t t-out="this.name" />
                </textarea>
            </div>
        </div>

        <!-- <div t-att-id="'collapseOne_'+rec">
                 <div class="card-body">
                     <span class="sh_todo_label" t-att-id="rec"><t t-out="name"/></span>
                    <textarea class="sh_todo_description" t-att-id="rec" style="white-space:normal;display:none;"><t
        t-out="name"/></textarea>
                 </div>
             </div>-->

        <!--</div>-->
    </t>
    <!--<div>
        <div class="card-body">
            <span class="sh_todo_label">
                <t t-out="name"/>
            </span>
            <textarea class="sh_todo_description" t-att-id="rec" style="white-space:normal;display:none;">
                <t t-out="name"/>
            </textarea>
        </div>
    </div>-->

</template>